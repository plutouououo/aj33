{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, phone, source, created_at AS \"created_at!\"\n        FROM customers\n        WHERE ($1::text IS NULL OR name ILIKE '%' || $1 || '%' OR phone ILIKE '%' || $1 || '%')\n        ORDER BY name NULLS LAST, created_at DESC\n        LIMIT $2\n        ",
