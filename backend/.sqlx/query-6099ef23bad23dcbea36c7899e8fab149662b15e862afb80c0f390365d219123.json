  "query": "\n        INSERT INTO sku_codes (kind, source, source_key, code, created_by)\n        VALUES ($1, $2, $3, $4, $5)\n        ON CONFLICT (kind, source_key) DO UPDATE\n            SET source = EXCLUDED.source,\n                code = EXCLUDED.code,\n                updated_at = CURRENT_TIMESTAMP\n        RETURNING id, kind, source, code\n        ",
