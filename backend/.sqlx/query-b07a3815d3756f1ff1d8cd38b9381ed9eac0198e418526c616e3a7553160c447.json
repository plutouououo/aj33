  "query": "\n        SELECT id, product_id, batch_number, quantity, expiry_date,\n               received_at AS \"received_at!\", created_by\n        FROM product_batches\n        WHERE product_id = $1\n        ORDER BY expiry_date NULLS LAST, received_at DESC\n        ",
