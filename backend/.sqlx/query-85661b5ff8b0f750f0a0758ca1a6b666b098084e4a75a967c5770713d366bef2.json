  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.product_id, p.name AS \"product_name?\", i.item_name_snapshot, i.qty\n        FROM external_order_items i\n        LEFT JOIN products p ON p.id = i.product_id\n        WHERE i.external_order_id = $1\n        ORDER BY i.created_at, i.id\n        ",
