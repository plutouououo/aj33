# Salin jadi web/.env.
# Dipakai Astro saat merender di server untuk memanggil backend Rust.
BACKEND_URL=http://localhost:3000

# URL kontainer Azure Blob Storage lengkap dengan SAS query, dipakai
# mengunggah foto produk. Bentuknya:
#   https://<akun>.blob.core.windows.net/<kontainer>?sp=racwdli&st=...&sig=...
# SAS-nya punya masa berlaku -- perbarui sebelum `se=` terlampaui, jika tidak
# unggah foto berhenti bekerja.
AZURE_BLOB_SAS_URL=
