# Salin jadi web/.env; dipakai Astro saat render di server untuk memanggil backend Rust.
BACKEND_URL=http://localhost:3000

# URL kontainer Azure Blob + SAS query untuk unggah foto produk (`https://<akun>.blob.core.windows.net/<kontainer>?sp=...&sig=...`); perbarui sebelum `se=` terlampaui.
AZURE_BLOB_SAS_URL=
