---
import '../styles/theme.css';
import type { User } from '../lib/api';
import { bolehAkses } from '../lib/session';

interface Props {
  judul: string;
  user?: User;
}

const { judul, user } = Astro.props;
const path = Astro.url.pathname;

/** Menu aplikasi, difilter `bolehAkses` (daftar yang sama dengan middleware) agar tak ada halaman yang ditawarkan tapi ditolak; dikelompokkan supaya mudah dipindai. */
const grup = [
  {
    judul: 'Ringkasan',
    menu: [
      { href: '/dasbor', label: 'Dasbor', ikon: 'kisi' },
      { href: '/laporan', label: 'Laporan', ikon: 'grafik' },
    ],
  },
  {
    judul: 'Bisnis',
    menu: [
      { href: '/produk', label: 'Produk', ikon: 'kotak' },
      { href: '/pelanggan', label: 'Pelanggan', ikon: 'orang' },
      
    ],
  },
  {
    judul: 'Operasional',
    menu: [
      { href: '/kasir', label: 'Kasir', ikon: 'keranjang' },
      // '/pesanan' (Pesanan Masuk, ikon 'amplop') dipasang lagi di sini begitu halamannya ada; sebelumnya menunya mengarah ke 404.
      { href: '/tiket', label: 'Tiket Packing', ikon: 'papan' },
    ],
  },
  {
    judul: 'Profil',
    menu: [
      { href: '/pengaturan', label: 'Pengaturan', ikon: 'gerigi' },
    ],
  },
];

/** Ikon garis, 20px, stroke mengikuti warna teks induknya. */
const IKON: Record<string, string> = {
  kotak: 'M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8',
  keranjang: 'M3 4h2l2 12h11l2-8H7M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm9 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
  amplop: 'M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7zm0 1l9 6 9-6',
  papan: 'M9 3h6v3H9V3zm-2 3H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-1M9 12h6M9 16h4',
  kisi: 'M4 4h6v6H4V4zm10 0h6v4h-6V4zM4 14h6v6H4v-6zm10-2h6v8h-6v-8z',
  grafik: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  gerigi: 'M10.3 2.2h3.4l.6 2.5a7.9 7.9 0 0 1 1.9 1.1l2.5-.8 1.7 2.9-2 1.7a7.9 7.9 0 0 1 0 2.2l2 1.7-1.7 2.9-2.5-.8a7.9 7.9 0 0 1-1.9 1.1l-.6 2.5h-3.4l-.6-2.5a7.9 7.9 0 0 1-1.9-1.1l-2.5.8-1.7-2.9 2-1.7a7.9 7.9 0 0 1 0-2.2l-2-1.7 1.7-2.9 2.5.8a7.9 7.9 0 0 1 1.9-1.1l.6-2.5zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  orang: 'M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 20v-2a4 4 0 0 0-3-3.87M16 2.13a4 4 0 0 1 0 7.75',
};

const grupTampil = user
  ? grup
      .map((g) => ({ ...g, menu: g.menu.filter((m) => bolehAkses(user.role, m.href)) }))
      .filter((g) => g.menu.length > 0)
  : [];

const inisial = user?.name.trim().charAt(0).toUpperCase() ?? '?';
---

<!-- `overflow-x-clip` (bukan `hidden`) di `<html>` dan `<body>`: `hidden` menjadikan body scroll container sehingga seluruh `position: sticky` mati, dan Safari iOS meman `<html>` jadi keduanya ditutup. -->
<!doctype html>
<html lang="id" class="overflow-x-clip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judul} · AJ33</title>
    <meta
      name="description"
      content="Operasi toko: kasir, stok, dan pesanan marketplace dalam satu alur."
    />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#b02a20" />
    <link rel="icon" href="/ikon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/ikon-192.png" />

    <script is:inline>
      // Dibaca sebelum halaman digambar, supaya sidebar tidak berkedip lebar-lalu-menyempit tiap navigasi.
      try {
        if (localStorage.getItem('aj33_sidebar') === 'ciut') {
          document.documentElement.dataset.sidebar = 'ciut';
        }
      } catch {
        // localStorage diblokir (mode privat): sidebar tampil lebar dan itu sudah benar.
      }
    </script>
  </head>

  <body class="min-h-screen overflow-x-clip">
    {
      user ? (
        <div class="flex min-h-screen">
          {/* Saklar laci menu berupa checkbox (bukan tombol JS) agar menu tetap bisa dibuka tanpa JavaScript; anak pertama agar `peer-checked:` menjangkau saudaranya. */}
          <input
            type="checkbox"
            id="buka-menu"
            class="peer sr-only"
            aria-label="Buka menu navigasi"
          />

          {/* Tirai gelap: klik di luar laci menutupnya, seperti yang diharapkan dari laci di ponsel. */}
          <label
            for="buka-menu"
            class="fixed inset-0 z-20 hidden bg-black/40 peer-checked:block md:peer-checked:hidden"
            aria-hidden="true"
          />

          <aside
            id="sidebar"
            class="fixed inset-y-0 left-0 z-30 flex w-[var(--lebar-sidebar)] -translate-x-full
                   flex-col border-r border-[var(--color-garis)] bg-white
                   transition-[width,transform] peer-checked:translate-x-0
                   peer-focus-visible:ring-2 peer-focus-visible:ring-merah-600
                   md:z-20 md:translate-x-0"
          >
            <div class="flex items-center gap-2.5 px-4 py-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-merah-600 text-sm font-bold text-white">
                B
              </span>
              <span class="teks-sidebar min-w-0 flex-1">
                <span class="block truncate text-sm font-bold leading-tight">Toko Ayam Aneka Jaya 33</span>
                <span class="block truncate text-xs text-[var(--color-teks-lembut)]">
                  Bersih dan Halal
                </span>
              </span>
            </div>

            <nav class="flex-1 overflow-y-auto px-2 pb-4">
              {grupTampil.map((g) => (
                <>
                  <p class="nav-judul teks-sidebar">{g.judul}</p>
                  {g.menu.map((m) => {
                    const aktif = path === m.href || path.startsWith(`${m.href}/`);
                    return (
                      <a
                        href={m.href}
                        title={m.label}
                        aria-current={aktif ? 'page' : undefined}
                        class={aktif ? 'nav-tautan-aktif' : 'nav-tautan'}
                      >
                        <svg
                          class="h-5 w-5 shrink-0"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d={IKON[m.ikon]} />
                        </svg>
                        <span class="teks-sidebar truncate">{m.label}</span>
                      </a>
                    );
                  })}
                </>
              ))}
            </nav>

            {/* Hanya di layar lebar; di ponsel laci sudah selebar penuh, jadi menciutkannya tidak menambah ruang. */}
            <button
              id="ciutkan"
              type="button"
              class="hidden items-center gap-3 border-t border-[var(--color-garis)] px-5 py-3.5
                     text-sm text-[var(--color-teks-lembut)] hover:text-merah-700 md:flex"
              aria-controls="sidebar"
              aria-expanded="true"
            >
              <span id="ciutkan-ikon" class="text-base leading-none" aria-hidden="true">«</span>
              <span class="teks-sidebar">Ciutkan</span>
            </button>
          </aside>

          <div class="flex min-w-0 flex-1 flex-col transition-[margin] md:ml-[var(--lebar-sidebar)]">
            {/* Menempel di atas dengan z-[15]: di atas elemen sticky konten (z-10) tapi di bawah tirai dan laci menu (z-20/30). */}
            <header class="sticky top-0 z-[15] flex h-[var(--tinggi-topbar)] items-center justify-between gap-3 border-b border-[var(--color-garis)] bg-white px-4 md:gap-4 md:px-6">
              <div class="flex min-w-0 items-center gap-2">
                {/* Pemicu laci berupa `<label>`, bukan `<button>`, karena yang menggerakkannya adalah checkbox di atas. */}
                <label
                  for="buka-menu"
                  class="aksi-baris -ml-1 shrink-0 cursor-pointer md:hidden"
                  title="Buka menu navigasi"
                >
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M4 7h16M4 12h16M4 17h16" />
                  </svg>
                </label>

                <h1 class="truncate text-xl font-bold tracking-tight md:text-2xl">{judul}</h1>
              </div>

              <div class="flex shrink-0 items-center gap-3">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-merah-600 text-sm font-bold text-white">
                  {inisial}
                </span>
                <span class="hidden text-sm leading-tight sm:block">
                  <span class="block font-semibold">{user.name}</span>
                  <span class="block text-xs capitalize text-[var(--color-teks-lembut)]">
                    {user.role}
                  </span>
                </span>
                <form method="POST" action="/logout">
                  <button class="aksi-baris">Keluar</button>
                </form>
              </div>
            </header>

            {/* Padding lebih rapat di ponsel; bilah menempel (.bilah-tab, .bilah-aksi, .bilah-bawah) membatalkannya dengan margin negatif, jadi keduanya harus berubah bersamaan (lihat theme.css). */}
            <main class="flex-1 px-4 py-4 md:px-6 md:py-6">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main class="mx-auto max-w-6xl px-4 py-8">
          <slot />
        </main>
      )
    }


    <script>
      // Paginasi tanpa muat ulang: tautan `[data-paginasi]` mengambil halaman baru lalu hanya mengganti elemen `[data-daftar]` bernama sama; tanpa JS tautannya tetap memuat halaman penuh.
      let urutan = 0;

      async function ganti(url: string, dorong: boolean, asal?: Element | null) {
        const giliran = ++urutan;
        const lama = document.querySelectorAll<HTMLElement>('[data-daftar]');
        lama.forEach((el) => el.classList.add('opacity-50', 'transition-opacity'));
        try {
          const res = await fetch(url, { headers: { Accept: 'text/html' } });
          if (!res.ok || res.redirected) throw new Error('muat ulang penuh');
          const html = await res.text();
          if (giliran !== urutan) return;
          const baru = new DOMParser().parseFromString(html, 'text/html');
          lama.forEach((el) => {
            const pengganti = baru.getElementById(el.id);
            if (pengganti?.hasAttribute('data-daftar')) el.replaceWith(pengganti);
          });
          if (dorong) history.pushState(null, '', url);
          const kartu = asal?.id ? document.getElementById(asal.id) : null;
          if (kartu && kartu.getBoundingClientRect().top < 0) {
            kartu.style.scrollMarginTop = 'calc(var(--tinggi-topbar, 0px) + 1rem)';
            kartu.scrollIntoView({ block: 'start' });
          }
          document.dispatchEvent(new CustomEvent('daftar-diganti'));
        } catch {
          if (giliran === urutan) location.href = url;
        }
      }

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-paginasi]');
        if (!a) return;
        e.preventDefault();
        ganti(a.getAttribute('href')!, true, a.closest('[data-daftar]'));
      });

      window.addEventListener('popstate', () => {
        if (document.querySelector('[data-daftar]')) ganti(location.pathname + location.search, false);
      });
    </script>

    <script is:inline>
      // Pilihan ciut disimpan agar bertahan lintas halaman, karena tiap klik menu memuat halaman baru.
      (() => {
        const tombol = document.getElementById('ciutkan');
        const ikon = document.getElementById('ciutkan-ikon');
        if (!tombol) return;

        const gambar = () => {
          const ciut = document.documentElement.dataset.sidebar === 'ciut';
          tombol.setAttribute('aria-expanded', String(!ciut));
          tombol.setAttribute('aria-label', ciut ? 'Lebarkan menu' : 'Ciutkan menu');
          if (ikon) ikon.textContent = ciut ? '»' : '«';
        };

        tombol.addEventListener('click', () => {
          const ciut = document.documentElement.dataset.sidebar === 'ciut';
          if (ciut) delete document.documentElement.dataset.sidebar;
          else document.documentElement.dataset.sidebar = 'ciut';

          try {
            localStorage.setItem('aj33_sidebar', ciut ? 'lebar' : 'ciut');
          } catch {
            // Tidak bisa disimpan: pilihannya tetap berlaku untuk halaman ini.
          }
          gambar();
        });

        gambar();
      })();

      // Service worker didaftarkan setelah halaman selesai dimuat agar tidak bersaing dengan permintaan isi halaman.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Registrasi gagal (mis. mode privat) tidak boleh mengganggu; aplikasi jalan tanpa service worker.
          });
        });
      }
    </script>
  </body>
</html>
