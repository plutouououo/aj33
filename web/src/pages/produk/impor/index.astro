---
import Paginasi from '../../../components/Paginasi.astro';
import AppShell from '../../../layouts/AppShell.astro';
import { api, type PaginatedImportBatches } from '../../../lib/api';
import { kelasLencanaImpor, labelStatusImpor } from '../../../lib/impor';
import { waktu } from '../../../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

const params = Astro.url.searchParams;
const limit = 20;
const halaman = Math.max(1, Number(params.get('halaman')) || 1);

const batch = await api<PaginatedImportBatches>(
  `/imports?page=${halaman}&limit=${limit}`,
  { token },
);

const halamanTerakhir = Math.max(1, Math.ceil(batch.total / limit));

function tautanHalaman(ke: number): string {
  return ke === 1 ? '/produk/impor' : `/produk/impor?halaman=${ke}`;
}
---

<AppShell judul="Impor Produk" user={user}>
  <nav class="remah" aria-label="Remah roti">
    <a href="/produk">Produk</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">Impor</span>
  </nav>

  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-[var(--color-teks-lembut)]">{batch.total} berkas pernah diunggah</p>
    <a class="tombol-utama" href="/produk/impor/baru">+ Impor Baru</a>
  </div>

  <div id="daftar-impor" data-daftar>
  {/* Ponsel memakai daftar ringkas (nama berkas, waktu · baris, status); md ke atas tetap tabel. */}
  <ul class="kartu-rapat divide-y divide-[var(--color-garis-lembut)] md:hidden">
    {batch.data.map((b) => (
      <li>
        <a class="flex min-h-11 items-center gap-3 px-3 py-3" href={`/produk/impor/${b.id}`}>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-semibold">{b.file_name}</span>
            <span class="block text-xs text-[var(--color-teks-lembut)]">
              {waktu(b.uploaded_at)} · {b.total_rows} baris
              {b.status === 'committed' && ` · ${b.ok_count} ok, ${b.fail_count} gagal`}
            </span>
          </span>
          <span class={kelasLencanaImpor(b.status, b.fail_count)}>{labelStatusImpor(b.status)}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="kartu-rapat hidden overflow-x-auto md:block">
    <table class="tabel">
      <thead>
        <tr>
          <th>Berkas</th>
          <th>Diunggah</th>
          <th class="text-right">Baris</th>
          <th>Status</th>
          <th class="text-right">Hasil</th>
        </tr>
      </thead>
      <tbody>
        {batch.data.map((b) => (
          <tr>
            <td>
              <a class="font-medium hover:underline" href={`/produk/impor/${b.id}`}>
                {b.file_name}
              </a>
            </td>
            <td class="whitespace-nowrap text-xs text-[var(--color-teks-lembut)]">
              {waktu(b.uploaded_at)}
            </td>
            <td class="sel-angka">{b.total_rows}</td>
            <td>
              <span class={kelasLencanaImpor(b.status, b.fail_count)}>
                {labelStatusImpor(b.status)}
              </span>
            </td>
            <td class="sel-angka text-xs text-[var(--color-teks-lembut)]">
              {b.status === 'committed' ? `${b.ok_count} ok · ${b.fail_count} gagal` : '—'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {batch.data.length === 0 && (
    <p class="py-12 text-center text-[var(--color-teks-lembut)]">Belum ada berkas yang diunggah.</p>
  )}

  <div class="mt-4">
    <Paginasi {halaman} {halamanTerakhir} tautan={tautanHalaman} />
  </div>
  </div>
</AppShell>
