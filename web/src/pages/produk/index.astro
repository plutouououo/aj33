---
import AppShell from '../../layouts/AppShell.astro';
import { api, ApiRequestError, type Category, type PaginatedProducts, type Product } from '../../lib/api';
import { rupiah, tanggal, sisaHari } from '../../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;
const pemilik = user.role === 'owner';

/** Ambang "sudah dekat" untuk kedaluwarsa, dalam hari. */
const DEKAT_KEDALUWARSA = 30;

const TAB = [
  { nilai: 'semua', label: 'Semua' },
  { nilai: 'aktif', label: 'Aktif' },
  { nilai: 'menipis', label: 'Stok menipis' },
  { nilai: 'habis', label: 'Habis' },
  { nilai: 'nonaktif', label: 'Nonaktif' },
  { nilai: 'kanal-kosong', label: 'Harga kanal kosong' },
] as const;
type Tab = (typeof TAB)[number]['nilai'];

const URUT = [
  { nilai: 'terbaru', label: 'Terbaru diubah' },
  { nilai: 'stok-terendah', label: 'Stok terendah' },
  { nilai: 'harga-tertinggi', label: 'Harga tertinggi' },
  { nilai: 'nama', label: 'Nama A–Z' },
] as const;
type Urut = (typeof URUT)[number]['nilai'];

let galat: string | null = null;

/**
 * Harga dan stok TIDAK bisa disunting di sini -- lihat "Kelola" pada tiap
 * baris, yang membuka `/produk/{id}` dan formulir simpan/koreksinya sendiri.
 * Daftar ini murni menampilkan, supaya angka yang terlihat sambil memindai
 * banyak produk tidak bisa diam-diam berubah lewat form yang salah pencet.
 *
 * Aksi yang tersedia dari sini cuma yang menyentuh STATUS baris, bukan
 * isinya: toggle aktif/nonaktif satu baris (`toggle`), dan tiga aksi massal
 * (aktifkan, nonaktifkan, hapus) atas produk yang dicentang lewat `pilih_id`
 * (`aksi`).
 */
if (Astro.request.method === 'POST') {
  if (!pemilik) {
    galat = 'Kamu tidak punya akses ke fitur ini.';
  } else {
    const form = await Astro.request.formData();
    const aksi = String(form.get('aksi') ?? '');
    // Dikodekan sebagai "id:target" pada satu tombol per baris -- lihat
    // komentar di baris tombolnya sendiri soal alasannya.
    const toggle = String(form.get('toggle') ?? '');

    if (toggle) {
      const [id, target] = toggle.split(':');
      try {
        await api(`/products/${id}`, { method: 'PATCH', token, body: { is_active: target === '1' } });
        const tujuan = new URL(Astro.url);
        tujuan.searchParams.set('pesan', target === '1' ? 'aktif' : 'nonaktif');
        return Astro.redirect(tujuan.pathname + tujuan.search, 303);
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal mengubah status produk.';
      }
    } else if (aksi === 'bulk-aktif' || aksi === 'bulk-nonaktif' || aksi === 'bulk-hapus') {
      const dipilih = form.getAll('pilih_id').map(String);
      if (dipilih.length === 0) {
        galat = 'Pilih dulu produk yang mau diubah.';
      } else {
        // Satu per satu, bukan Promise.all: produk yang ditolak backend
        // (mis. masih punya varian, atau sudah pernah terjual -- lihat
        // `penahan_hapus` di backend) tidak boleh menghentikan baris lain
        // yang sebetulnya bisa berhasil.
        let berhasil = 0;
        const pesanGalat: string[] = [];
        for (const idBaris of dipilih) {
          try {
            if (aksi === 'bulk-hapus') {
              await api(`/products/${idBaris}`, { method: 'DELETE', token });
            } else {
              await api(`/products/${idBaris}`, {
                method: 'PATCH',
                token,
                body: { is_active: aksi === 'bulk-aktif' },
              });
            }
            berhasil++;
          } catch (err) {
            pesanGalat.push(err instanceof ApiRequestError ? err.message : 'Gagal memproses salah satu produk.');
          }
        }

        if (pesanGalat.length > 0) {
          // Semua pesan ditampilkan, bukan cuma yang pertama -- pada
          // "Hapus Terpilih" khususnya, produk yang gagal (mis. sudah
          // pernah terjual) TETAP ada di database walau baris lain
          // berhasil. Kalau cuma pesan pertama yang tampil, sisanya
          // terlihat seperti berhasil padahal tidak -- dan baru ketahuan
          // saat baris itu "muncul lagi" pada kunjungan berikutnya.
          galat =
            berhasil > 0
              ? `${berhasil} produk berhasil. ${pesanGalat.length} gagal: ${pesanGalat.join(' | ')}`
              : pesanGalat.join(' | ');
        } else {
          const tujuan = new URL(Astro.url);
          tujuan.searchParams.set('pesan', aksi);
          return Astro.redirect(tujuan.pathname + tujuan.search, 303);
        }
      }
    }
  }
}

const params = Astro.url.searchParams;
const cari = params.get('cari')?.trim() ?? '';
const kategoriDipilih = params.get('kategori') ?? '';
const tab = (TAB.find((t) => t.nilai === params.get('tab'))?.nilai ?? 'semua') as Tab;
const urut = (URUT.find((u) => u.nilai === params.get('urut'))?.nilai ?? 'terbaru') as Urut;
const hanyaMenipis = params.get('hanya_menipis') === '1';
const PER_HALAMAN = [10, 25, 50, 100];
const limit = PER_HALAMAN.includes(Number(params.get('per'))) ? Number(params.get('per')) : 25;
const halaman = Math.max(1, Number(params.get('halaman')) || 1);

const PESAN: Record<string, string> = {
  aktif: 'Produk diaktifkan.',
  nonaktif: 'Produk dinonaktifkan.',
  dibuat: 'Produk ditambahkan.',
  'bulk-aktif': 'Produk terpilih diaktifkan.',
  'bulk-nonaktif': 'Produk terpilih dinonaktifkan.',
  'bulk-hapus': 'Produk terpilih dihapus.',
};
const kodePesan = params.get('pesan') ?? '';
const sukses = Object.hasOwn(PESAN, kodePesan) ? PESAN[kodePesan] : null;

/**
 * Seluruh saringan yang sedang aktif sebagai query string. Satu sumber untuk
 * tautan tab, tautan halaman, dan titipan `?dari=` ke halaman rincian --
 * lihat `SARINGAN_DAFTAR` di `lib/produk.ts`, yang harus disebut ulang di
 * sini setiap kali daftar kunci ini berubah.
 */
function saringan(ke: number, override: Partial<{ tab: Tab }> = {}): string {
  const p = new URLSearchParams();
  if (cari) p.set('cari', cari);
  if (kategoriDipilih) p.set('kategori', kategoriDipilih);
  const tabEfektif = override.tab ?? tab;
  if (tabEfektif !== 'semua') p.set('tab', tabEfektif);
  if (urut !== 'terbaru') p.set('urut', urut);
  if (hanyaMenipis) p.set('hanya_menipis', '1');
  if (limit !== 25) p.set('per', String(limit));
  if (ke !== 1) p.set('halaman', String(ke));
  return p.toString();
}
function tautanHalaman(ke: number): string {
  const q = saringan(ke);
  return q ? `/produk?${q}` : '/produk';
}
function tautanTab(t: Tab): string {
  const q = saringan(1, { tab: t });
  return q ? `/produk?${q}` : '/produk';
}

/**
 * Satu permintaan untuk induk MAUPUN varian sekaligus (`scope` dikosongkan
 * -- lihat komentar "Kosong berarti semua baris" di `catalog/repo.rs`),
 * dikelompokkan di sini jadi varian-per-induk. Alternatifnya, satu permintaan
 * tambahan per induk yang punya varian, gampang jadi puluhan permintaan pada
 * daftar yang panjang.
 *
 * Konsekuensinya, batas 200 baris backend sekarang dibagi antara induk DAN
 * varian, bukan induk saja -- lihat catatan "terpotong" di bawah.
 */
const kueriProduk = new URLSearchParams({ include_inactive: 'true', limit: '200' });
if (kategoriDipilih) kueriProduk.set('category_id', kategoriDipilih);

const [semuaProduk, kategori] = await Promise.all([
  api<PaginatedProducts>(`/products?${kueriProduk}`, { token }),
  api<Category[]>('/categories', { token }),
]);

const terpotong = semuaProduk.total > semuaProduk.data.length;

const varianIndukPeta = new Map<string, Product[]>();
for (const p of semuaProduk.data) {
  if (!p.parent_id) continue;
  const daftar = varianIndukPeta.get(p.parent_id);
  if (daftar) daftar.push(p);
  else varianIndukPeta.set(p.parent_id, [p]);
}

/** Induk yang punya varian tidak dijual sendiri -- harga dan stok varian yang berlaku. */
function stokInduk(p: Product, varian: Product[]): { menipis: boolean; habis: boolean } {
  if (varian.length > 0) {
    return {
      menipis: varian.some((v) => v.stock_qty > 0 && v.stock_qty <= v.low_stock_threshold),
      habis: varian.every((v) => v.stock_qty <= 0),
    };
  }
  return { menipis: p.stock_qty > 0 && p.stock_qty <= p.low_stock_threshold, habis: p.stock_qty <= 0 };
}
function kanalKosong(p: Product, varian: Product[]): boolean {
  if (varian.length > 0) return varian.some((v) => v.price_shopee === null || v.price_tiktok === null);
  return p.price_shopee === null || p.price_tiktok === null;
}
function kenaTab(p: Product, varian: Product[], t: Tab): boolean {
  if (t === 'aktif') return p.is_active;
  if (t === 'nonaktif') return !p.is_active;
  if (t === 'kanal-kosong') return kanalKosong(p, varian);
  const stok = stokInduk(p, varian);
  if (t === 'habis') return stok.habis;
  if (t === 'menipis') return stok.menipis;
  return true;
}

let induk = semuaProduk.data.filter((p) => !p.parent_id);

// Pencarian hanya menyentuh baris INDUK -- persis seperti daftar lama --
// bukan nama tiap varian: varian yang cocok tapi induknya tidak tetap tidak
// akan muncul, karena baris yang muncul di daftar ini selalu baris induk.
const q = cari.toLowerCase();
if (q) {
  induk = induk.filter((p) => p.name.toLowerCase().includes(q) || (p.sku ?? '').toLowerCase().includes(q));
}

// Hitungan tab dari induk yang SUDAH disaring pencarian & kategori, TAPI
// SEBELUM disaring tab itu sendiri -- supaya tab yang sedang tidak aktif
// tetap menunjukkan berapa baris yang akan muncul kalau ditekan.
const hitungTab = (t: Tab) => induk.filter((p) => kenaTab(p, varianIndukPeta.get(p.id) ?? [], t)).length;

let terlihat = induk.filter((p) => kenaTab(p, varianIndukPeta.get(p.id) ?? [], tab));
if (hanyaMenipis) {
  terlihat = terlihat.filter((p) => stokInduk(p, varianIndukPeta.get(p.id) ?? []).menipis);
}

terlihat = terlihat.slice();
if (urut === 'stok-terendah') terlihat.sort((a, b) => a.stock_qty - b.stock_qty);
else if (urut === 'harga-tertinggi') terlihat.sort((a, b) => b.price - a.price);
else if (urut === 'nama') terlihat.sort((a, b) => a.name.localeCompare(b.name, 'id'));
else terlihat.sort((a, b) => b.updated_at.localeCompare(a.updated_at));

const total = terlihat.length;
const halamanTerakhir = Math.max(1, Math.ceil(total / limit));
if (halaman > halamanTerakhir && total > 0) {
  return Astro.redirect(tautanHalaman(halamanTerakhir), 302);
}
const mulai = (halaman - 1) * limit;
const halamanIni = terlihat.slice(mulai, mulai + limit);
const dari = total === 0 ? 0 : mulai + 1;
const sampai = Math.min(mulai + limit, total);

const ringkasan = `${induk.length} produk · ${induk.filter((p) => p.is_active).length} aktif · ${
  induk.filter((p) => stokInduk(p, varianIndukPeta.get(p.id) ?? []).menipis).length
} perlu restock`;

/** Titipan "dari mana" untuk halaman rincian dan halaman tambah. */
const titipan = saringan(halaman);
const bawaSaringan = titipan ? `?dari=${encodeURIComponent(titipan)}` : '';
---

<AppShell judul="Produk" user={user}>
  {galat && <p class="galat mb-4" role="alert">{galat}</p>}
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-[var(--color-teks-lembut)]">{ringkasan}</p>
    {pemilik && <a class="tombol-utama" href={`/produk/baru${bawaSaringan}`}>+ Tambah Produk</a>}
  </div>

  {/* Tab status, sekaligus saringan: menekannya menavigasi ke daftar yang
      sama dengan `tab` yang berbeda -- bukan filter sisi klien, supaya tetap
      berfungsi tanpa JavaScript dan hitungannya selalu sinkron dengan yang
      sungguhan dirender. */}
  <div class="mb-4 flex gap-2 overflow-x-auto pb-1">
    {TAB.map((t) => (
      <a href={tautanTab(t.nilai)} class={t.nilai === tab ? 'pil-aktif' : 'pil-diam'}>
        {t.label}
        <span
          class:list={[
            'lencana ml-1.5',
            t.nilai === tab ? 'bg-white/25 text-white' : 'bg-stone-100 text-stone-600',
          ]}
        >
          {hitungTab(t.nilai)}
        </span>
      </a>
    ))}
  </div>

  <form method="GET" class="kartu mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_10rem_10rem_9rem_7rem]">
    <input type="hidden" name="tab" value={tab === 'semua' ? '' : tab} />

    <div>
      <label class="label" for="cari">Cari</label>
      <input
        class="kolom"
        id="cari"
        type="search"
        name="cari"
        value={cari}
        placeholder="Cari nama atau SKU..."
      />
    </div>

    <div>
      <label class="label" for="kategori">Kategori</label>
      <select class="kolom" id="kategori" name="kategori">
        <option value="" selected={!kategoriDipilih}>Semua Kategori</option>
        {kategori.map((k) => (
          <option value={k.id} selected={kategoriDipilih === k.id}>
            {k.name}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label class="label" for="urut">Urutkan</label>
      <select class="kolom" id="urut" name="urut">
        {URUT.map((u) => (
          <option value={u.nilai} selected={urut === u.nilai}>
            {u.label}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label class="label" for="per">Per Halaman</label>
      <select class="kolom" id="per" name="per">
        {PER_HALAMAN.map((n) => (
          <option value={n} selected={limit === n}>
            {n}
          </option>
        ))}
      </select>
    </div>

    <label class="flex items-center gap-2 self-end pb-2.5 text-sm text-stone-700">
      <input
        type="checkbox"
        name="hanya_menipis"
        value="1"
        checked={hanyaMenipis}
        class="h-4 w-4 accent-merah-600"
      />
      Stok menipis saja
    </label>

    <div class="sm:col-span-2 lg:col-span-5">
      <button class="tombol-halus" type="submit">Terapkan</button>
    </div>
  </form>

  {terpotong && (
    <p class="mb-3 text-xs text-[var(--color-teks-lembut)]">
      Menampilkan 200 baris pertama (induk dan varian tercampur). Pakai pencarian atau kategori
      untuk mempersempit.
    </p>
  )}

  {/* Satu form membungkus tabel dan bilah aksi massal di bawahnya: checkbox
      pilih tiap baris (`pilih_id`) ikut terkirim apa pun tombol yang ditekan
      -- termasuk tombol Aktifkan/Nonaktifkan per baris, yang menumpang di
      form yang sama lewat kode "id:target" (lihat komentar di tombolnya). */}
  <form method="POST" id="borang-produk">
  <div class="kartu-rapat overflow-x-auto">
    <table class="tabel">
      <thead>
        <tr>
          {pemilik && (
            <th class="w-8">
              <input
                type="checkbox"
                class="hanya-js h-4 w-4 accent-white"
                data-pilih-semua
                aria-label="Pilih semua produk pada halaman ini"
              />
            </th>
          )}
          <th>Produk</th>
          <th class="text-right">Harga dasar</th>
          <th class="text-right">Shopee</th>
          <th class="text-right">Tokopedia / TikTok</th>
          <th class="text-right">Stok</th>
          <th>Kedaluwarsa</th>
          <th>Status</th>
          {pemilik && <th class="text-right">Aksi</th>}
        </tr>
      </thead>
      <tbody>
        {halamanIni.map((p) => {
          const varian = varianIndukPeta.get(p.id) ?? [];
          const punyaVarian = varian.length > 0;
          const stok = stokInduk(p, varian);
          const dekat = p.nearest_expiry !== null && DEKAT_KEDALUWARSA >= sisaHari(p.nearest_expiry);
          const atribut = [p.category_name, p.product_type, p.variant_grade, p.variant_size]
            .filter(Boolean)
            .join(' · ');
          const catatan = kanalKosong(p, varian);

          return (
            <Fragment>
              <tr>
                {pemilik && (
                  <td>
                    <input
                      type="checkbox"
                      name="pilih_id"
                      value={p.id}
                      class="h-4 w-4 accent-merah-600"
                      data-pilih-baris
                      aria-label={`Pilih ${p.name}`}
                    />
                  </td>
                )}
                <td>
                  <div class="flex items-start gap-2.5">
                    <span class="foto-produk h-10 w-10 shrink-0 rounded border">
                      {p.image_url && (
                        <img src={p.image_url} alt="" loading="lazy" class="h-full w-full rounded object-cover" />
                      )}
                    </span>
                    <div class="min-w-0">
                      <a class="font-medium hover:underline" href={`/produk/${p.id}${bawaSaringan}`}>
                        {p.name}
                      </a>
                      <span class="block font-mono text-xs text-[var(--color-teks-samar)]">{p.sku ?? '—'}</span>
                      {atribut && (
                        <span class="block text-xs text-[var(--color-teks-lembut)]">{atribut}</span>
                      )}
                      {catatan && (
                        <span class="mt-0.5 block text-xs font-semibold text-merah-700">
                          Harga kanal belum lengkap
                        </span>
                      )}
                    </div>
                  </div>
                </td>

                {punyaVarian ? (
                  <td class="sel-angka text-xs text-[var(--color-teks-samar)]" colspan={3}>
                    Harga per varian
                  </td>
                ) : (
                  <Fragment>
                    <td class="sel-angka">{rupiah(p.price)}</td>
                    <td class="sel-angka text-xs text-[var(--color-teks-lembut)]">
                      {p.price_shopee === null ? '—' : rupiah(p.price_shopee)}
                    </td>
                    <td class="sel-angka text-xs text-[var(--color-teks-lembut)]">
                      {p.price_tiktok === null ? '—' : rupiah(p.price_tiktok)}
                    </td>
                  </Fragment>
                )}

                <td class="sel-angka">
                  {punyaVarian ? (
                    <span class="text-xs text-[var(--color-teks-samar)]">per varian</span>
                  ) : (
                    <Fragment>
                      <span class={stok.menipis || stok.habis ? 'font-semibold text-red-600' : ''}>
                        {p.stock_qty}
                      </span>
                      {stok.menipis && <span class="ml-1 text-xs font-semibold text-red-600">menipis</span>}
                    </Fragment>
                  )}
                </td>

                <td class="whitespace-nowrap text-xs">
                  {p.nearest_expiry ? (
                    <span class={dekat ? 'font-semibold text-red-600' : 'text-[var(--color-teks-lembut)]'}>
                      {tanggal(p.nearest_expiry)}
                    </span>
                  ) : (
                    <span class="text-[var(--color-teks-samar)]">—</span>
                  )}
                </td>

                <td>
                  <span class={p.is_active ? 'lencana-selesai' : 'lencana-nonaktif'}>
                    {p.is_active ? 'Aktif' : 'Nonaktif'}
                  </span>
                </td>

                {pemilik && (
                  <td class="whitespace-nowrap text-right">
                    {/* Atas-bawah, bukan berjajar: dua target sentuh sempit
                        bersisian mengundang salah ketuk, apalagi "Nonaktifkan"
                        yang akibatnya langsung berlaku tanpa konfirmasi. */}
                    <div class="flex flex-col items-end gap-1">
                      <a class="aksi-baris" href={`/produk/${p.id}${bawaSaringan}`}>Kelola</a>
                      {/* Kode "id:target" pada SATU tombol, bukan hidden field
                          terpisah: tombol ini hidup di dalam form besar yang
                          juga menampung checkbox `pilih_id` tiap baris lain,
                          jadi hidden field bernama `id` akan tertukar antar
                          baris. Nilai tombol yang diklik yang ikut terkirim
                          -- tombol yang tidak diklik tidak pernah mengirim
                          apa-apa. */}
                      <button class="aksi-baris" type="submit" name="toggle" value={`${p.id}:${p.is_active ? 0 : 1}`}>
                        {p.is_active ? 'Nonaktifkan' : 'Aktifkan'}
                      </button>
                    </div>
                  </td>
                )}
              </tr>

              {/* Baris varian selalu terbuka, tidak ada tombol lipat: pada
                  toko sekecil ini jumlah variannya sedikit, dan lipatan
                  yang bergantung JavaScript untuk tabel adalah kerumitan
                  yang tidak pantas ditukar dengan sekadar sedikit baris
                  tambahan. Harganya sendiri tidak bisa disunting di sini --
                  tiap varian punya halaman kelolanya sendiri. */}
              {varian.map((v) => {
                const vAtribut = [v.variant_grade, v.variant_size].filter(Boolean).join(' · ');
                const vMenipis = v.stock_qty > 0 && v.stock_qty <= v.low_stock_threshold;
                const vHabis = v.stock_qty <= 0;
                return (
                  <tr class="bg-stone-50/60">
                    {pemilik && <td />}
                    <td class="pl-8">
                      <span class="block text-sm font-medium">{v.name}</span>
                      <span class="block font-mono text-xs text-[var(--color-teks-samar)]">{v.sku ?? '—'}</span>
                      {vAtribut && <span class="block text-xs text-[var(--color-teks-lembut)]">{vAtribut}</span>}
                    </td>
                    <td class="sel-angka">{rupiah(v.price)}</td>
                    <td class="sel-angka text-xs text-[var(--color-teks-samar)]">
                      {v.price_shopee === null ? '—' : rupiah(v.price_shopee)}
                    </td>
                    <td class="sel-angka text-xs text-[var(--color-teks-samar)]">
                      {v.price_tiktok === null ? '—' : rupiah(v.price_tiktok)}
                    </td>
                    <td class="sel-angka">
                      <span class={vHabis || vMenipis ? 'font-semibold text-red-600' : ''}>{v.stock_qty}</span>
                    </td>
                    <td class="whitespace-nowrap text-xs">
                      {v.nearest_expiry ? (
                        <span class={DEKAT_KEDALUWARSA >= sisaHari(v.nearest_expiry) ? 'font-semibold text-red-600' : 'text-[var(--color-teks-lembut)]'}>
                          {tanggal(v.nearest_expiry)}
                        </span>
                      ) : (
                        <span class="text-[var(--color-teks-samar)]">—</span>
                      )}
                    </td>
                    <td>
                      <span class={v.is_active ? 'lencana-selesai' : 'lencana-nonaktif'}>
                        {v.is_active ? 'Aktif' : 'Nonaktif'}
                      </span>
                    </td>
                    {pemilik && (
                      <td class="whitespace-nowrap text-right">
                        <a class="aksi-baris" href={`/produk/${v.id}${bawaSaringan}`}>Kelola varian</a>
                      </td>
                    )}
                  </tr>
                );
              })}
            </Fragment>
          );
        })}
      </tbody>
    </table>

    {halamanIni.length === 0 && (
      <p class="py-12 text-center text-[var(--color-teks-lembut)]">
        {cari ? `Tidak ada produk yang cocok dengan "${cari}".` : 'Tidak ada produk pada tab ini.'}
      </p>
    )}
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="text-[var(--color-teks-lembut)]">
      Menampilkan <span class="tabular-nums">{dari}–{sampai}</span> dari
      <span class="tabular-nums"> {total}</span> produk
    </p>

    {halamanTerakhir > 1 && (
      <div class="flex items-center gap-2">
        {halaman > 1 ? (
          <a class="tombol-halus" href={tautanHalaman(halaman - 1)}>← Sebelumnya</a>
        ) : (
          <span class="tombol-halus opacity-40">← Sebelumnya</span>
        )}
        <span class="px-2 tabular-nums text-[var(--color-teks-lembut)]">{halaman} / {halamanTerakhir}</span>
        {halaman < halamanTerakhir ? (
          <a class="tombol-halus" href={tautanHalaman(halaman + 1)}>Berikutnya →</a>
        ) : (
          <span class="tombol-halus opacity-40">Berikutnya →</span>
        )}
      </div>
    )}
  </div>

  {/* Bilah aksi massal: tanpa JavaScript selalu terlihat (satu-satunya cara
      menekan aksi massal), server yang menolak kalau belum ada yang
      dicentang. Dengan JavaScript, hitungan terpilih tampil hidup dan
      "Hapus Terpilih" minta konfirmasi -- lihat skrip di bawah. */}
  {pemilik && (
    <div class="bilah-bawah">
      <span class="hanya-js text-sm font-medium" data-ringkas-bilah>Tidak ada produk dipilih</span>
      <div class="ml-auto flex flex-wrap gap-2">
        <button class="tombol-halus" type="submit" name="aksi" value="bulk-aktif">Aktifkan Terpilih</button>
        <button class="tombol-halus" type="submit" name="aksi" value="bulk-nonaktif">Nonaktifkan Terpilih</button>
        <button class="tombol-bahaya" type="submit" name="aksi" value="bulk-hapus" data-tombol-hapus>
          Hapus Terpilih
        </button>
      </div>
    </div>
  )}
  </form>
</AppShell>

{/*
  Progressive enhancement murni: skrip ini cuma menghitung ulang teks dari
  checkbox yang sudah ada di HTML dan meminta konfirmasi sebelum menghapus,
  persis pola yang sama dengan halaman kasir. Tidak ada baris yang dirakit,
  tidak ada request yang dikirim dari sini -- pengiriman tetap lewat submit
  form biasa, dan tanpa skrip ini pun aksi massal tetap bisa dipakai (cuma
  tanpa hitungan hidup dan tanpa konfirmasi hapus).
*/}
<script is:inline>
  (function () {
    var borang = document.getElementById('borang-produk');
    if (!borang) return;

    document.documentElement.dataset.js = 'ya';

    var checkSemua = borang.querySelector('[data-pilih-semua]');
    var checkBaris = Array.prototype.slice.call(borang.querySelectorAll('[data-pilih-baris]'));
    var ringkas = borang.querySelector('[data-ringkas-bilah]');
    var tombolHapus = borang.querySelector('[data-tombol-hapus]');

    function hitungUlang() {
      var dipilih = checkBaris.filter(function (c) {
        return c.checked;
      }).length;
      if (ringkas) {
        ringkas.textContent = dipilih > 0 ? dipilih + ' produk dipilih' : 'Tidak ada produk dipilih';
      }
    }

    checkBaris.forEach(function (c) {
      c.addEventListener('change', hitungUlang);
    });
    if (checkSemua) {
      checkSemua.addEventListener('change', function () {
        checkBaris.forEach(function (c) {
          c.checked = checkSemua.checked;
        });
        hitungUlang();
      });
    }

    if (tombolHapus) {
      tombolHapus.addEventListener('click', function (e) {
        var dipilih = checkBaris.filter(function (c) {
          return c.checked;
        }).length;
        if (dipilih === 0) return;
        var pesan =
          dipilih === 1
            ? 'Hapus 1 produk terpilih? Tindakan ini tidak bisa dibatalkan.'
            : 'Hapus ' + dipilih + ' produk terpilih? Tindakan ini tidak bisa dibatalkan.';
        if (!window.confirm(pesan)) e.preventDefault();
      });
    }

    hitungUlang();
  })();
</script>
