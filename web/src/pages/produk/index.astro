---
import AppShell from '../../layouts/AppShell.astro';
import { api, ApiRequestError, type Category, type PaginatedProducts } from '../../lib/api';
import { rupiah } from '../../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

let galat: string | null = null;
let sukses: string | null = null;

// Owner mengubah produk lewat form biasa. Tidak ada JavaScript yang terlibat:
// browser mengirim POST, server merender ulang halaman dengan hasilnya.
if (Astro.request.method === 'POST') {
  if (user.role !== 'owner') {
    galat = 'Kamu tidak punya akses ke fitur ini.';
  } else {
    const form = await Astro.request.formData();
    const aksi = String(form.get('aksi') ?? 'tambah');

    if (aksi === 'aktif') {
      const id = String(form.get('id') ?? '');
      const jadikanAktif = form.get('is_active') === '1';
      try {
        await api(`/products/${id}`, {
          method: 'PATCH',
          token,
          body: { is_active: jadikanAktif },
        });
        sukses = jadikanAktif ? 'Produk diaktifkan.' : 'Produk dinonaktifkan.';
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal mengubah status produk.';
      }
    } else {
      const nama = String(form.get('name') ?? '').trim();
      const harga = Number(form.get('price'));
      const stok = Number(form.get('stock_qty') ?? 0);

      // Harga marketplace boleh dikosongkan: kosong berarti "belum diatur,
      // pakai harga dasar". Dikirim sebagai undefined, bukan 0 -- 0 berarti
      // gratis, dan produk gratis di marketplace adalah kerugian langsung.
      const hargaKanal = (kolom: string): number | undefined => {
        const mentah = String(form.get(kolom) ?? '').trim();
        if (!mentah) return undefined;
        const nilai = Number(mentah);
        return Number.isFinite(nilai) ? nilai : undefined;
      };
      const hargaShopee = hargaKanal('price_shopee');
      const hargaTiktok = hargaKanal('price_tiktok');

      if (!nama) {
        galat = 'Nama produk wajib diisi.';
      } else if (!Number.isFinite(harga) || harga < 0) {
        galat = 'Harga dasar harus berupa angka yang tidak negatif.';
      } else if ((hargaShopee ?? 0) < 0 || (hargaTiktok ?? 0) < 0) {
        galat = 'Harga marketplace tidak boleh negatif.';
      } else {
        try {
          await api('/products', {
            method: 'POST',
            token,
            body: {
              name: nama,
              sku: String(form.get('sku') ?? '').trim() || undefined,
              category_id: String(form.get('category_id') ?? '') || undefined,
              price: harga,
              price_shopee: hargaShopee,
              price_tiktok: hargaTiktok,
              stock_qty: Number.isFinite(stok) ? stok : 0,
              low_stock_threshold: Number(form.get('low_stock_threshold')) || 5,
              unit: String(form.get('unit') ?? '').trim() || undefined,
              storage_location: String(form.get('storage_location') ?? '').trim() || undefined,
            },
          });
          sukses = `Produk "${nama}" ditambahkan.`;
        } catch (err) {
          galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan produk.';
        }
      }
    }
  }
}

const params = Astro.url.searchParams;
const cari = params.get('cari')?.trim() ?? '';
const kategoriDipilih = params.get('kategori') ?? '';
// Backend hanya mengenal "sembunyikan yang nonaktif" atau "tampilkan semua".
// Pilihan status di sini mengikuti itu apa adanya, bukan menjanjikan saringan
// "hanya nonaktif" yang tidak bisa dilayani.
const status = params.get('status') === 'semua' ? 'semua' : 'aktif';
const PER_HALAMAN = [10, 25, 50, 100];
const limit = PER_HALAMAN.includes(Number(params.get('per'))) ? Number(params.get('per')) : 25;
const halaman = Math.max(1, Number(params.get('halaman')) || 1);

const kueri = new URLSearchParams({ limit: String(limit), page: String(halaman) });
if (cari) kueri.set('search', cari);
if (kategoriDipilih) kueri.set('category_id', kategoriDipilih);
if (status === 'semua') kueri.set('include_inactive', 'true');

const [daftar, kategori] = await Promise.all([
  api<PaginatedProducts>(`/products?${kueri}`, { token }),
  api<Category[]>('/categories', { token }),
]);

const halamanTerakhir = Math.max(1, Math.ceil(daftar.total / daftar.limit));
const dari = daftar.total === 0 ? 0 : (daftar.page - 1) * daftar.limit + 1;
const sampai = Math.min(daftar.page * daftar.limit, daftar.total);

/** Tautan halaman lain dengan seluruh saringan yang sedang aktif tetap terbawa. */
function tautanHalaman(ke: number): string {
  const p = new URLSearchParams();
  if (cari) p.set('cari', cari);
  if (kategoriDipilih) p.set('kategori', kategoriDipilih);
  if (status === 'semua') p.set('status', 'semua');
  if (limit !== 25) p.set('per', String(limit));
  if (ke !== 1) p.set('halaman', String(ke));
  const q = p.toString();
  return q ? `/produk?${q}` : '/produk';
}
---

<AppShell judul="Produk" user={user}>
  {
    user.role === 'owner' && (
      <details class="mb-5" open={galat !== null}>
        <summary class="tombol-utama cursor-pointer list-none">+ Tambah Produk</summary>

        <form method="POST" class="kartu mt-3 grid gap-4 sm:grid-cols-2">
          <input type="hidden" name="aksi" value="tambah" />

          <div class="sm:col-span-2">
            <label class="label" for="name">Nama produk</label>
            <input class="kolom" id="name" name="name" required />
          </div>

          <div>
            <label class="label" for="sku">SKU</label>
            <input class="kolom" id="sku" name="sku" placeholder="opsional" />
          </div>

          <div>
            <label class="label" for="category_id">Kategori</label>
            <select class="kolom" id="category_id" name="category_id">
              <option value="">— tanpa kategori —</option>
              {kategori.map((k) => (
                <option value={k.id}>{k.name}</option>
              ))}
            </select>
          </div>

          <div class="sm:col-span-2">
            <p class="label mb-2">Harga</p>
            <div class="grid gap-4 sm:grid-cols-3">
              <div>
                <label class="label" for="price">Dasar / kasir (Rp)</label>
                <input
                  class="kolom"
                  id="price"
                  name="price"
                  type="number"
                  min="0"
                  step="1"
                  required
                />
              </div>

              <div>
                <label class="label" for="price_shopee">Shopee (Rp)</label>
                <input
                  class="kolom"
                  id="price_shopee"
                  name="price_shopee"
                  type="number"
                  min="0"
                  step="1"
                  placeholder="ikut harga dasar"
                />
              </div>

              <div>
                <label class="label" for="price_tiktok">Tokopedia / TikTok (Rp)</label>
                <input
                  class="kolom"
                  id="price_tiktok"
                  name="price_tiktok"
                  type="number"
                  min="0"
                  step="1"
                  placeholder="ikut harga dasar"
                />
              </div>
            </div>
            <p class="mt-1.5 text-xs text-[var(--color-teks-lembut)]">
              Harga marketplace boleh dikosongkan — artinya belum diatur dan mengikuti harga
              dasar. Mengisi 0 berarti digratiskan.
            </p>
          </div>

          <div>
            <label class="label" for="unit">Satuan</label>
            <input class="kolom" id="unit" name="unit" placeholder="pcs" />
          </div>

          <div>
            <label class="label" for="storage_location">Lokasi penyimpanan</label>
            <input
              class="kolom"
              id="storage_location"
              name="storage_location"
              placeholder="mis. Rak A3"
            />
            <p class="mt-1.5 text-xs text-[var(--color-teks-lembut)]">
              Ditampilkan ke pengepak di tiket packing.
            </p>
          </div>

          <div>
            <label class="label" for="stock_qty">Stok awal</label>
            <input class="kolom" id="stock_qty" name="stock_qty" type="number" min="0" value="0" />
          </div>

          <div>
            <label class="label" for="low_stock_threshold">Batas stok menipis</label>
            <input
              class="kolom"
              id="low_stock_threshold"
              name="low_stock_threshold"
              type="number"
              min="0"
              value="5"
            />
          </div>

          <div class="sm:col-span-2">
            <button class="tombol-utama" type="submit">Simpan produk</button>
          </div>
        </form>
      </details>
    )
  }

  {galat && <p class="galat mb-4" role="alert">{galat}</p>}
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  {/* Saringan dikirim sebagai GET biasa, jadi keadaan daftar selalu ada di
      URL -- bisa di-bookmark, dibagikan, dan tombol kembali bekerja. */}
  <form method="GET" class="kartu mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_13rem_11rem_8rem]">
    <div>
      <label class="label" for="cari">Cari</label>
      <input
        class="kolom"
        id="cari"
        type="search"
        name="cari"
        value={cari}
        placeholder="Cari nama atau SKU..."
      />
    </div>

    <div>
      <label class="label" for="kategori">Kategori</label>
      <select class="kolom" id="kategori" name="kategori">
        <option value="" selected={!kategoriDipilih}>Semua Kategori</option>
        {kategori.map((k) => (
          <option value={k.id} selected={kategoriDipilih === k.id}>
            {k.name}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label class="label" for="status">Status</label>
      <select class="kolom" id="status" name="status">
        <option value="aktif" selected={status === 'aktif'}>Hanya Aktif</option>
        <option value="semua" selected={status === 'semua'}>Semua Status</option>
      </select>
    </div>

    <div>
      <label class="label" for="per">Per Halaman</label>
      <select class="kolom" id="per" name="per">
        {PER_HALAMAN.map((n) => (
          <option value={n} selected={limit === n}>
            {n}
          </option>
        ))}
      </select>
    </div>

    <div class="sm:col-span-2 lg:col-span-4">
      <button class="tombol-halus" type="submit">Terapkan</button>
    </div>
  </form>

  <div class="kartu-rapat overflow-x-auto">
    <table class="tabel">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Nama Produk</th>
          <th>Kategori</th>
          <th class="text-right">Harga</th>
          <th class="text-right">Stok</th>
          <th>Status</th>
          {user.role === 'owner' && <th class="text-right">Aksi</th>}
        </tr>
      </thead>
      <tbody>
        {
          daftar.data.map((p) => {
            // Ditulis terbalik (batas >= stok), bukan `stok <= batas`:
            // parser Astro membaca `<=` di dalam ekspresi template
            // sebagai awal tag Fragment dan menolak berkas ini.
            const menipis = p.low_stock_threshold >= p.stock_qty;
            return (
              <tr>
                <td class="whitespace-nowrap text-xs text-[var(--color-teks-lembut)]">
                  {p.sku ?? '—'}
                </td>
                <td class="font-medium">{p.name}</td>
                <td class="text-[var(--color-teks-lembut)]">{p.category_name ?? '—'}</td>
                <td class="sel-angka">{rupiah(p.price)}</td>
                <td class="sel-angka">
                  {/* Stok menipis diwarnai merah bahaya, bukan merah merek:
                      ini peringatan, bukan penanda merek. */}
                  <span class={menipis ? 'font-semibold text-red-600' : ''}>{p.stock_qty}</span>
                  {p.unit && <span class="ml-1 text-xs text-[var(--color-teks-samar)]">{p.unit}</span>}
                </td>
                <td>
                  <span class={p.is_active ? 'lencana-selesai' : 'lencana-nonaktif'}>
                    {p.is_active ? 'Aktif' : 'Nonaktif'}
                  </span>
                </td>
                {user.role === 'owner' && (
                  <td class="text-right">
                    <form method="POST" class="inline">
                      <input type="hidden" name="aksi" value="aktif" />
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="is_active" value={p.is_active ? '0' : '1'} />
                      <button class="aksi-baris" type="submit">
                        {p.is_active ? 'Nonaktifkan' : 'Aktifkan'}
                      </button>
                    </form>
                  </td>
                )}
              </tr>
            );
          })
        }
        {
          daftar.data.length === 0 && (
            <tr>
              <td colspan="7" class="py-12 text-center text-[var(--color-teks-lembut)]">
                {cari ? `Tidak ada produk yang cocok dengan "${cari}".` : 'Belum ada produk.'}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="text-[var(--color-teks-lembut)]">
      Menampilkan <span class="tabular-nums">{dari}–{sampai}</span> dari
      <span class="tabular-nums"> {daftar.total}</span> produk
    </p>

    {
      halamanTerakhir > 1 && (
        <div class="flex items-center gap-2">
          {daftar.page > 1 ? (
            <a class="tombol-halus" href={tautanHalaman(daftar.page - 1)}>
              ← Sebelumnya
            </a>
          ) : (
            <span class="tombol-halus opacity-40">← Sebelumnya</span>
          )}

          <span class="px-2 tabular-nums text-[var(--color-teks-lembut)]">
            {daftar.page} / {halamanTerakhir}
          </span>

          {daftar.page < halamanTerakhir ? (
            <a class="tombol-halus" href={tautanHalaman(daftar.page + 1)}>
              Berikutnya →
            </a>
          ) : (
            <span class="tombol-halus opacity-40">Berikutnya →</span>
          )}
        </div>
      )
    }
  </div>
</AppShell>
