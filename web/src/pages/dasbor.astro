---
import AppShell from '../layouts/AppShell.astro';
import Peringatan from '../components/Peringatan.astro';
import { api, type Dashboard } from '../lib/api';
import { hitungTren, kg, labelTren, rupiah, waktu } from '../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

const data = await api<Dashboard>('/dashboard', { token });

/** Nama yang ditampilkan untuk satu penjualan. */
const JENIS: Record<string, string> = {
  walk_in: 'Pembeli langsung',
  pre_order: 'Pre-order',
};
---

<AppShell judul="Dasbor" user={user}>
  {/* Ikon, kartu pertama yang disorot, dan pil naik/turun sama dengan kartu Laporan agar satu sistem; Produk Aktif dan Stok Menipis tanpa pil karena cacahan keadaan sekarang. */}
  <div class="ringkasan mb-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    <div class="kartu-angka bg-merah-600 text-white">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/15">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 6v12m3-8.5c0-1.38-1.34-2.5-3-2.5s-3 1.12-3 2.5 1.34 2.5 3 2.5 3 1.12 3 2.5-1.34 2.5-3 2.5-3-1.12-3-2.5" />
          </svg>
        </span>
        {hitungTren(data.today_revenue, data.yesterday_revenue) && (
          <span class={`lencana-${hitungTren(data.today_revenue, data.yesterday_revenue)!.arah}`}>
            {labelTren(hitungTren(data.today_revenue, data.yesterday_revenue))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label !text-white/80">Omzet Hari Ini</span>
      <span class="kartu-angka-nilai">{rupiah(data.today_revenue)}</span>
      <span class="kartu-angka-bantu !text-white/70">
        vs kemarin {rupiah(data.yesterday_revenue)}
      </span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.518l2.74-1.22M21.75 6.75l-5.94 2.28 2.28 5.94" />
          </svg>
        </span>
        {hitungTren(data.month_revenue, data.last_month_revenue) && (
          <span class={`lencana-${hitungTren(data.month_revenue, data.last_month_revenue)!.arah}`}>
            {labelTren(hitungTren(data.month_revenue, data.last_month_revenue))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Omzet Bulan Ini</span>
      <span class="kartu-angka-nilai">{rupiah(data.month_revenue)}</span>
      <span class="kartu-angka-bantu">
        <a class="-my-3 inline-block py-3 hover:underline" href="/laporan">Lihat laporan lengkap →</a>
      </span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
          </svg>
        </span>
      </div>
      <span class="kartu-angka-label">Produk Aktif</span>
      <span class="kartu-angka-nilai">{data.product_count}</span>
      <span class="kartu-angka-bantu">{data.customer_count} pelanggan tercatat</span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </span>
      </div>
      <span class="kartu-angka-label">Stok Menipis</span>
      {/* Nol bukan peringatan, jadi tidak diwarnai merah. */}
      <span class={data.low_stock_count > 0 ? 'kartu-angka-nilai text-red-600' : 'kartu-angka-nilai'}>
        {data.low_stock_count}
      </span>
      <span class="kartu-angka-bantu">produk di bawah ambangnya</span>
    </div>

    {/* Potret stok hari ini, bukan angka periode, jadi tanpa pil naik/turun. */}
    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125l2.25 2.25m0 0l2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
        </span>
      </div>
      <span class="kartu-angka-label">Nilai Stok</span>
      <span class="kartu-angka-nilai">{rupiah(data.stock_value.value)}</span>
      <span class="kartu-angka-bantu">Sisa stok × harga beli, per hari ini</span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18M5.5 7h13M5.5 7l-2.5 6a3 3 0 005 0L5.5 7zM18.5 7l-2.5 6a3 3 0 005 0l-2.5-6zM8 21h8" />
          </svg>
        </span>
      </div>
      <span class="kartu-angka-label">Total Stok</span>
      <span class="kartu-angka-nilai">{kg(data.stock_value.total_kg)}</span>
      <span class="kartu-angka-bantu">
        {data.stock_value.packs_without_size > 0
          ? `Belum termasuk ${data.stock_value.packs_without_size} pack tanpa ukuran`
          : 'Sisa pack × ukuran, per hari ini'}
      </span>
    </div>
  </div>

  {
    data.stock_value.packs_without_size > 0 && (
      <Peringatan class="mb-6">
        {data.stock_value.packs_without_size} pack stok belum diketahui ukurannya, jadi tidak ikut
        <strong> total stok dalam kg</strong>. Isi ukuran (kg per pack) di halaman produk.
      </Peringatan>
    )
  }

  {
    data.stock_value.batches_without_cost > 0 && (
      <Peringatan class="mb-6">
        {data.stock_value.batches_without_cost} batch yang masih ada stoknya belum punya harga beli.
        Selama itu, <strong>nilai stok di atas terlalu kecil</strong>. Isi harga beli batch di
        halaman produk.
      </Peringatan>
    )
  }

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="kartu-rapat">
      <h2 class="border-b border-[var(--color-garis)] px-5 py-4 text-base font-bold">
        Penjualan Terakhir
      </h2>

      {
        data.recent_sales.length === 0 ? (
          <p class="px-5 py-12 text-center text-sm text-[var(--color-teks-lembut)]">
            Belum ada penjualan. Mulai dari <a class="font-medium hover:underline" href="/kasir">halaman kasir</a>.
          </p>
        ) : (
          <ul>
            {data.recent_sales.map((s) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-[var(--color-garis-lembut)] px-5 py-3 last:border-b-0">
                <span class="min-w-0">
                  <span class="block truncate text-sm">
                    {s.customer_name ?? JENIS[s.type] ?? s.type}
                  </span>
                  <span class="block text-xs text-[var(--color-teks-lembut)]">
                    {waktu(s.created_at)} · {s.item_count} item
                  </span>
                </span>
                <span class="shrink-0 text-sm font-semibold tabular-nums">
                  {rupiah(s.revenue)}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="kartu-rapat">
      <h2 class="border-b border-[var(--color-garis)] px-5 py-4 text-base font-bold">
        Peringatan Stok Menipis
      </h2>

      {
        data.low_stock_products.length === 0 ? (
          <p class="px-5 py-12 text-center text-sm text-[var(--color-teks-lembut)]">
            Tidak ada peringatan. Produk yang stoknya menyentuh ambang muncul di sini.
          </p>
        ) : (
          <ul>
            {data.low_stock_products.map((p) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-[var(--color-garis-lembut)] px-5 py-3 last:border-b-0">
                <span class="min-w-0">
                  <a class="-my-3 block truncate py-3 text-sm font-medium hover:underline" href={`/produk/${p.id}`}>
                    {p.name}
                  </a>
                  <span class="block text-xs text-[var(--color-teks-samar)]">{p.sku ?? '—'}</span>
                </span>
                <span class="shrink-0 text-sm font-semibold tabular-nums text-red-600">
                  {p.stock_qty} / {p.low_stock_threshold}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AppShell>
