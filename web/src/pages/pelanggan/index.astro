---
import AppShell from '../../layouts/AppShell.astro';
import { api, ApiRequestError, type PaginatedCustomers } from '../../lib/api';
import { rupiah, waktu } from '../../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

let galat: string | null = null;
let sukses: string | null = null;

// Pelanggan baru ditambahkan lewat form biasa. Tidak ada JavaScript yang
// terlibat: browser mengirim POST, server merender ulang halaman dengan
// hasilnya -- pola yang sama dengan halaman produk.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const aksi = String(form.get('aksi') ?? '');

  if (aksi === 'tambah') {
    const nama = String(form.get('name') ?? '').trim();
    try {
      const baru = await api<{ name: string | null }>('/customers', {
        method: 'POST',
        token,
        body: {
          name: nama,
          phone: String(form.get('phone') ?? '').trim() || undefined,
          address: String(form.get('address') ?? '').trim() || undefined,
        },
      });
      sukses = `Pelanggan "${baru.name ?? nama}" tersimpan.`;
    } catch (err) {
      galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan pelanggan.';
    }
  } else if (aksi === 'hapus') {
    // Backend menolak menghapus pelanggan yang masih punya riwayat, dan
    // pesannya sudah ditulis untuk dibaca manusia -- diteruskan apa adanya.
    try {
      await api(`/customers/${String(form.get('id') ?? '')}`, { method: 'DELETE', token });
      sukses = 'Pelanggan dihapus.';
    } catch (err) {
      galat = err instanceof ApiRequestError ? err.message : 'Gagal menghapus pelanggan.';
    }
  }
}

const params = Astro.url.searchParams;
const cari = params.get('cari')?.trim() ?? '';
const SARINGAN = ['belanja', 'walk_in', 'marketplace'];
const saring = SARINGAN.includes(params.get('saring') ?? '') ? params.get('saring')! : '';
const URUT = ['nama', 'belanja', 'terbaru'];
const urut = URUT.includes(params.get('urut') ?? '') ? params.get('urut')! : 'nama';
const PER_HALAMAN = [25, 50, 100];
const limit = PER_HALAMAN.includes(Number(params.get('per'))) ? Number(params.get('per')) : 25;
const halaman = Math.max(1, Number(params.get('halaman')) || 1);

const kueri = new URLSearchParams({ limit: String(limit), page: String(halaman), sort: urut });
if (cari) kueri.set('search', cari);
if (saring) kueri.set('scope', saring);

const daftar = await api<PaginatedCustomers>(`/customers?${kueri}`, { token });

const halamanTerakhir = Math.max(1, Math.ceil(daftar.total / daftar.limit));
const dari = daftar.total === 0 ? 0 : (daftar.page - 1) * daftar.limit + 1;
const sampai = Math.min(daftar.page * daftar.limit, daftar.total);

/** Tautan halaman lain dengan seluruh saringan yang sedang aktif tetap terbawa. */
function tautanHalaman(ke: number): string {
  const p = new URLSearchParams();
  if (cari) p.set('cari', cari);
  if (saring) p.set('saring', saring);
  if (urut !== 'nama') p.set('urut', urut);
  if (limit !== 25) p.set('per', String(limit));
  if (ke !== 1) p.set('halaman', String(ke));
  const q = p.toString();
  return q ? `/pelanggan?${q}` : '/pelanggan';
}

// Angka kartu dihitung dari halaman yang sedang tampil, jadi sengaja hanya
// disebut sebagai ringkasan halaman ini -- menuliskannya sebagai "total
// seluruh pelanggan" akan berbohong begitu daftarnya berpindah halaman.
const belanjaHalaman = daftar.data.reduce((j, c) => j + c.total_spent, 0);
const pernahBelanja = daftar.data.filter((c) => c.purchase_count > 0).length;
const rataRata = pernahBelanja > 0 ? belanjaHalaman / pernahBelanja : 0;

const ASAL: Record<string, string> = {
  walk_in: 'Toko',
  marketplace: 'Marketplace',
};
---

<AppShell judul="Pelanggan" user={user}>
  {galat && <p class="galat mb-4" role="alert">{galat}</p>}
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  <div class="mb-5 grid gap-4 sm:grid-cols-3">
    <div class="kartu-angka">
      <span class="kartu-angka-label">Pelanggan Tercatat</span>
      <span class="kartu-angka-nilai">{daftar.total}</span>
      <span class="kartu-angka-bantu">cocok dengan saringan saat ini</span>
    </div>
    <div class="kartu-angka">
      <span class="kartu-angka-label">Belanja di Halaman Ini</span>
      <span class="kartu-angka-nilai">{rupiah(belanjaHalaman)}</span>
      <span class="kartu-angka-bantu">{pernahBelanja} pelanggan pernah belanja</span>
    </div>
    <div class="kartu-angka">
      <span class="kartu-angka-label">Rata-rata per Pelanggan</span>
      <span class="kartu-angka-nilai">{rupiah(rataRata)}</span>
      <span class="kartu-angka-bantu">dari yang pernah belanja saja</span>
    </div>
  </div>

  {/* Form tambah dilipat dalam <details>: yang dibuka orang di halaman ini
      hampir selalu daftarnya, bukan form isian. <details> bekerja tanpa
      JavaScript, jadi melipatnya tidak menukar satu fitur dengan fitur lain. */}
  <details class="kartu mb-5">
    <summary class="cursor-pointer text-sm font-semibold">+ Tambah Pelanggan</summary>

    <form method="POST" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_12rem_1fr_8rem]">
      <input type="hidden" name="aksi" value="tambah" />

      <div>
        <label class="label" for="name">Nama</label>
        <input class="kolom" id="name" name="name" required maxlength="150" />
      </div>

      <div>
        <label class="label" for="phone">Telepon</label>
        <input class="kolom" id="phone" name="phone" type="tel" maxlength="30" />
        <p class="isian-bantu">
          Nomor yang sudah terdaftar dipakai ulang, tidak membuat baris baru.
        </p>
      </div>

      <div>
        <label class="label" for="address">Alamat Antar</label>
        <input class="kolom" id="address" name="address" maxlength="500" />
      </div>

      <div class="flex items-start">
        <button class="tombol-utama mt-6" type="submit">Simpan</button>
      </div>
    </form>
  </details>

  {/* Saringan dikirim sebagai GET biasa, jadi keadaan daftar selalu ada di
      URL -- bisa di-bookmark, dibagikan, dan tombol kembali bekerja. */}
  <form method="GET" class="kartu mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_12rem_12rem_7rem_7rem]">
    <div>
      <label class="label" for="cari">Cari</label>
      <input
        class="kolom"
        id="cari"
        type="search"
        name="cari"
        value={cari}
        placeholder="Cari nama atau nomor telepon..."
      />
    </div>

    <div>
      <label class="label" for="saring">Tampilkan</label>
      <select class="kolom" id="saring" name="saring">
        <option value="" selected={!saring}>Semua Pelanggan</option>
        <option value="belanja" selected={saring === 'belanja'}>Pernah Belanja</option>
        <option value="walk_in" selected={saring === 'walk_in'}>Dari Toko</option>
        <option value="marketplace" selected={saring === 'marketplace'}>Dari Marketplace</option>
      </select>
    </div>

    <div>
      <label class="label" for="urut">Urutkan</label>
      <select class="kolom" id="urut" name="urut">
        <option value="nama" selected={urut === 'nama'}>Nama</option>
        <option value="belanja" selected={urut === 'belanja'}>Belanja Terbesar</option>
        <option value="terbaru" selected={urut === 'terbaru'}>Terbaru Dicatat</option>
      </select>
    </div>

    <div>
      <label class="label" for="per">Per Halaman</label>
      <select class="kolom" id="per" name="per">
        {PER_HALAMAN.map((n) => (
          <option value={n} selected={limit === n}>
            {n}
          </option>
        ))}
      </select>
    </div>

    <div class="flex items-start">
      <button class="tombol-halus mt-6" type="submit">Terapkan</button>
    </div>
  </form>

  <div class="kartu-rapat overflow-x-auto">
    <table class="tabel">
      <thead>
        <tr>
          <th>Nama</th>
          <th>Telepon</th>
          <th>Alamat</th>
          <th>Asal</th>
          <th class="text-right">Belanja</th>
          <th class="text-right">Total</th>
          <th>Terakhir</th>
          {user.role === 'owner' && <th class="text-right">Aksi</th>}
        </tr>
      </thead>
      <tbody>
        {
          daftar.data.map((c) => (
            <tr>
              <td>
                <a class="font-medium hover:underline" href={`/pelanggan/${c.id}`}>
                  {c.name ?? 'Tanpa nama'}
                </a>
              </td>
              <td class="whitespace-nowrap text-[var(--color-teks-lembut)]">{c.phone ?? '—'}</td>
              <td class="max-w-[16rem] truncate text-xs text-[var(--color-teks-lembut)]">
                {c.address ?? '—'}
              </td>
              <td>
                <span class={c.source === 'marketplace' ? 'lencana-berjalan' : 'lencana-nonaktif'}>
                  {ASAL[c.source] ?? c.source}
                </span>
              </td>
              <td class="sel-angka">{c.purchase_count}</td>
              <td class="sel-angka">{rupiah(c.total_spent)}</td>
              <td class="whitespace-nowrap text-xs text-[var(--color-teks-lembut)]">
                {c.last_purchase_at ? waktu(c.last_purchase_at) : '—'}
              </td>
              {user.role === 'owner' && (
                <td class="whitespace-nowrap text-right">
                  <a class="aksi-baris" href={`/pelanggan/${c.id}`}>Kelola</a>
                  {/* Hanya untuk yang belum punya riwayat. Yang sudah punya
                      ditolak backend dengan alasannya, dan tombolnya memang
                      tidak ditampilkan supaya tidak menjanjikan apa pun. */}
                  {c.purchase_count === 0 && (
                    <form method="POST" class="inline">
                      <input type="hidden" name="aksi" value="hapus" />
                      <input type="hidden" name="id" value={c.id} />
                      <button class="aksi-baris" type="submit">Hapus</button>
                    </form>
                  )}
                </td>
              )}
            </tr>
          ))
        }
        {
          daftar.data.length === 0 && (
            <tr>
              <td colspan="8" class="py-12 text-center text-[var(--color-teks-lembut)]">
                {cari
                  ? `Tidak ada pelanggan yang cocok dengan "${cari}".`
                  : 'Belum ada pelanggan tercatat.'}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="text-[var(--color-teks-lembut)]">
      Menampilkan <span class="tabular-nums">{dari}–{sampai}</span> dari
      <span class="tabular-nums"> {daftar.total}</span> pelanggan
    </p>

    {
      halamanTerakhir > 1 && (
        <div class="flex items-center gap-2">
          {daftar.page > 1 ? (
            <a class="tombol-halus" href={tautanHalaman(daftar.page - 1)}>
              ← Sebelumnya
            </a>
          ) : (
            <span class="tombol-halus opacity-40">← Sebelumnya</span>
          )}

          <span class="px-2 tabular-nums text-[var(--color-teks-lembut)]">
            {daftar.page} / {halamanTerakhir}
          </span>

          {daftar.page < halamanTerakhir ? (
            <a class="tombol-halus" href={tautanHalaman(daftar.page + 1)}>
              Berikutnya →
            </a>
          ) : (
            <span class="tombol-halus opacity-40">Berikutnya →</span>
          )}
        </div>
      )
    }
  </div>
</AppShell>
