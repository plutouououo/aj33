---
/**
 * Ganti password sendiri.
 *
 * Ada dua cara sampai ke sini, dan halamannya sama untuk keduanya: pengguna
 * yang sengaja membukanya, dan pengguna berpassword sementara yang
 * dipantulkan middleware ke sini dari halaman mana pun. Yang membedakan
 * hanya kalimat pembukanya -- alur, aturan, dan penegakannya satu.
 */
import AppShell from '../layouts/AppShell.astro';
import { api, ApiRequestError, type User } from '../lib/api';
import { berandaUntuk } from '../lib/session';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

/** Sama dengan `PANJANG_MINIMUM` di backend. Backend yang menegakkan. */
const PANJANG_MINIMUM = 8;

let galat: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const lama = String(form.get('current_password') ?? '');
  const baru = String(form.get('new_password') ?? '');
  const ulangi = String(form.get('confirm_password') ?? '');

  if (!lama || !baru) {
    galat = 'Password lama dan password baru wajib diisi.';
  } else if (baru !== ulangi) {
    // Diperiksa di sini, bukan di backend: backend tidak perlu tahu soal
    // kolom ulangi sama sekali -- itu bantuan pengetikan, bukan aturan akun.
    galat = 'Ulangi password tidak sama dengan password baru.';
  } else {
    try {
      await api<User>('/auth/password', {
        method: 'POST',
        token,
        body: { current_password: lama, new_password: baru },
      });

      // Beranda, bukan halaman ini lagi: `must_change_password` sudah mati,
      // jadi middleware tidak akan memantulkannya kembali ke sini.
      return Astro.redirect(berandaUntuk(user.role), 302);
    } catch (err) {
      galat =
        err instanceof ApiRequestError ? err.message : 'Gagal mengganti password.';
    }
  }
}

const wajib = user.must_change_password;
---

<AppShell judul="Ganti Password" user={user}>
  <div class="mx-auto max-w-sm">
    {
      wajib && (
        <p class="galat mb-4" role="alert">
          Password akun ini masih password sementara yang dibuatkan pemilik toko.
          Ganti dulu sebelum memakai aplikasi.
        </p>
      )
    }

    <form method="POST" class="kartu space-y-4">
      {galat && <p class="galat" role="alert">{galat}</p>}

      <div>
        <label class="label" for="lama">Password sekarang</label>
        <input
          class="kolom"
          id="lama"
          name="current_password"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />
      </div>

      <div>
        <label class="label" for="baru">Password baru</label>
        <input
          class="kolom"
          id="baru"
          name="new_password"
          type="password"
          autocomplete="new-password"
          minlength={PANJANG_MINIMUM}
          required
        />
        <p class="isian-bantu">Minimal {PANJANG_MINIMUM} karakter, dan berbeda dari password sekarang.</p>
      </div>

      <div>
        <label class="label" for="ulangi">Ulangi password baru</label>
        <input
          class="kolom"
          id="ulangi"
          name="confirm_password"
          type="password"
          autocomplete="new-password"
          minlength={PANJANG_MINIMUM}
          required
        />
      </div>

      <button class="tombol-utama w-full" type="submit">Simpan password baru</button>
    </form>

    {
      !wajib && (
        <p class="mt-4 text-center text-sm">
          <a class="font-medium hover:underline" href={berandaUntuk(user.role)}>
            Kembali
          </a>
        </p>
      )
    }
  </div>
</AppShell>
