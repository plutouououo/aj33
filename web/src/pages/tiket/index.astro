---
import AppShell from '../../layouts/AppShell.astro';
import { api, type Ticket } from '../../lib/api';
import { waktu } from '../../lib/format';
import { kunciPublikVapid } from '../../lib/push';
import { LABEL_STATUS, URUTAN_STATUS, kelasLencana } from '../../lib/tiket';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

const params = Astro.url.searchParams;
const status = params.get('status') ?? '';

// Bawaan beda per peran (pengepak "pekerjaanku", owner seluruh antrean); nilainya selalu terkirim lewat `<select>` agar "semua" tak jatuh ke bawaan.
const punyaku = params.has('punyaku') ? params.get('punyaku') === '1' : user.role === 'pengepak';

const kueri = new URLSearchParams();
if (status) kueri.set('status', status);
if (punyaku) kueri.set('mine', 'true');
const terkirim = kueri.toString();

const daftar = await api<Ticket[]>(`/tickets${terkirim ? `?${terkirim}` : ''}`, { token });
const kunciVapid = kunciPublikVapid();
const sekarang = Date.now();
---

<AppShell judul="Tiket" user={user}>
  {/* Langganan push butuh JavaScript; tanpa JS atau tanpa dukungan browser bagian ini tetap tersembunyi dan halaman bekerja seperti biasa. */}
  {
    kunciVapid && (
      <div class="kartu mb-5 flex flex-wrap items-center justify-between gap-3" data-notifikasi={kunciVapid} hidden>
        <p class="text-sm" data-notifikasi-teks>
          Nyalakan notifikasi agar perangkat ini berbunyi saat ada tiket baru.
        </p>
        <button class="tombol-utama" type="button" data-notifikasi-tombol>
          Aktifkan notifikasi
        </button>
      </div>
    )
  }

  <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
    <p class="text-sm text-[var(--color-teks-lembut)]">
      {daftar.length} tiket · yang paling mendesak di atas
    </p>

    <form method="GET" class="grid w-full grid-cols-2 gap-2 md:flex md:w-auto">
      <select class="kolom md:w-44" name="punyaku" aria-label="Cakupan tiket">
        <option value="1" selected={punyaku}>Tiket saya</option>
        <option value="0" selected={!punyaku}>Semua tiket</option>
      </select>

      <select class="kolom md:w-44" name="status" aria-label="Saring status">
        <option value="" selected={!status}>Semua status</option>
        {
          URUTAN_STATUS.map((s) => (
            <option value={s} selected={status === s}>
              {LABEL_STATUS[s]}
            </option>
          ))
        }
      </select>

      <button class="tombol-halus col-span-2" type="submit">Saring</button>
    </form>
  </div>

  <section class="kartu-rapat overflow-x-auto">
    <table class="tabel tabel-kartu">
      <thead>
        <tr>
          <th>Pesanan</th>
          <th>Platform</th>
          <th>Tenggat</th>
          <th>Status</th>
          <th>Pengepak</th>
          <th><span class="sr-only">Aksi</span></th>
        </tr>
      </thead>
      <tbody>
        {
          daftar.map((t) => {
            const dikemas = t.items.filter((it) => it.is_packed).length;
            // Tenggat lewat hanya jadi peringatan selama tiket belum diserahkan; sesudah itu merah hanya kebisingan.
            const telat =
              t.sla_deadline !== null &&
              t.status !== 'handed_over' &&
              new Date(t.sla_deadline).getTime() < sekarang;

            return (
              <tr class="max-md:relative">
                <td data-judul>
                  {/* Di ponsel `::after` tautan menutupi seluruh kartu sehingga kartu mana pun bisa disentuh untuk membuka tiket, tanpa JS. */}
                  <a
                    class="font-medium text-merah-700 hover:underline max-md:after:absolute max-md:after:inset-0"
                    href={`/tiket/${t.id}`}
                  >
                    {t.order_ref}
                  </a>
                  <p class="text-xs font-normal text-[var(--color-teks-lembut)]">
                    {dikemas}/{t.items.length} barang dikemas
                  </p>
                </td>
                <td data-label="Platform" class="text-[var(--color-teks-lembut)]">{t.platform_name}</td>
                <td data-label="Tenggat" class="whitespace-nowrap">
                  {t.sla_deadline ? (
                    <span class:list={['tabular-nums', telat ? 'font-semibold text-red-700' : 'text-stone-600']}>
                      {waktu(t.sla_deadline)}
                      {telat && ' · lewat'}
                    </span>
                  ) : (
                    <span class="text-stone-400">—</span>
                  )}
                </td>
                <td data-label="Status">
                  <span class={kelasLencana(t.status)}>{LABEL_STATUS[t.status]}</span>
                </td>
                <td data-label="Pengepak" class="text-[var(--color-teks-lembut)]">{t.assigned_to_name ?? '—'}</td>
                <td class="text-right max-md:hidden">
                  <a class="tombol-halus" href={`/tiket/${t.id}`}>Buka</a>
                </td>
              </tr>
            );
          })
        }
        {
          daftar.length === 0 && (
            <tr>
              <td colspan="6" class="py-12 text-center text-[var(--color-teks-lembut)]">
                {punyaku
                  ? 'Belum ada tiket yang ditugaskan ke kamu. Pilih "Semua tiket" untuk melihat antrean.'
                  : 'Belum ada tiket packing.'}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </section>
</AppShell>

<script>
  /** Kunci VAPID (base64url) diubah ke byte, bentuk yang diminta `pushManager.subscribe`. */
  function keByte(kunci: string): Uint8Array<ArrayBuffer> {
    const b64 = (kunci + '='.repeat((4 - (kunci.length % 4)) % 4)).replace(/-/g, '+').replace(/_/g, '/');
    return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
  }

  async function simpan(langganan: PushSubscription): Promise<boolean> {
    const res = await fetch('/notifikasi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(langganan),
    });
    return res.ok;
  }

  async function siapkan(): Promise<void> {
    const wadah = document.querySelector<HTMLElement>('[data-notifikasi]');
    if (!wadah || !('serviceWorker' in navigator) || !('PushManager' in window)) return;

    const tombol = wadah.querySelector<HTMLButtonElement>('[data-notifikasi-tombol]')!;
    const teks = wadah.querySelector<HTMLElement>('[data-notifikasi-teks]')!;
    const reg = await navigator.serviceWorker.ready;
    const ada = await reg.pushManager.getSubscription();

    // Perangkat yang sudah berlangganan dikirim ulang agar terikat ke akun yang sedang login (perangkat bisa berganti akun).
    if (ada && Notification.permission === 'granted') {
      await simpan(ada);
      return;
    }

    wadah.hidden = false;
    tombol.addEventListener('click', async () => {
      tombol.disabled = true;
      try {
        if ((await Notification.requestPermission()) !== 'granted') {
          teks.textContent = 'Izin notifikasi ditolak. Buka pengaturan situs di browser untuk mengizinkannya.';
          return;
        }
        const langganan = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: keByte(wadah.dataset.notifikasi!),
        });
        if (await simpan(langganan)) wadah.hidden = true;
        else teks.textContent = 'Notifikasi gagal diaktifkan. Coba lagi.';
      } catch {
        teks.textContent = 'Browser ini tidak mendukung notifikasi. Di iPhone, tambahkan aplikasi ke Layar Utama dulu.';
      } finally {
        tombol.disabled = false;
      }
    });
  }

  siapkan();
</script>
