---
import AppShell from '../layouts/AppShell.astro';
import {
  api,
  ApiRequestError,
  type Category,
  type Customer,
  type PaginatedCustomers,
  type PaginatedProducts,
  type Product,
  type ProductBatch,
  type Transaction,
} from '../lib/api';
import { rupiah, sisaHari, tanggal, waktu } from '../lib/format';

/**
 * Kanal tempat penjualan dicatat, dan karena itu daftar harga yang berlaku.
 *
 * Shopee dan Tokopedia belum tersambung ke sistem ini, jadi pesanan dari sana
 * dicatat manual lewat layar ini. Tanpa pilihan kanal, semuanya tercatat
 * seharga toko -- dan selisih harga marketplace muncul di laporan sebagai laba
 * yang tidak pernah ada.
 *
 * Yang benar-benar menetapkan harga tetap backend: ia membaca harga kanal dari
 * baris produk yang dikunci saat checkout. Daftar ini hanya menentukan angka
 * yang diperlihatkan ke kasir sebelum itu.
 */
const KANAL = [
  { nilai: 'toko', label: 'Toko', kolom: null },
  { nilai: 'shopee', label: 'Shopee', kolom: 'price_shopee' },
  { nilai: 'tiktok', label: 'Tokopedia / TikTok', kolom: 'price_tiktok' },
] as const;

type Kanal = (typeof KANAL)[number]['nilai'];

/**
 * Biaya platform Shopee atas SATU transaksi, empat komponen yang jumlahnya
 * sama persis dengan `platform_commission_fee + platform_service_fee +
 * platform_withholding_tax + platform_order_processing_fee` yang backend
 * hitung dan simpan saat checkout (`backend/src/pos/service.rs`, migrasi
 * 0017/0018). Nama field SENGAJA mengikuti field asli
 * `v2.payment.get_escrow_detail` milik Shopee, bukan istilah rakitan
 * sendiri -- lihat `backend/src/marketplace/shopee/client.rs` untuk
 * pemanggilan API-nya (belum tersambung):
 *
 * - `commission_fee`: komisi dasar, persentase dari omzet transaksi ini
 *   (subtotal - diskon). BISA DIEDIT kasir -- Shopee kadang menjalankan
 *   promo yang mengubah persennya. `SHOPEE_COMMISSION_PERSEN_DEFAULT` cuma
 *   nilai awal yang terisi di kolomnya.
 * - `service_fee`: biaya program tambahan yang OPSIONAL (mis. Gratis Ongkir
 *   Xtra, Star+). BISA DIEDIT juga, defaultnya NOL -- kita tidak tahu toko
 *   ini ikut program berbayar yang mana.
 * - `withholding_tax`: PPh final UMKM, 0,5% dari omzet yang sama. Tetap,
 *   tidak bisa diedit.
 * - `seller_order_processing_fee`: Rp1.250 tetap, SEKALI per pesanan
 *   Shopee.
 *
 * Ongkir TIDAK ikut basis maupun total Shopee sama sekali -- logistiknya di
 * luar sistem ini, kolom "Ongkos kirim" disembunyikan untuk kanal ini.
 *
 * Dihitung ulang di sini (bukan dibaca dari backend) supaya kasir melihat
 * potongannya SEBELUM transaksi disimpan. Berbeda dari sebelumnya: kanal
 * Shopee di kasir ini cuma untuk MENCATAT pesanan yang uangnya sudah
 * diterima lewat ShopeePay, jadi keempatnya benar-benar MENGURANGI angka
 * yang dicatat -- bukan cuma baris informasi di sebelah Total.
 */
const SHOPEE_COMMISSION_PERSEN_DEFAULT = 17.25;
const SHOPEE_SERVICE_PERSEN_DEFAULT = 0;
const SHOPEE_WITHHOLDING_TAX_PERSEN = 0.5;
const SHOPEE_ORDER_PROCESSING_FEE = 1250;

/**
 * `basis` (SELALU rupiah bulat -- harga barang di sistem ini tidak pernah
 * pecahan) dikali `persen`, dibulatkan ke rupiah terdekat.
 *
 * Sengaja BUKAN `Math.round(basis * (persen / 100))`: pembagian itu lewat
 * floating point, dan `0,1725` (17,25%) tidak punya representasi biner yang
 * pas -- `45000 * 0.1725` bisa jadi `7762.499999999999` alih-alih
 * `7762.5`, lalu dibulatkan TURUN persis di titik yang seharusnya naik.
 * Sebaliknya, `basis * basisPoin` mengalikan DUA BILANGAN BULAT (basisPoin =
 * persen dalam satuan 1/10.000, presisi yang sama dengan kolom
 * `platform_commission_fee_percent`/`platform_service_fee_percent` di
 * migrasi 0018), jadi hasilnya eksak sampai langkah pembulatan terakhir --
 * sama persis dengan `rupiah_bulat` di `backend/src/pos/service.rs`, yang
 * juga membulatkan ,50 ke ATAS. Kalau dua tempat ini pernah berbeda arah
 * pembulatannya, kasir melihat satu angka di layar dan struknya mencatat
 * angka lain.
 */
function biayaPersenRupiah(basis: number, persen: number): number {
  const basisPoin = Math.round(persen * 100);
  return Math.round((basis * basisPoin) / 10000);
}

/**
 * Harga sebuah produk di satu kanal.
 *
 * Harga kanal yang belum diatur (`null`) JATUH KE HARGA DASAR, bukan ke nol --
 * sama persis dengan aturan di backend (`SalesChannel::harga`). Kalau kedua
 * tempat ini berbeda, angka di layar kasir tidak sama dengan angka di struk.
 */
function hargaDi(p: Product, kanal: Kanal): number {
  if (kanal === 'shopee') return p.price_shopee ?? p.price;
  if (kanal === 'tiktok') return p.price_tiktok ?? p.price;
  return p.price;
}

const user = Astro.locals.user!;
const token = Astro.locals.token!;

/**
 * Pengepak membuka halaman ini untuk MEMBACA detail produk -- ukuran, harga,
 * rak, dan sisa tiap batch -- bukan untuk menjual. Seluruh kendali transaksi
 * tidak dirender untuknya.
 *
 * Yang benar-benar menahan penjualan bukan flag ini, melainkan backend:
 * `POST /transactions` menolak peran pengepak. Flag ini hanya menjaga agar
 * layarnya tidak menawarkan sesuatu yang pasti ditolak.
 */
const bolehTransaksi = user.role !== 'pengepak';

/**
 * Satu baris keranjang: SATU BATCH dari satu produk.
 *
 * Membeli 5 butir yang fisiknya diambil dari dua kiriman berbeda menghasilkan
 * dua baris, dan itu memang yang benar -- backend menggabungkannya per
 * (produk, batch), lalu mencatat tiap batch yang keluar di ledger stok.
 *
 * `nama` dan `harga` ikut dibawa HANYA untuk ditampilkan tanpa query kedua.
 * Server tidak pernah mempercayainya: harga ditetapkan ulang dari baris produk
 * yang dikunci saat checkout, jadi mengubah nilai ini lewat DevTools paling
 * jauh membuat ringkasan di layar berbeda dari struknya.
 */
interface BarisKeranjang {
  product_id: string;
  qty: number;
  nama: string;
  harga: number;
  /**
   * Batch yang dipilih kasir. Wajib terisi: sejak kasir memilih sendiri,
   * tidak ada lagi baris yang diserahkan ke FEFO.
   */
  batch_id: string;
}

let galat: string | null = null;
let sukses: string | null = null;
let struk: Transaction | null = null;
let keranjang: BarisKeranjang[] = [];
/**
 * Pelanggan yang dipilih SAAT transaksi ini berhasil, untuk nota cetak.
 *
 * `pelangganDipilih` sendiri tidak bisa dipakai untuk itu: ia dikosongkan
 * begitu transaksi selesai (lihat di bawah), dan nota dirender setelahnya.
 * Baru diubah jadi nama sesudah daftar pelanggan selesai diambil, karena
 * daftar itu sendiri belum ada di titik transaksi berhasil.
 */
let strukPelangganId: string | null = null;

// Nilai isian pembayaran, dibaca ulang tiap POST supaya kasir tidak perlu
// mengetik ulang saat pembayaran ditolak.
let pelangganDipilih = '';
let metode = 'cash';
let kanalIsi: Kanal = 'toko';
let ongkirIsi = '';
let diskonIsi = '';
let dibayarIsi = '';
let cariIsi = '';
let kategoriIsi = '';
// Persen commission_fee/service_fee Shopee. Beda dari `ongkirIsi`/
// `diskonIsi`: keduanya tidak direset ke kosong setiap transaksi selesai --
// pesanan Shopee berikutnya biasanya memakai persen yang sama, sama seperti
// kanal yang juga sengaja tidak ikut direset. Default terisi begitu kanal
// diganti ke Shopee.
let commissionPersenIsi = String(SHOPEE_COMMISSION_PERSEN_DEFAULT);
let servicePersenIsi = String(SHOPEE_SERVICE_PERSEN_DEFAULT);

/**
 * Keranjang dibaca dari pasangan field berulang: lima deret sejajar yang
 * panjangnya harus sama persis. Tiap baris batch -- di katalog maupun di
 * panel keranjang -- merender kelimanya sekaligus, jadi deretnya tidak bisa
 * bergeser satu sama lain.
 */
function bacaKeranjang(form: FormData): BarisKeranjang[] {
  const ids = form.getAll('product_id');
  const qty = form.getAll('qty');
  const nama = form.getAll('nama');
  const harga = form.getAll('harga');
  const batch = form.getAll('batch_id');

  return (
    ids
      .map((id, i) => ({
        product_id: String(id),
        qty: Number(qty[i] ?? 0),
        nama: String(nama[i] ?? ''),
        harga: Number(harga[i] ?? 0),
        batch_id: String(batch[i] ?? ''),
      }))
      // Baris tanpa batch dibuang, bukan dikirim sebagai "terserah FEFO".
      // Halaman ini selalu merender `batch_id` bersama `qty`-nya, jadi baris
      // begitu hanya bisa datang dari request rakitan -- dan menerimanya
      // berarti mengeluarkan barang dari kiriman yang tidak pernah dipilih
      // siapa pun.
      .filter((b) => Number.isFinite(b.qty) && b.qty > 0 && b.batch_id !== '')
  );
}

/**
 * Kunci idempotensi. Dibuat sekali saat halaman dibuka dan DIBACA ULANG dari
 * form di tiap POST -- tidak pernah dibuat ulang selama transaksi yang sama
 * masih berjalan. Kalau dibuat ulang tiap render, penjagaan kirim-dua-kali
 * hilang.
 *
 * Satu-satunya tempat kunci diganti adalah setelah penjualan BERHASIL: layar
 * ini tidak berpindah ke mana-mana sesudahnya, dan kasir berikutnya dilayani
 * di form yang sama, jadi kuncinya harus sudah segar sebelum barang pertama
 * diketuk. Kalau pembayaran gagal, kunci lama justru dipertahankan.
 */
let kunci = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Di mode lihat-saja satu-satunya POST yang mungkin adalah tombol
  // "Terapkan" pada saringan. Apa pun yang dikirim diperlakukan sebagai itu,
  // jadi tidak ada aksi transaksi yang bisa masuk lewat request rakitan.
  const aksi = bolehTransaksi ? String(form.get('aksi') ?? '') : 'saring';

  kunci = String(form.get('idempotency_key') ?? '');
  keranjang = bacaKeranjang(form);
  cariIsi = String(form.get('cari') ?? '').trim();
  kategoriIsi = String(form.get('kategori') ?? '');
  pelangganDipilih = String(form.get('customer_id') ?? '');
  metode = String(form.get('payment_method') ?? 'cash');
  // Kanal asing diperlakukan sebagai toko, bukan diteruskan apa adanya:
  // nilainya menentukan harga, dan backend menolaknya dengan galat yang tidak
  // berarti apa-apa bagi kasir.
  const kanalDikirim = String(form.get('sales_channel') ?? '');
  kanalIsi = (KANAL.find((k) => k.nilai === kanalDikirim)?.nilai ?? 'toko') as Kanal;
  // Shopee dicatat sebagai uang yang sudah pasti diterima lewat ShopeePay --
  // bukan pilihan bebas kasir. Dipaksa di sini juga (bukan cuma di UI)
  // supaya request rakitan tidak bisa menyelundupkan kanal Shopee dengan
  // metode tunai, yang membuat "kembalian" tidak berarti apa-apa karena
  // totalnya sudah bersih dari potongan Shopee.
  if (kanalIsi === 'shopee') metode = 'ewallet';
  ongkirIsi = String(form.get('shipping_cost') ?? '').trim();
  diskonIsi = String(form.get('discount_amount') ?? '').trim();
  dibayarIsi = String(form.get('amount_paid') ?? '').trim();
  commissionPersenIsi = String(form.get('platform_commission_fee_percent') ?? '').trim();
  servicePersenIsi = String(form.get('platform_service_fee_percent') ?? '').trim();

  const angka = (kolom: string): number | undefined => {
    const mentah = String(form.get(kolom) ?? '').trim();
    if (!mentah) return undefined;
    const nilai = Number(mentah);
    return Number.isFinite(nilai) ? nilai : undefined;
  };

  if (aksi === 'kosongkan') {
    keranjang = [];
    diskonIsi = '';
    dibayarIsi = '';
  } else if (aksi === 'pelanggan-baru') {
    const nama = String(form.get('pelanggan_nama') ?? '').trim();
    if (!nama) {
      galat = 'Nama pelanggan wajib diisi.';
    } else {
      try {
        const baru = await api<Customer>('/customers', {
          method: 'POST',
          token,
          body: { name: nama, phone: String(form.get('pelanggan_telepon') ?? '').trim() || undefined },
        });
        pelangganDipilih = baru.id;
        sukses = `Pelanggan "${baru.name ?? nama}" siap dipakai.`;
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan pelanggan.';
      }
    }
  } else if (aksi === 'bayar') {
    if (keranjang.length === 0) {
      galat = 'Keranjang masih kosong.';
    } else if (!kunci) {
      galat = 'Sesi kasir tidak valid. Muat ulang halaman.';
    } else {
      try {
        // Dikirim sebagai pecahan (0,1725 = 17,25%), bukan angka persen
        // mentah -- itulah bentuk yang dipakai backend. `undefined` kalau
        // kosong: backend jatuh ke tarif bawaannya sendiri, satu-satunya
        // tempat nilai bawaan itu perlu didefinisikan.
        const persenKomisi = angka('platform_commission_fee_percent');
        const persenLayanan = angka('platform_service_fee_percent');
        struk = await api<Transaction>('/transactions', {
          method: 'POST',
          token,
          headers: { 'Idempotency-Key': kunci },
          body: {
            customer_id: pelangganDipilih || undefined,
            payment_method: metode,
            sales_channel: kanalIsi,
            amount_paid: metode === 'cash' ? angka('amount_paid') : undefined,
            // Ongkir tidak berlaku untuk Shopee -- backend mengabaikannya
            // juga, tapi tidak dikirim sama sekali di sini supaya niatnya
            // jelas dari isi request, bukan cuma dari validasi di sisi sana.
            shipping_cost: kanalIsi === 'shopee' ? undefined : angka('shipping_cost'),
            discount_amount: angka('discount_amount'),
            platform_commission_fee_percent:
              kanalIsi === 'shopee' && persenKomisi !== undefined ? persenKomisi / 100 : undefined,
            platform_service_fee_percent:
              kanalIsi === 'shopee' && persenLayanan !== undefined ? persenLayanan / 100 : undefined,
            items: keranjang.map((b) => ({
              product_id: b.product_id,
              qty: b.qty,
              batch_id: b.batch_id,
            })),
          },
        });

        // Ditangkap SEBELUM `pelangganDipilih` dikosongkan di bawah -- lihat
        // komentar `strukPelangganId` di atas.
        strukPelangganId = pelangganDipilih || null;

        // Penjualan selesai: meja kasir dikosongkan supaya pembeli berikutnya
        // tidak ikut membayar belanjaan pembeli sebelumnya. Saringan katalog
        // sengaja TIDAK ikut direset -- kasir biasanya melayani deretan
        // pembeli dari rak yang sama.
        keranjang = [];
        pelangganDipilih = '';
        ongkirIsi = '';
        diskonIsi = '';
        dibayarIsi = '';
        kunci = '';
        // Kanal TIDAK ikut direset. Pesanan marketplace biasanya dicatat
        // berurutan, dan kanal yang diam-diam kembali ke "Toko" setiap kali
        // satu pesanan selesai akan mencatat pesanan berikutnya seharga toko
        // tanpa ada yang menyadarinya.
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan transaksi.';
      }
    }
  }
}

if (!kunci) kunci = crypto.randomUUID();

const kueri = new URLSearchParams({ scope: 'terjual', limit: '200' });
if (cariIsi) kueri.set('search', cariIsi);
if (kategoriIsi) kueri.set('category_id', kategoriIsi);

const [produk, kategori, semuaBatch, pelanggan] = await Promise.all([
  api<PaginatedProducts>(`/products?${kueri}`, { token }),
  api<Category[]>('/categories', { token }),
  // Satu permintaan untuk seluruh batch yang masih bersisa, bukan satu per
  // produk: daftar kasir bisa berisi 200 baris, dan 200 permintaan untuk
  // mengisi 200 pemilih batch akan terasa sebelum barang pertama dipindai.
  api<ProductBatch[]>('/batches', { token }),
  bolehTransaksi
    ? api<PaginatedCustomers>('/customers?limit=200', { token }).then((h) => h.data)
    : Promise.resolve([] as Customer[]),
]);

/**
 * Nama pelanggan untuk nota cetak, dicari dari daftar yang sama yang mengisi
 * pemilih pelanggan di panel kasir -- bukan permintaan kedua ke server.
 *
 * `undefined` (bukan cuma `strukPelangganId` kosong) kalau pelanggannya ada
 * tapi daftar 200 ini kebetulan tidak memuatnya; nota tetap tercetak, hanya
 * barisnya diberi label umum, bukan "Walk-in" yang berarti sesuatu yang
 * berbeda.
 */
const strukPelanggan = strukPelangganId
  ? pelanggan.find((c) => c.id === strukPelangganId)
  : null;

/** Batch bersisa per produk, urut FEFO -- urutan yang sama dengan urutan keluarnya. */
const batchProduk = new Map<string, ProductBatch[]>();
for (const b of semuaBatch) {
  const daftar = batchProduk.get(b.product_id);
  if (daftar) daftar.push(b);
  else batchProduk.set(b.product_id, [b]);
}

// Barang habis tidak ditampilkan sama sekali: barisnya hanya memenuhi layar
// dengan sesuatu yang tidak bisa dijual.
const barang = produk.data.filter((p) => p.stock_qty > 0);
const adaYangTerpotong = produk.total > produk.data.length;

/**
 * Harga keranjang ditetapkan ulang dari katalog, bukan dipercaya dari form.
 *
 * `harga` yang ikut di tiap baris hanyalah angka yang dirender halaman
 * SEBELUMNYA, dan setelah kanal diganti angka itu milik daftar harga yang
 * lama. Tanpa penetapan ulang ini, mengganti kanal tanpa JavaScript akan
 * menampilkan total dengan harga kanal sebelumnya -- angka yang nanti tidak
 * cocok dengan struk, karena backend menghitung dari harga kanal yang benar.
 *
 * Baris yang produknya tersaring keluar dari katalog tidak bisa ditetapkan
 * ulang di sini: barisnya memang tidak ikut terbaca dari `/products`. Ia
 * memakai harga yang dibawanya sampai produknya terlihat lagi; yang menagih
 * tetap backend.
 */
const hargaKatalog = new Map(produk.data.map((p) => [p.id, hargaDi(p, kanalIsi)]));
keranjang = keranjang.map((b) => ({ ...b, harga: hargaKatalog.get(b.product_id) ?? b.harga }));

/** Jumlah per batch, untuk mengisi ulang kolom di tiap baris batch. */
const jumlahBatch = new Map(keranjang.map((b) => [`${b.product_id}:${b.batch_id}`, b.qty]));

/** Jumlah per produk. Dipakai kartu: disorot atau tidak, dan berapa yang sudah dipilih. */
const jumlahProduk = new Map<string, number>();
for (const b of keranjang) {
  jumlahProduk.set(b.product_id, (jumlahProduk.get(b.product_id) ?? 0) + b.qty);
}

const totalItem = keranjang.reduce((n, b) => n + b.qty, 0);
const totalBelanja = keranjang.reduce((n, b) => n + b.harga * b.qty, 0);
// Ongkir tidak berlaku untuk Shopee sama sekali -- lihat komentar
// `biayaPersenRupiah` dkk. di atas. Kolomnya disembunyikan untuk kanal itu,
// tapi kalau ada nilai lama yang masih nyangkut di form (mis. sisa dari
// kanal Toko sebelum diganti), tetap dipaksa nol di sini juga.
const ongkirAngka = kanalIsi === 'shopee' ? 0 : Math.max(0, Number(ongkirIsi) || 0);
// Diskon dipotong sampai setinggi-tingginya subtotal. Backend menolak yang
// melebihi -- di sini angkanya cuma tidak dibiarkan membuat total negatif di
// layar sebelum penolakan itu datang.
const diskonAngka = Math.min(totalBelanja, Math.max(0, Number(diskonIsi) || 0));

// Kosong jatuh ke tarif bawaan, dan dijepit 0-100 -- sama seperti backend
// menjepit pecahannya ke 0..1 (lihat validasi di `pos::service::checkout`).
const jepitPersen = (isi: string, bawaan: number): number =>
  isi.trim() === '' ? bawaan : Math.min(100, Math.max(0, Number(isi) || bawaan));

const commissionPersenAngka = jepitPersen(commissionPersenIsi, SHOPEE_COMMISSION_PERSEN_DEFAULT);
const servicePersenAngka = jepitPersen(servicePersenIsi, SHOPEE_SERVICE_PERSEN_DEFAULT);

// Basis potongan Shopee: omzet SETELAH diskon. Sama dengan `basis_fee` di
// `backend/src/pos/service.rs`.
const basisFeeShopee = Math.max(0, totalBelanja - diskonAngka);
const biayaKomisiAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, commissionPersenAngka) : 0;
const biayaLayananAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, servicePersenAngka) : 0;
const biayaWithholdingTaxAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, SHOPEE_WITHHOLDING_TAX_PERSEN) : 0;
const biayaOrderProcessingAngka = kanalIsi === 'shopee' ? SHOPEE_ORDER_PROCESSING_FEE : 0;

// Sejak kasir kanal Shopee cuma mencatat pesanan yang uangnya sudah diterima
// lewat ShopeePay -- bukan menagih pembayaran baru -- angka ini BUKAN lagi
// "yang dibayar pembeli" untuk kanal itu. Ia langsung dikurangi keempat biaya
// platform, dan labelnya berganti jadi "Estimasi Total Penghasilan" di
// render di bawah supaya bedanya kelihatan. `ongkirAngka` sudah nol untuk
// Shopee, jadi rumusnya tetap satu untuk semua kanal.
const totalTagihan =
  totalBelanja -
  diskonAngka +
  ongkirAngka -
  biayaKomisiAngka -
  biayaLayananAngka -
  biayaWithholdingTaxAngka -
  biayaOrderProcessingAngka;
const tunai = metode === 'cash';
const dibayarAngka = Number(dibayarIsi);
const adaDibayar = tunai && dibayarIsi !== '' && Number.isFinite(dibayarAngka);
const kurangBayar = adaDibayar && dibayarAngka < totalTagihan;

/**
 * Baris panel keranjang.
 *
 * Dirender untuk SETIAP (produk, batch) yang ada di katalog, bukan hanya yang
 * jumlahnya di atas nol; barisnya disembunyikan selama masih nol. Alasannya
 * satu: kalau barisnya baru dibuat saat dibutuhkan, skrip halaman harus bisa
 * merakit baris keranjang sendiri -- jalur render kedua yang bisa menyimpang
 * dari yang dirender server, tepat di tempat yang menampilkan angka tagihan.
 *
 * `luar` menandai baris yang produknya TIDAK ada di katalog saat ini, yaitu
 * barang yang sudah masuk keranjang lalu tersaring keluar oleh pencarian.
 * Baris itu membawa sendiri isian keranjangnya; tanpa itu, menyaring tanpa
 * JavaScript akan menghapus diam-diam barang yang sudah dipilih.
 */
interface BarisPanel {
  kunci: string;
  product_id: string;
  nama: string;
  harga: number;
  /**
   * Harga baris ini di tiap kanal, supaya skrip halaman bisa menghitung ulang
   * total saat kanal diganti tanpa perjalanan ke server.
   *
   * `null` untuk baris yang produknya sedang tersaring keluar dari katalog:
   * yang dibawa baris itu hanyalah harga saat ia dimasukkan ke keranjang, dan
   * mengarang dua harga lain dari satu angka akan menampilkan angka yang tidak
   * pernah dipakai siapa pun. Barisnya tetap memakai harga yang dibawanya
   * sampai produknya kembali terlihat; yang menagih tetap backend.
   */
  hargaKanal: Record<Kanal, number> | null;
  batchLabel: string;
  qty: number;
  sisa: number;
  luar: boolean;
}

const diKatalog = new Set<string>();
const barisPanel: BarisPanel[] = [];

const labelBatch = (b: ProductBatch): string =>
  `Batch ${b.batch_number ?? 'tanpa nomor'} · ${b.expiry_date ? tanggal(b.expiry_date) : 'tanpa tanggal'}`;

/** Harga sebuah produk di seluruh kanal sekaligus, untuk atribut data-. */
const hargaSemuaKanal = (p: Product): Record<Kanal, number> => ({
  toko: hargaDi(p, 'toko'),
  shopee: hargaDi(p, 'shopee'),
  tiktok: hargaDi(p, 'tiktok'),
});

for (const p of barang) {
  for (const b of batchProduk.get(p.id) ?? []) {
    const kunciBaris = `${p.id}:${b.id}`;
    diKatalog.add(kunciBaris);
    barisPanel.push({
      kunci: kunciBaris,
      product_id: p.id,
      nama: p.name,
      harga: hargaDi(p, kanalIsi),
      hargaKanal: hargaSemuaKanal(p),
      batchLabel: labelBatch(b),
      qty: jumlahBatch.get(kunciBaris) ?? 0,
      sisa: b.remaining_qty,
      luar: false,
    });
  }
}

for (const b of keranjang) {
  const kunciBaris = `${b.product_id}:${b.batch_id}`;
  if (diKatalog.has(kunciBaris)) continue;
  const batch = semuaBatch.find((x) => x.id === b.batch_id);
  barisPanel.push({
    kunci: kunciBaris,
    product_id: b.product_id,
    nama: b.nama,
    harga: b.harga,
    hargaKanal: null,
    batchLabel: batch ? labelBatch(batch) : 'Batch di luar hasil saringan',
    qty: b.qty,
    // Tanpa batch-nya di tangan, batas satu-satunya yang pasti benar adalah
    // jumlah yang sudah diterima sebelumnya. Backend tetap menolak kalau
    // sisanya ternyata sudah berkurang.
    sisa: batch ? batch.remaining_qty : b.qty,
    luar: true,
  });
}

const jenisProduk = jumlahProduk.size;
const barisTerpakai = keranjang.length;

const METODE = [
  { nilai: 'cash', label: 'Tunai' },
  { nilai: 'transfer', label: 'Transfer' },
  { nilai: 'ewallet', label: 'E-wallet' },
];

/** Nominal cepat untuk uang tunai. "Uang pas" dihitung skrip dari total berjalan. */
const NOMINAL = [50000, 100000, 200000, 500000];

/** Nama yang bisa dibaca untuk pelanggan yang namanya kosong di database. */
const namaPelanggan = (c: Customer): string => c.name ?? c.phone ?? '(tanpa nama)';

/** Keterangan kedaluwarsa terdekat sebuah produk, plus apakah sudah mepet. */
function kedaluwarsa(daftar: ProductBatch[]): { label: string; mepet: boolean } {
  const terdekat = daftar.find((b) => b.expiry_date);
  if (!terdekat?.expiry_date) return { label: 'Tanpa expired date', mepet: false };
  const hari = sisaHari(terdekat.expiry_date);
  return {
    label:
      hari <= 30
        ? `Expired terdekat ${tanggal(terdekat.expiry_date)} · ${hari} hari`
        : `Expired terdekat ${tanggal(terdekat.expiry_date)}`,
    mepet: hari <= 30,
  };
}

/** Sisa satu batch beserta peringatan kedaluwarsanya. */
function sisaBatch(b: ProductBatch): { label: string; mepet: boolean } {
  if (!b.expiry_date) return { label: `sisa ${b.remaining_qty} · tanpa tanggal`, mepet: false };
  const hari = sisaHari(b.expiry_date);
  return {
    label: `sisa ${b.remaining_qty} · ${tanggal(b.expiry_date)}${hari <= 30 ? ` · ${hari} hari lagi` : ''}`,
    mepet: hari <= 30,
  };
}

/**
 * Rak tempat barang sebuah produk masih ada, urut FEFO dan tanpa pengulangan.
 *
 * Sejak migrasi 0016 lokasi milik batch: satu produk bisa tersebar di beberapa
 * rak, dan satu label tunggal seperti dulu akan menyuruh pengepak ke rak yang
 * salah untuk sebagian barangnya. `daftar` sudah urut FEFO dari `/batches`.
 */
function lokasiProduk(daftar: ProductBatch[]): string {
  const rak = daftar.map((b) => b.storage_location).filter((l): l is string => !!l);
  return [...new Set(rak)].join(', ');
}

/** Ringkasan batch yang sudah dipilih, untuk kartu yang panelnya tertutup. */
function ringkasBatch(p: Product): string {
  return (batchProduk.get(p.id) ?? [])
    .map((b) => ({ b, qty: jumlahBatch.get(`${p.id}:${b.id}`) ?? 0 }))
    .filter((x) => x.qty > 0)
    .map((x) => `${x.b.batch_number ?? 'Tanpa nomor'} × ${x.qty}`)
    .join(', ');
}
