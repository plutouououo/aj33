          <div class="hanya-js flex flex-wrap gap-2" data-cepat>
            <button type="button" class="pil-diam" data-uang-pas>Uang pas</button>
            {NOMINAL.map((n) => (
              <button type="button" class="pil-diam tabular-nums" data-nominal={n}>
