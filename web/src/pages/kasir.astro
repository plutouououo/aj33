          <button class="tombol-utama w-full py-4 text-base" type="submit" name="aksi" value="bayar" data-bayar>
            {barisTerpakai > 0 ? `Selesaikan · ${rupiah(totalTagihan)}` : 'Keranjang masih kosong'}
          </button>

          <div class="flex items-center gap-3">
            <button
              class="text-xs font-semibold text-[var(--color-teks-lembut)] hover:text-merah-700"
              type="submit"
              name="aksi"
              value="kosongkan"
            >
              Kosongkan keranjang
            </button>
            {/* Tanpa JavaScript, angka di panel ini baru benar setelah satu
                perjalanan ke server. Tombol inilah perjalanannya. */}
            <button class="tombol-halus tanpa-js ml-auto" type="submit" name="aksi" value="hitung">
