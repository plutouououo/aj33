              </select>
            </div>

            <div class="isian">
              <p class="label">Metode pembayaran</p>
              <div class="flex flex-wrap gap-2">
                {METODE.map((m) => (
                  <label
                    class="pil-diam cursor-pointer has-[:checked]:border-merah-600 has-[:checked]:bg-merah-600 has-[:checked]:text-white"
                  >
                    <input
                      class="sr-only"
                      type="radio"
                      name="payment_method"
                      value={m.nilai}
                      checked={metode === m.nilai}
                      data-metode
                    />
                    {m.label}
                  </label>
                ))}
              </div>
            </div>

            <div class="isian isian-pendek">
              <label class="label" for="shipping_cost">Ongkos kirim (Rp)</label>
              <input
                class="kolom"
                id="shipping_cost"
                name="shipping_cost"
                type="number"
                min="0"
                step="1"
                value={ongkirIsi}
                placeholder="0"
                data-ongkir
              />
              <p class="isian-bantu">Ditambahkan ke total, tidak masuk harga barang.</p>
            </div>

            <div class="isian isian-pendek">
              <label class="label" for="amount_paid">Jumlah diterima (tunai)</label>
              <input
                class="kolom"
                id="amount_paid"
                name="amount_paid"
                type="number"
                min="0"
                step="1"
                value={dibayarIsi}
                placeholder="0"
                data-dibayar
              />
              <p class="isian-bantu">
                Diisi hanya untuk pembayaran tunai. Kembalian tetap dihitung ulang server.
              </p>
            </div>

            {/* Total ditaruh tepat di bawah kolom ongkir dan jumlah diterima,
                bukan di tabel ringkasan yang sudah tergulir jauh ke atas --
                inilah angka yang dibacakan ke pembeli, dan matanya sedang di
                sini. Ukurannya disamakan dengan kembalian: sebelumnya total
                seukuran teks bantu sementara kembalian dua kali lipatnya,
                sehingga yang lebih dulu terbaca justru yang bukan tagihan. */}
            <div class="isian">
              <div class="kotak-total">
                <div>
                  <p class="font-medium">Total</p>
                  <p class="text-xs text-[var(--color-teks-lembut)]">
                    Subtotal {rupiah(totalBelanja)}
                    <span class:list={[ongkirAngka > 0 ? '' : 'hidden']} data-baris-ongkir>
                      {' + ongkir '}
                      <span data-ongkir-tampil>{rupiah(ongkirAngka)}</span>
                    </span>
                  </p>
                </div>
                <p class="kotak-total-angka" data-total>{rupiah(totalTagihan)}</p>
              </div>
            </div>

            <p class="isian hidden text-sm font-semibold text-red-600" data-kurang>
              Uang yang diterima masih kurang.
            </p>

            <div class="isian kotak-kembalian hidden" data-kotak-kembalian>
              <p class="text-sm">Kembalian</p>
              <p class="kotak-kembalian-angka" data-kembalian>—</p>
            </div>
          </div>

          <div class="bilah-bawah">
            <button class="tombol-halus flex-1 sm:flex-none" type="submit" name="aksi" value="kembali">
              ← Kembali
            </button>
            <button
              class="tombol-utama flex-1 sm:ml-auto sm:flex-none"
              type="submit"
              name="aksi"
              value="bayar"
            >
              Selesaikan
            </button>
          </div>
        </form>
      </Fragment>
    )
  }

  {/* ================================================================= */}
  {/* Langkah 3 — konfirmasi                                            */}
  {/* ================================================================= */}
  {
    langkah === 3 && struk && (
      <Fragment>
        <div class="mx-auto max-w-md text-center">
          <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full bg-emerald-100">
            <span class="text-3xl text-emerald-600" aria-hidden="true">✓</span>
          </div>
          <h2 class="text-xl font-bold">Penjualan berhasil!</h2>
          <p class="mt-1 text-sm text-[var(--color-teks-lembut)]">
            #{struk.id.slice(0, 8)}
          </p>

          {/* Kembalian diangkat ke atas tabel, bukan dibiarkan jadi satu baris
              kecil di antara sembilan baris lain. Inilah satu-satunya angka di
              layar ini yang masih harus DIKERJAKAN kasir -- sisanya sudah
              selesai dan cuma perlu ada kalau ditanya. Angka yang salah baca di
              sini berarti uang hilang. */}
          {struk.change_amount !== null && struk.change_amount > 0 && (
            <div class="kotak-kembalian mt-5 text-left">
              <p class="text-sm">Kembalian</p>
              <p class="kotak-kembalian-angka">{rupiah(struk.change_amount)}</p>
            </div>
          )}

          <div class="kartu mt-5 text-left">
            <table class="w-full text-sm">
              <tbody>
                {struk.items.map((it) => (
                  <tr>
                    <td class="py-1">
                      {it.product_name_snapshot}
                      <span class="text-[var(--color-teks-lembut)]"> × {it.qty}</span>
                    </td>
                    <td class="py-1 text-right tabular-nums">{rupiah(it.subtotal)}</td>
                  </tr>
                ))}
                <tr class="border-t border-[var(--color-garis)]">
                  <td class="py-2">Subtotal</td>
                  <td class="py-2 text-right tabular-nums">{rupiah(struk.subtotal)}</td>
                </tr>
                {struk.shipping_cost > 0 && (
                  <tr>
                    <td class="py-1">Ongkos kirim</td>
                    <td class="py-1 text-right tabular-nums">{rupiah(struk.shipping_cost)}</td>
                  </tr>
                )}
                <tr class="border-t border-[var(--color-garis)] font-bold">
                  <td class="py-2">Total</td>
                  <td class="py-2 text-right tabular-nums">{rupiah(struk.total_amount)}</td>
                </tr>
                {struk.amount_paid !== null && (
                  <Fragment>
                    <tr>
                      <td class="py-1 text-[var(--color-teks-lembut)]">Dibayar</td>
                      <td class="py-1 text-right tabular-nums">{rupiah(struk.amount_paid)}</td>
                    </tr>
                    {/* Tetap ada supaya rincian struknya utuh dan bisa
                        dicocokkan (Dibayar − Total), tapi tidak lagi ditebalkan
                        hijau: penekanannya sudah dipegang kotak besar di atas,
                        dan dua penekanan untuk satu angka membuat keduanya
                        berhenti menonjol. */}
                    <tr>
                      <td class="py-1">Kembalian</td>
                      <td class="py-1 text-right tabular-nums">
                        {rupiah(struk.change_amount ?? 0)}
                      </td>
                    </tr>
                  </Fragment>
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* Tautan GET, bukan tombol: itulah yang memberi kunci idempotensi baru
            untuk transaksi berikutnya.

            Ikut menempel di dasar layar seperti aksi utama langkah 1 dan 2 --
            struk dengan banyak barang lebih panjang dari layar ponsel, dan
            tanpa ini kasir harus menggulung ke bawah dulu sebelum bisa
            melayani pembeli berikutnya.

            Saudara kolom struk, bukan anaknya: margin negatif `.bilah-bawah`
            membatalkan padding <main>, jadi di dalam kolom selebar 28rem itu
            bilahnya akan tergeser dan tidak sampai ke tepi layar. */}
        <div class="bilah-bawah">
          <a href="/kasir" class="tombol-utama w-full sm:mx-auto sm:max-w-xs">
            Penjualan baru
          </a>
        </div>
      </Fragment>
    )
  }
</AppShell>

{/*
  Progressive enhancement langkah 1.

  Skrip ini HANYA menulis ke `input[name=qty]` yang sudah ada di HTML. Ia
  tidak pernah merakit body request, mencegat submit, atau merender baris.
  Karena itu server menerima bentuk data yang sama persis apakah JavaScript
  hidup atau mati -- tidak ada jalur kedua yang bisa menyimpang.

  `is:inline` mengikuti satu-satunya pola JS yang sudah ada di proyek ini
  (AppShell). Konsekuensinya tidak bisa meng-import, jadi pemformatan rupiah
  ditulis ulang di sini; opsinya harus tetap sama dengan `rupiah()` di
  web/src/lib/format.ts.
*/}
<script is:inline>
  (function () {
    var borang = document.getElementById('borang-kasir');
    if (!borang) return;

    // Mode lihat-saja tidak punya kendali jumlah maupun bilah ringkasan, dan
    // seluruh skrip di bawah menulis ke keduanya. Berhenti di sini membuat
    // halaman itu jatuh ke jalur tanpa-JS yang memang sudah didukung penuh:
    // saringannya dikerjakan server lewat tombol "Terapkan".
    if (borang.dataset.transaksi !== 'ya') return;

    // Baris pertama: menyalakan saklar CSS supaya stepper muncul dan kolom
    // angka menghilang. Lihat .hanya-js / .tanpa-js di theme.css.
    document.documentElement.dataset.js = 'ya';

    var rupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });

    var baris = Array.prototype.slice.call(borang.querySelectorAll('[data-produk]'));
    var kotakCari = borang.querySelector('[data-cari]');
    var pil = borang.querySelector('[data-pil-kategori]');
    var pesanKosong = borang.querySelector('[data-kosong-saringan]');

    // Panel batch dirender server dengan `open` supaya tetap terpakai tanpa
    // JavaScript. Ditutup di sini, lalu dibuka lagi sebagai pop up lewat
    // showModal(). Kolom jumlah di dalamnya tidak ikut ke mana-mana: elemen
    // yang sama itulah yang terkirim, terbuka maupun tertutup.
    baris.forEach(function (row) {
      var panel = row.querySelector('[data-panel-batch]');
      if (panel && panel.open) panel.close();
    });

    function kolomQty(row) {
      return Array.prototype.slice.call(row.querySelectorAll('[data-qty]'));
    }

    function jumlahBaris(row) {
      return kolomQty(row).reduce(function (n, kolom) {
        return n + (parseInt(kolom.value, 10) || 0);
      }, 0);
    }

    /** Ringkasan di kartu yang tertutup: batch mana, berapa. */
    function ringkasBatch(row) {
      return kolomQty(row)
        .filter(function (kolom) {
          return (parseInt(kolom.value, 10) || 0) > 0;
        })
        .map(function (kolom) {
          return kolom.dataset.batch + ' \u00d7 ' + kolom.value;
        })
        .join(', ');
    }

    function hitung() {
      var item = 0;
      var produk = 0;
      var total = 0;

      baris.forEach(function (row) {
        var qty = jumlahBaris(row);
        if (qty > 0) {
          item += qty;
          produk += 1;
          total += qty * parseFloat(row.dataset.harga || '0');
        }
        row.className = qty > 0 ? 'baris-produk-terpilih' : 'baris-produk';

        var ringkas = row.querySelector('[data-ringkas-baris]');
        if (ringkas) ringkas.textContent = qty > 0 ? ringkasBatch(row) : '';

        var totalPanel = row.querySelector('[data-total-batch]');
        if (totalPanel) totalPanel.textContent = String(qty);
      });

      borang.querySelector('[data-ringkas-item]').textContent = String(item);
      borang.querySelector('[data-ringkas-produk]').textContent = ' ' + produk;
      borang.querySelector('[data-ringkas-total]').textContent = rupiah.format(total);
    }

    // Batasnya sisa BATCH ini, bukan stok produk: dua batch produk yang sama
    // punya jatah sendiri-sendiri, dan menjumlahkannya di sini akan
    // menjanjikan butir yang tidak ada di kiriman yang dipilih.
    function ubah(kolom, selisih) {
      var sisa = parseInt(kolom.dataset.sisa || '0', 10);
      var nilai = (parseInt(kolom.value, 10) || 0) + selisih;
      if (nilai < 0) nilai = 0;
      if (nilai > sisa) nilai = sisa;
      kolom.value = String(nilai);
      hitung();
    }

    function kolomDi(el) {
      var barisBatch = el.closest('[data-baris-batch]');
      return barisBatch ? barisBatch.querySelector('[data-qty]') : null;
    }

    borang.addEventListener('click', function (e) {
      var buka = e.target.closest('[data-buka-batch]');
      if (buka) {
        var panel = buka.closest('[data-produk]').querySelector('[data-panel-batch]');
        if (panel) panel.showModal();
        return;
      }

      var tutup = e.target.closest('[data-tutup-batch]');
      if (tutup) {
        tutup.closest('[data-panel-batch]').close();
        return;
      }

      var tambah = e.target.closest('[data-tambah]');
      if (tambah) {
        var kolomTambah = kolomDi(tambah);
        if (kolomTambah) ubah(kolomTambah, 1);
        return;
      }

      var kurang = e.target.closest('[data-kurang]');
      if (kurang) {
        var kolomKurang = kolomDi(kurang);
        if (kolomKurang) ubah(kolomKurang, -1);
      }
    });

    // Enter di kolom jumlah men-submit form -- di langkah 1 itu berarti
    // "Terapkan" saringan, dan pop up yang sedang dibuka lenyap bersama
    // halamannya. Di dalam panel, Enter menutup panel saja.
    borang.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      var panel = e.target.closest('[data-panel-batch]');
      if (!panel || !panel.open) return;
      e.preventDefault();
      panel.close();
    });

    borang.addEventListener('input', function (e) {
      if (e.target.matches('[data-qty]')) hitung();
      if (e.target === kotakCari) saring();
    });

    // Pil kategori menyaring di tempat, tidak mengirim form: mengirimnya
    // berarti memuat ulang halaman, dan keranjang yang sedang dibangun ikut
    // melewati server tanpa alasan.
    if (pil) {
      pil.addEventListener('change', function () {
        saring();
        Array.prototype.forEach.call(pil.querySelectorAll('label'), function (l) {
          l.className = l.querySelector('input').checked ? 'pil-aktif' : 'pil-diam';
        });
      });
    }

    function saring() {
      var kata = (kotakCari ? kotakCari.value : '').trim().toLowerCase();
      var terpilih = pil ? pil.querySelector('input:checked') : null;
      var kategori = terpilih ? terpilih.value : '';
      var terlihat = 0;

      baris.forEach(function (row) {
        var cocokKata =
          !kata ||
          row.dataset.nama.indexOf(kata) !== -1 ||
          row.dataset.sku.indexOf(kata) !== -1;
        var cocokKategori = !kategori || row.dataset.kategori === kategori;
        // Barang yang sudah masuk keranjang tidak pernah disembunyikan --
        // kalau hilang dari layar, kasir tidak punya cara membatalkannya.
        var diKeranjang = jumlahBaris(row) > 0;
        var tampil = diKeranjang || (cocokKata && cocokKategori);
        row.hidden = !tampil;
        if (tampil) terlihat += 1;
      });

      if (pesanKosong) pesanKosong.classList.toggle('hidden', terlihat > 0);
    }

    hitung();
  })();
</script>

{/*
  Progressive enhancement langkah 2: dua angka yang harus terbaca SEBELUM
  uang diterima -- kekurangan dan kembalian. Tanpa JavaScript, kekurangan
  dijawab backend lewat .galat dan kembalian muncul di langkah 3.
*/}
<script is:inline>
  (function () {
    var kotak = document.querySelector('[data-kotak-kembalian]');
    if (!kotak) return;

    document.documentElement.dataset.js = 'ya';

    var rupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });

    var selSubtotal = document.querySelector('[data-subtotal]');
    var subtotal = parseFloat(selSubtotal ? selSubtotal.dataset.subtotal : '0') || 0;
    var ongkir = document.querySelector('[data-ongkir]');
    var dibayar = document.querySelector('[data-dibayar]');
    var selTotal = document.querySelector('[data-total]');
    var selKurang = document.querySelector('[data-kurang]');
    var selKembalian = document.querySelector('[data-kembalian]');

    function tunai() {
      var m = document.querySelector('[data-metode]:checked');
      return !m || m.value === 'cash';
    }

    var barisOngkir = document.querySelector('[data-baris-ongkir]');
    var ongkirTampil = document.querySelector('[data-ongkir-tampil]');

    function hitung() {
      var biaya = Math.max(0, parseFloat(ongkir.value) || 0);
      var total = subtotal + biaya;
      selTotal.textContent = rupiah.format(total);

      // Rincian di bawah "Total" ikut berubah; kalau hanya angka totalnya
      // yang diperbarui, rinciannya membantah totalnya sendiri.
      if (barisOngkir) barisOngkir.classList.toggle('hidden', biaya <= 0);
      if (ongkirTampil) ongkirTampil.textContent = rupiah.format(biaya);

      var bayar = parseFloat(dibayar.value);
      var adaBayar = tunai() && !isNaN(bayar);

      selKurang.classList.toggle('hidden', !(adaBayar && bayar < total));
      kotak.classList.toggle('hidden', !(adaBayar && bayar >= total));
      if (adaBayar && bayar >= total) {
        selKembalian.textContent = rupiah.format(bayar - total);
      }
    }

    document.addEventListener('input', hitung);
    document.addEventListener('change', hitung);
    hitung();
  })();
</script>
