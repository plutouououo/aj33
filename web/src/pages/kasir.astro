                {/* Untuk Shopee keempat biaya sudah mengurangi Total; ditulis sebagai baris struk biasa supaya penjumlahannya terlihat seperti Diskon dan Ongkos kirim. */}
                {struk.sales_channel === 'shopee' && (
                  <Fragment>
                    <tr>
                      <td class="py-0.5">
                        Biaya Komisi ({struk.platform_commission_fee_percent * 100}%)
                      </td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_commission_fee)}
                      </td>
                    </tr>
                    {struk.platform_service_fee > 0 && (
                      <tr>
                        <td class="py-0.5">
                          Biaya Layanan ({struk.platform_service_fee_percent * 100}%)
                        </td>
                        <td class="py-0.5 text-right tabular-nums">
                          -{rupiah(struk.platform_service_fee)}
                        </td>
                      </tr>
                    )}
                    <tr>
                      <td class="py-0.5">PPh UMKM (0,5%)</td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_withholding_tax)}
                      </td>
                    </tr>
                    <tr>
                      <td class="py-0.5">Biaya proses pemesanan</td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_order_processing_fee)}
