  </form>

  {/* Di ponsel panel keranjang berada di BAWAH katalog yang panjangnya bisa
      200 kartu. Bilah ini yang membuatnya tetap terjangkau: ringkasan yang
      terbaca sekilas plus satu tautan ke panelnya. Di layar lebar panelnya
      sudah menempel di samping, jadi bilahnya tidak dirender. */}
  {bolehTransaksi && (
    <div class="bilah-bawah lg:hidden">
      <span class="text-sm text-[var(--color-teks-lembut)]">
        <span data-bilah-item>{totalItem}</span> pack
      </span>
      <span class="ml-auto text-base font-bold tabular-nums" data-bilah-total>
        {rupiah(totalTagihan)}
      </span>
      <a href="#keranjang" class="tombol-utama">Keranjang</a>
    </div>
  )}
</AppShell>

{/*
  Progressive enhancement.

  Skrip ini HANYA menulis ke `input[name=qty]` yang sudah ada di HTML dan ke
  teks yang ditampilkan. Ia tidak pernah merakit body request, mencegat submit,
  atau membuat baris keranjang baru -- baris panel keranjang sudah dirender
  server untuk tiap batch di katalog, dan yang dikerjakan di sini cuma
  menyembunyikan yang jumlahnya nol. Karena itu server menerima bentuk data
  yang sama persis apakah JavaScript hidup atau mati.

  `is:inline` mengikuti satu-satunya pola JS yang sudah ada di proyek ini
  (AppShell). Konsekuensinya tidak bisa meng-import, jadi pemformatan rupiah
  ditulis ulang di sini; opsinya harus tetap sama dengan `rupiah()` di
  web/src/lib/format.ts.
*/}
<script is:inline>
  (function () {
    var borang = document.getElementById('borang-kasir');
    if (!borang) return;

    // Mode lihat-saja tidak punya kendali jumlah maupun panel keranjang, dan
    // seluruh skrip di bawah menulis ke keduanya. Berhenti di sini membuat
    // halaman itu jatuh ke jalur tanpa-JS yang memang sudah didukung penuh:
    // saringannya dikerjakan server lewat tombol "Terapkan".
    if (borang.dataset.transaksi !== 'ya') return;

    // Baris pertama: menyalakan saklar CSS supaya stepper muncul dan kolom
    // angka di katalog menghilang. Lihat .hanya-js / .tanpa-js di theme.css.
    document.documentElement.dataset.js = 'ya';

    var rupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });

    var baris = Array.prototype.slice.call(borang.querySelectorAll('[data-produk]'));
    var barisKeranjang = Array.prototype.slice.call(
      borang.querySelectorAll('[data-baris-keranjang]')
    );
    var kotakCari = borang.querySelector('[data-cari]');
    var pil = borang.querySelector('[data-pil-kategori]');
    var pesanKosong = borang.querySelector('[data-kosong-saringan]');
    var pesanKeranjangKosong = borang.querySelector('[data-keranjang-kosong]');

    var ongkir = borang.querySelector('[data-ongkir]');
    var dibayar = borang.querySelector('[data-dibayar]');
    var selSubtotal = borang.querySelector('[data-subtotal]');
    var selOngkir = borang.querySelector('[data-ongkir-tampil]');
    var selTotal = borang.querySelector('[data-total]');
    var kotakKembalian = borang.querySelector('[data-kotak-kembalian]');
    var labelKembalian = borang.querySelector('[data-label-kembalian]');
    var selKembalian = borang.querySelector('[data-kembalian]');
    var selRingkas = borang.querySelector('[data-ringkas-item]');
    var tombolBayar = borang.querySelector('[data-bayar]');
    var bilahItem = document.querySelector('[data-bilah-item]');
    var bilahTotal = document.querySelector('[data-bilah-total]');

    // Panel batch dirender server dengan `open` supaya tetap terpakai tanpa
    // JavaScript. Ditutup di sini, lalu dibuka lagi sebagai pop up lewat
    // showModal(). Kolom jumlah di dalamnya tidak ikut ke mana-mana: elemen
    // yang sama itulah yang terkirim, terbuka maupun tertutup.
    baris.forEach(function (row) {
      var panel = row.querySelector('[data-panel-batch]');
      if (panel && panel.open) panel.close();
    });

    function kolomQty(row) {
      return Array.prototype.slice.call(row.querySelectorAll('[data-qty]'));
    }

    function nilai(kolom) {
      return kolom ? parseInt(kolom.value, 10) || 0 : 0;
    }

    function jumlahBaris(row) {
      return kolomQty(row).reduce(function (n, kolom) {
        return n + nilai(kolom);
      }, 0);
    }

    /** Ringkasan di kartu yang panelnya tertutup: batch mana, berapa. */
    function ringkasBatch(row) {
      return kolomQty(row)
        .filter(function (kolom) {
          return nilai(kolom) > 0;
        })
        .map(function (kolom) {
          return kolom.dataset.batch + ' × ' + kolom.value;
        })
        .join(', ');
    }

    function tunai() {
      var m = borang.querySelector('[data-metode]:checked');
      return !m || m.value === 'cash';
    }

    function hitung() {
      // --- Katalog -----------------------------------------------------
      baris.forEach(function (row) {
        var qty = jumlahBaris(row);
        row.className = qty > 0 ? 'kartu-produk-terpilih' : 'kartu-produk';

        var ringkas = row.querySelector('[data-ringkas-baris]');
        if (ringkas) ringkas.textContent = qty > 0 ? ringkasBatch(row) : '';

        var lencana = row.querySelector('[data-lencana]');
        if (lencana) {
          lencana.hidden = qty === 0;
          lencana.textContent = String(qty);
        }

        var totalPanel = row.querySelector('[data-total-batch]');
        if (totalPanel) totalPanel.textContent = String(qty);
      });

      // --- Panel keranjang ---------------------------------------------
      var item = 0;
      var jalur = 0;
      var subtotal = 0;
      var produk = {};
      var jenis = 0;

      barisKeranjang.forEach(function (row) {
        var kolom = document.getElementById(row.dataset.kolom);
        var qty = nilai(kolom);
        row.hidden = qty === 0;
        if (qty > 0) {
          item += qty;
          jalur += 1;
          subtotal += qty * parseFloat(row.dataset.harga || '0');
          if (!produk[row.dataset.pid]) {
            produk[row.dataset.pid] = true;
            jenis += 1;
          }
        }

        Array.prototype.forEach.call(row.querySelectorAll('[data-qty-teks]'), function (el) {
          el.textContent = String(qty);
        });
        var sub = row.querySelector('[data-subtotal-baris]');
        if (sub) sub.textContent = rupiah.format(qty * parseFloat(row.dataset.harga || '0'));
      });

      if (pesanKeranjangKosong) pesanKeranjangKosong.classList.toggle('hidden', jalur > 0);
      if (selRingkas) {
        selRingkas.textContent =
          jalur > 0
            ? jenis + ' produk · ' + jalur + ' baris batch · ' + item + ' pack'
            : 'Keranjang kosong';
      }

      // --- Pembayaran ---------------------------------------------------
      var biaya = Math.max(0, parseFloat(ongkir.value) || 0);
      var total = subtotal + biaya;
      var adaTunai = tunai();

      selSubtotal.textContent = rupiah.format(subtotal);
      selOngkir.textContent = rupiah.format(biaya);
      selTotal.textContent = rupiah.format(total);

      // Kolom uang diterima hanya berlaku untuk tunai; dimatikan supaya
      // angkanya tidak ikut terkirim sebagai pembayaran yang tidak pernah
      // terjadi.
      dibayar.disabled = !adaTunai;

      var bayar = parseFloat(dibayar.value);
      var adaBayar = adaTunai && !isNaN(bayar);
      var kurang = adaBayar && bayar < total;

      kotakKembalian.className =
        (kurang ? 'kotak-kurang' : 'kotak-kembalian') + (adaBayar ? '' : ' hidden');
      labelKembalian.textContent = kurang ? 'Uang yang diterima masih kurang' : 'Kembalian';
      selKembalian.textContent = adaBayar ? rupiah.format(Math.abs(bayar - total)) : '—';

      // Yang menahan penjualan tetap backend. Tombol ini cuma berhenti
      // menawarkan aksi yang sudah pasti ditolak -- dan menyebutkan alasannya,
      // supaya kasir tidak menekan tombol mati tanpa tahu apa yang kurang.
      var bisa = jalur > 0 && (!adaTunai || (adaBayar && bayar >= total));
      tombolBayar.disabled = !bisa;
      tombolBayar.textContent =
        jalur === 0
          ? 'Keranjang masih kosong'
          : adaTunai && !adaBayar
            ? 'Isi uang diterima'
            : kurang
              ? 'Uang yang diterima masih kurang'
              : 'Selesaikan · ' + rupiah.format(total);

      if (bilahItem) bilahItem.textContent = String(item);
      if (bilahTotal) bilahTotal.textContent = rupiah.format(total);
    }

    // Batasnya sisa BATCH ini, bukan stok produk: dua batch produk yang sama
    // punya jatah sendiri-sendiri, dan menjumlahkannya di sini akan
    // menjanjikan butir yang tidak ada di kiriman yang dipilih.
    function ubah(kolom, selisih) {
      var sisa = parseInt(kolom.dataset.sisa || '0', 10);
      var angka = nilai(kolom) + selisih;
      if (angka < 0) angka = 0;
      if (angka > sisa) angka = sisa;
      kolom.value = String(angka);
      hitung();
    }

    function kolomDi(el) {
      var barisBatch = el.closest('[data-baris-batch]');
      return barisBatch ? barisBatch.querySelector('[data-qty]') : null;
    }

    function kolomKeranjang(el) {
      var row = el.closest('[data-baris-keranjang]');
      return row ? document.getElementById(row.dataset.kolom) : null;
    }

    borang.addEventListener('click', function (e) {
      var buka = e.target.closest('[data-buka-batch]');
      if (buka) {
        var panel = buka.closest('[data-produk]').querySelector('[data-panel-batch]');
        if (panel) panel.showModal();
        return;
      }

      var tutup = e.target.closest('[data-tutup-batch]');
      if (tutup) {
        tutup.closest('[data-panel-batch]').close();
        return;
      }

      var tambah = e.target.closest('[data-tambah]');
      if (tambah) {
        var kolomTambah = kolomDi(tambah);
        if (kolomTambah) ubah(kolomTambah, 1);
        return;
      }

      var kurang = e.target.closest('[data-kurang]');
      if (kurang) {
        var kolomKurang = kolomDi(kurang);
        if (kolomKurang) ubah(kolomKurang, -1);
        return;
      }

      // Kendali −/+ di panel keranjang menulis ke KOLOM YANG SAMA milik
      // katalog, bukan ke salinan: yang tampil di panel hanyalah angkanya.
      var tambahK = e.target.closest('[data-tambah-keranjang]');
      if (tambahK) {
        var kolomTambahK = kolomKeranjang(tambahK);
        if (kolomTambahK) ubah(kolomTambahK, 1);
        return;
      }

      var kurangK = e.target.closest('[data-kurang-keranjang]');
      if (kurangK) {
        var kolomKurangK = kolomKeranjang(kurangK);
        if (kolomKurangK) ubah(kolomKurangK, -1);
        return;
      }

      var pas = e.target.closest('[data-uang-pas]');
      if (pas) {
        dibayar.value = String(totalBerjalan());
        hitung();
        return;
      }

      var nominal = e.target.closest('[data-nominal]');
      if (nominal) {
        dibayar.value = nominal.dataset.nominal;
        hitung();
      }
    });

    /** Total berjalan, dibaca dari angka yang barusan dirender -- bukan dari
        nilai yang dirender server saat halaman dimuat. */
    function totalBerjalan() {
      var subtotal = barisKeranjang.reduce(function (n, row) {
        var qty = nilai(document.getElementById(row.dataset.kolom));
        return n + qty * parseFloat(row.dataset.harga || '0');
      }, 0);
      return subtotal + Math.max(0, parseFloat(ongkir.value) || 0);
    }

    // Enter di dalam panel batch men-submit form, dan pop up yang sedang
    // dibuka lenyap bersama halamannya. Di dalam panel, Enter menutup panel
    // saja; di kolom pencarian, Enter membuka panel produk teratas.
    borang.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;

      var panel = e.target.closest('[data-panel-batch]');
      if (panel && panel.open) {
        e.preventDefault();
        panel.close();
        return;
      }

      if (e.target === kotakCari) {
        var teratas = baris.filter(function (row) {
          return !row.hidden;
        })[0];
        if (!teratas) return;
        e.preventDefault();
        var panelTeratas = teratas.querySelector('[data-panel-batch]');
        if (panelTeratas) panelTeratas.showModal();
      }
    });

    borang.addEventListener('input', function (e) {
      if (e.target.matches('[data-qty], [data-qty-luar], [data-ongkir], [data-dibayar]')) hitung();
      if (e.target === kotakCari) saring();
    });

    // Pil kategori menyaring di tempat, tidak mengirim form: mengirimnya
    // berarti memuat ulang halaman, dan keranjang yang sedang dibangun ikut
    // melewati server tanpa alasan.
    if (pil) {
      pil.addEventListener('change', function () {
        saring();
        Array.prototype.forEach.call(pil.querySelectorAll('label'), function (l) {
          l.className = l.querySelector('input').checked ? 'pil-aktif' : 'pil-diam';
        });
      });
    }

    borang.addEventListener('change', function (e) {
      if (e.target.matches('[data-metode]')) hitung();
    });

    function saring() {
      var kata = (kotakCari ? kotakCari.value : '').trim().toLowerCase();
      var terpilih = pil ? pil.querySelector('input:checked') : null;
      var kategori = terpilih ? terpilih.value : '';
      var terlihat = 0;

      baris.forEach(function (row) {
        var cocokKata =
          !kata ||
          row.dataset.nama.indexOf(kata) !== -1 ||
          row.dataset.sku.indexOf(kata) !== -1;
        var cocokKategori = !kategori || row.dataset.kategori === kategori;
        // Barang yang sudah masuk keranjang tidak pernah disembunyikan --
        // kalau hilang dari layar, kasir tidak punya cara membatalkannya.
        var diKeranjang = jumlahBaris(row) > 0;
        var tampil = diKeranjang || (cocokKata && cocokKategori);
        row.hidden = !tampil;
        if (tampil) terlihat += 1;
      });

      if (pesanKosong) pesanKosong.classList.toggle('hidden', terlihat > 0);
    }

    hitung();
  })();
</script>
