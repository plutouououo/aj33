---
import Galat from '../components/Galat.astro';
import AppShell from '../layouts/AppShell.astro';
import {
  api,
  ApiRequestError,
  type Category,
  type Customer,
  type PaginatedCustomers,
  type PaginatedProducts,
  type Product,
  type ProductBatch,
  type Transaction,
} from '../lib/api';
import { fotoKecil } from '../lib/blob';
import { rupiah, sisaHari, tanggal, waktu } from '../lib/format';

/** Kanal penjualan menentukan daftar harga; tanpa pilihan kanal, selisih harga marketplace tercatat sebagai laba palsu (yang menagih tetap backend). */
const KANAL = [
  { nilai: 'toko', label: 'Toko', kolom: null },
  { nilai: 'shopee', label: 'Shopee', kolom: 'price_shopee' },
  { nilai: 'tiktok', label: 'Tokopedia / TikTok', kolom: 'price_tiktok' },
] as const;

type Kanal = (typeof KANAL)[number]['nilai'];

/** Biaya Shopee satu transaksi, nama field mengikuti `get_escrow_detail` dan sama dengan hitungan `pos/service.rs`, dihitung ulang di sini agar kasir melihatnya sebelum simpan. */
const SHOPEE_COMMISSION_PERSEN_DEFAULT = 17.25;
const SHOPEE_SERVICE_PERSEN_DEFAULT = 0;
const SHOPEE_WITHHOLDING_TAX_PERSEN = 0.5;
const SHOPEE_ORDER_PROCESSING_FEE = 1250;

/** Aritmetika bilangan bulat (basis × basis poin) agar pembulatan ,50 ke atas sama persis dengan `rupiah_bulat` di `pos/service.rs`, bukan `Math.round` float. */
function biayaPersenRupiah(basis: number, persen: number): number {
  const basisPoin = Math.round(persen * 100);
  return Math.round((basis * basisPoin) / 10000);
}

/** Harga kanal yang `null` jatuh ke harga dasar, sama dengan `SalesChannel::harga` di backend; kalau beda, layar tidak cocok dengan struk. */
function hargaDi(p: Product, kanal: Kanal): number {
  if (kanal === 'shopee') return p.price_shopee ?? p.price;
  if (kanal === 'tiktok') return p.price_tiktok ?? p.price;
  return p.price;
}

const user = Astro.locals.user!;
const token = Astro.locals.token!;

/** Pengepak hanya membaca detail produk; yang menolak penjualan adalah backend, flag ini cuma menyembunyikan kendali yang pasti ditolak. */
const bolehTransaksi = user.role !== 'pengepak';

/** Satu baris keranjang = satu batch satu produk; `nama` dan `harga` hanya untuk tampilan, harga ditetapkan ulang server saat checkout. */
interface BarisKeranjang {
  product_id: string;
  qty: number;
  nama: string;
  harga: number;
  /** Batch dipilih kasir sendiri dan wajib terisi, tidak ada lagi baris yang diserahkan ke FEFO. */
  batch_id: string;
}

let galat: string | null = null;
let sukses: string | null = null;
let struk: Transaction | null = null;
let keranjang: BarisKeranjang[] = [];
/** Pelanggan saat transaksi berhasil untuk nota cetak; `pelangganDipilih` sudah dikosongkan saat nota dirender, dan namanya baru dicari setelah daftar pelanggan diambil. */
let strukPelangganId: string | null = null;

// Isian pembayaran dibaca ulang tiap POST supaya kasir tidak mengetik ulang saat pembayaran ditolak.
let pelangganDipilih = '';
let metode = 'cash';
let kanalIsi: Kanal = 'toko';
let ongkirIsi = '';
let diskonIsi = '';
let dibayarIsi = '';
let cariIsi = '';
let kategoriIsi = '';
// Persen komisi/layanan Shopee tidak direset tiap transaksi selesai, karena pesanan Shopee berikutnya biasanya memakai persen yang sama.
let commissionPersenIsi = String(SHOPEE_COMMISSION_PERSEN_DEFAULT);
let servicePersenIsi = String(SHOPEE_SERVICE_PERSEN_DEFAULT);

/** Keranjang dibaca dari lima deret field sejajar yang harus sama panjang; tiap baris batch merender kelimanya sekaligus sehingga tidak bisa bergeser. */
function bacaKeranjang(form: FormData): BarisKeranjang[] {
  const ids = form.getAll('product_id');
  const qty = form.getAll('qty');
  const nama = form.getAll('nama');
  const harga = form.getAll('harga');
  const batch = form.getAll('batch_id');

  return (
    ids
      .map((id, i) => ({
        product_id: String(id),
        qty: Number(qty[i] ?? 0),
        nama: String(nama[i] ?? ''),
        harga: Number(harga[i] ?? 0),
        batch_id: String(batch[i] ?? ''),
      }))
      // Baris tanpa batch dibuang karena hanya bisa datang dari request rakitan dan akan mengeluarkan barang dari kiriman yang tidak dipilih siapa pun.
      .filter((b) => Number.isFinite(b.qty) && b.qty > 0 && b.batch_id !== '')
  );
}

/** Kunci idempotensi dibuat sekali dan dibaca ulang dari form tiap POST; hanya diganti setelah penjualan berhasil, dan dipertahankan kalau pembayaran gagal. */
let kunci = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Mode lihat-saja hanya punya POST "Terapkan" saringan, jadi aksi transaksi tidak bisa masuk lewat request rakitan.
  const aksi = bolehTransaksi ? String(form.get('aksi') ?? '') : 'saring';

  kunci = String(form.get('idempotency_key') ?? '');
  keranjang = bacaKeranjang(form);
  cariIsi = String(form.get('cari') ?? '').trim();
  kategoriIsi = String(form.get('kategori') ?? '');
  pelangganDipilih = String(form.get('customer_id') ?? '');
  metode = String(form.get('payment_method') ?? 'cash');
  // Kanal asing diperlakukan sebagai toko karena nilainya menentukan harga dan backend menolaknya dengan galat yang tidak berarti bagi kasir.
  const kanalDikirim = String(form.get('sales_channel') ?? '');
  kanalIsi = (KANAL.find((k) => k.nilai === kanalDikirim)?.nilai ?? 'toko') as Kanal;
  // Shopee dipaksa e-wallet di server juga, supaya request rakitan tidak menyelundupkan Shopee dengan metode tunai (kembalian jadi tak bermakna).
  if (kanalIsi === 'shopee') metode = 'ewallet';
  ongkirIsi = String(form.get('shipping_cost') ?? '').trim();
  diskonIsi = String(form.get('discount_amount') ?? '').trim();
  dibayarIsi = String(form.get('amount_paid') ?? '').trim();
  commissionPersenIsi = String(form.get('platform_commission_fee_percent') ?? '').trim();
  servicePersenIsi = String(form.get('platform_service_fee_percent') ?? '').trim();

  const angka = (kolom: string): number | undefined => {
    const mentah = String(form.get(kolom) ?? '').trim();
    if (!mentah) return undefined;
    const nilai = Number(mentah);
    return Number.isFinite(nilai) ? nilai : undefined;
  };

  if (aksi === 'kosongkan') {
    keranjang = [];
    diskonIsi = '';
    dibayarIsi = '';
  } else if (aksi === 'pelanggan-baru') {
    const nama = String(form.get('pelanggan_nama') ?? '').trim();
    if (!nama) {
      galat = 'Nama pelanggan wajib diisi.';
    } else {
      try {
        const baru = await api<Customer>('/customers', {
          method: 'POST',
          token,
          body: { name: nama, phone: String(form.get('pelanggan_telepon') ?? '').trim() || undefined },
        });
        pelangganDipilih = baru.id;
        sukses = `Pelanggan "${baru.name ?? nama}" siap dipakai.`;
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan pelanggan.';
      }
    }
  } else if (aksi === 'bayar') {
    if (keranjang.length === 0) {
      galat = 'Keranjang masih kosong.';
    } else if (!kunci) {
      galat = 'Sesi kasir tidak valid. Muat ulang halaman.';
    } else {
      try {
        // Persen dikirim sebagai pecahan (0,1725 = 17,25%) dan `undefined` bila kosong, supaya tarif bawaan hanya didefinisikan di backend.
        const persenKomisi = angka('platform_commission_fee_percent');
        const persenLayanan = angka('platform_service_fee_percent');
        struk = await api<Transaction>('/transactions', {
          method: 'POST',
          token,
          headers: { 'Idempotency-Key': kunci },
          body: {
            customer_id: pelangganDipilih || undefined,
            payment_method: metode,
            sales_channel: kanalIsi,
            amount_paid: metode === 'cash' ? angka('amount_paid') : undefined,
            // Ongkir tidak dikirim untuk Shopee agar niatnya jelas dari isi request, bukan hanya dari validasi backend.
            shipping_cost: kanalIsi === 'shopee' ? undefined : angka('shipping_cost'),
            discount_amount: angka('discount_amount'),
            platform_commission_fee_percent:
              kanalIsi === 'shopee' && persenKomisi !== undefined ? persenKomisi / 100 : undefined,
            platform_service_fee_percent:
              kanalIsi === 'shopee' && persenLayanan !== undefined ? persenLayanan / 100 : undefined,
            items: keranjang.map((b) => ({
              product_id: b.product_id,
              qty: b.qty,
              batch_id: b.batch_id,
            })),
          },
        });

        // Ditangkap sebelum `pelangganDipilih` dikosongkan di bawah; lihat `strukPelangganId`.
        strukPelangganId = pelangganDipilih || null;

        // Penjualan selesai: meja kasir dikosongkan agar pembeli berikutnya tidak membayar belanjaan sebelumnya, saringan katalog sengaja tidak direset.
        keranjang = [];
        pelangganDipilih = '';
        ongkirIsi = '';
        diskonIsi = '';
        dibayarIsi = '';
        kunci = '';
        // Kanal sengaja tidak direset, karena pesanan marketplace dicatat berurutan dan kembali ke "Toko" diam-diam akan salah harga.
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan transaksi.';
      }
    }
  }
}

if (!kunci) kunci = crypto.randomUUID();

const kueri = new URLSearchParams({ scope: 'terjual', limit: '200' });
if (cariIsi) kueri.set('search', cariIsi);
if (kategoriIsi) kueri.set('category_id', kategoriIsi);

const [produk, kategori, semuaBatch, pelanggan] = await Promise.all([
  api<PaginatedProducts>(`/products?${kueri}`, { token }),
  api<Category[]>('/categories', { token }),
  // Satu permintaan untuk semua batch bersisa, bukan satu per produk (200 permintaan akan terasa sebelum barang pertama dipindai).
  api<ProductBatch[]>('/batches', { token }),
  bolehTransaksi
    ? api<PaginatedCustomers>('/customers?limit=200', { token }).then((h) => h.data)
    : Promise.resolve([] as Customer[]),
]);

/** Nama pelanggan untuk nota dicari dari daftar yang sama; `undefined` bila tak termuat di 200 teratas, agar nota diberi label umum, bukan "Walk-in". */
const strukPelanggan = strukPelangganId
  ? pelanggan.find((c) => c.id === strukPelangganId)
  : null;

/** Batch bersisa per produk, urut FEFO -- urutan yang sama dengan urutan keluarnya. */
const batchProduk = new Map<string, ProductBatch[]>();
for (const b of semuaBatch) {
  const daftar = batchProduk.get(b.product_id);
  if (daftar) daftar.push(b);
  else batchProduk.set(b.product_id, [b]);
}

// Barang habis tidak ditampilkan karena hanya memenuhi layar dengan yang tidak bisa dijual.
const barang = produk.data.filter((p) => p.stock_qty > 0);
const adaYangTerpotong = produk.total > produk.data.length;

/** Harga keranjang ditetapkan ulang dari katalog, bukan dipercaya dari form (harga di form milik kanal lama); baris yang tersaring keluar memakai harganya sendiri dan backend yang menagih. */
const hargaKatalog = new Map(produk.data.map((p) => [p.id, hargaDi(p, kanalIsi)]));
keranjang = keranjang.map((b) => ({ ...b, harga: hargaKatalog.get(b.product_id) ?? b.harga }));

/** Jumlah per batch, untuk mengisi ulang kolom di tiap baris batch. */
const jumlahBatch = new Map(keranjang.map((b) => [`${b.product_id}:${b.batch_id}`, b.qty]));

/** Jumlah per produk. Dipakai kartu: disorot atau tidak, dan berapa yang sudah dipilih. */
const jumlahProduk = new Map<string, number>();
for (const b of keranjang) {
  jumlahProduk.set(b.product_id, (jumlahProduk.get(b.product_id) ?? 0) + b.qty);
}

const totalItem = keranjang.reduce((n, b) => n + b.qty, 0);
const totalBelanja = keranjang.reduce((n, b) => n + b.harga * b.qty, 0);
// Ongkir tidak berlaku untuk Shopee: kolom disembunyikan dan nilai lama yang menyangkut tetap dipaksa nol di sini.
const ongkirAngka = kanalIsi === 'shopee' ? 0 : Math.max(0, Number(ongkirIsi) || 0);
// Diskon dijepit setinggi subtotal agar total di layar tidak negatif; backend yang menolak yang melebihi.
const diskonAngka = Math.min(totalBelanja, Math.max(0, Number(diskonIsi) || 0));

// Kosong jatuh ke tarif bawaan dan dijepit 0-100, sama seperti backend menjepit pecahan ke 0..1 (`pos::service::checkout`).
const jepitPersen = (isi: string, bawaan: number): number =>
  isi.trim() === '' ? bawaan : Math.min(100, Math.max(0, Number(isi) || bawaan));

const commissionPersenAngka = jepitPersen(commissionPersenIsi, SHOPEE_COMMISSION_PERSEN_DEFAULT);
const servicePersenAngka = jepitPersen(servicePersenIsi, SHOPEE_SERVICE_PERSEN_DEFAULT);

// Basis potongan Shopee adalah omzet setelah diskon, sama dengan `basis_fee` di `pos/service.rs`.
const basisFeeShopee = Math.max(0, totalBelanja - diskonAngka);
const biayaKomisiAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, commissionPersenAngka) : 0;
const biayaLayananAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, servicePersenAngka) : 0;
const biayaWithholdingTaxAngka =
  kanalIsi === 'shopee' ? biayaPersenRupiah(basisFeeShopee, SHOPEE_WITHHOLDING_TAX_PERSEN) : 0;
const biayaOrderProcessingAngka = kanalIsi === 'shopee' ? SHOPEE_ORDER_PROCESSING_FEE : 0;

// Untuk Shopee angka ini bukan yang dibayar pembeli melainkan setelah empat biaya platform, labelnya berganti ke "Estimasi Total Penghasilan"; rumusnya satu untuk semua kanal.
const totalTagihan =
  totalBelanja -
  diskonAngka +
  ongkirAngka -
  biayaKomisiAngka -
  biayaLayananAngka -
  biayaWithholdingTaxAngka -
  biayaOrderProcessingAngka;
const tunai = metode === 'cash';
const dibayarAngka = Number(dibayarIsi);
const adaDibayar = tunai && dibayarIsi !== '' && Number.isFinite(dibayarAngka);
const kurangBayar = adaDibayar && dibayarAngka < totalTagihan;

/** Baris panel keranjang dirender untuk semua (produk, batch) dan disembunyikan saat nol agar skrip tak merakit baris; `luar` menandai baris yang produknya tersaring keluar. */
interface BarisPanel {
  kunci: string;
  product_id: string;
  nama: string;
  harga: number;
  /** Harga baris di tiap kanal agar skrip bisa menghitung ulang saat kanal diganti; `null` untuk baris yang tersaring keluar, yang tetap memakai harga bawaannya. */
  hargaKanal: Record<Kanal, number> | null;
  batchLabel: string;
  qty: number;
  sisa: number;
  luar: boolean;
}

const diKatalog = new Set<string>();
const barisPanel: BarisPanel[] = [];

const labelBatch = (b: ProductBatch): string =>
  `Batch ${b.batch_number ?? 'tanpa nomor'} · ${b.expiry_date ? tanggal(b.expiry_date) : 'tanpa tanggal'}`;

/** Harga sebuah produk di seluruh kanal sekaligus, untuk atribut data-. */
const hargaSemuaKanal = (p: Product): Record<Kanal, number> => ({
  toko: hargaDi(p, 'toko'),
  shopee: hargaDi(p, 'shopee'),
  tiktok: hargaDi(p, 'tiktok'),
});

for (const p of barang) {
  for (const b of batchProduk.get(p.id) ?? []) {
    const kunciBaris = `${p.id}:${b.id}`;
    diKatalog.add(kunciBaris);
    barisPanel.push({
      kunci: kunciBaris,
      product_id: p.id,
      nama: p.name,
      harga: hargaDi(p, kanalIsi),
      hargaKanal: hargaSemuaKanal(p),
      batchLabel: labelBatch(b),
      qty: jumlahBatch.get(kunciBaris) ?? 0,
      sisa: b.remaining_qty,
      luar: false,
    });
  }
}

for (const b of keranjang) {
  const kunciBaris = `${b.product_id}:${b.batch_id}`;
  if (diKatalog.has(kunciBaris)) continue;
  const batch = semuaBatch.find((x) => x.id === b.batch_id);
  barisPanel.push({
    kunci: kunciBaris,
    product_id: b.product_id,
    nama: b.nama,
    harga: b.harga,
    hargaKanal: null,
    batchLabel: batch ? labelBatch(batch) : 'Batch di luar hasil saringan',
    qty: b.qty,
    // Tanpa batch di tangan, batas yang pasti benar hanya jumlah yang sudah diterima; backend tetap menolak bila sisanya sudah berkurang.
    sisa: batch ? batch.remaining_qty : b.qty,
    luar: true,
  });
}

const jenisProduk = jumlahProduk.size;
const barisTerpakai = keranjang.length;

const METODE = [
  { nilai: 'cash', label: 'Tunai' },
  { nilai: 'transfer', label: 'Transfer' },
  { nilai: 'ewallet', label: 'E-wallet' },
];

/** Nominal cepat untuk uang tunai. "Uang pas" dihitung skrip dari total berjalan. */
const NOMINAL = [50000, 100000, 200000, 500000];

/** Nama yang bisa dibaca untuk pelanggan yang namanya kosong di database. */
const namaPelanggan = (c: Customer): string => c.name ?? c.phone ?? '(tanpa nama)';

/** Sisa satu batch beserta peringatan kedaluwarsanya. */
function sisaBatch(b: ProductBatch): { label: string; mepet: boolean } {
  if (!b.expiry_date) return { label: `sisa ${b.remaining_qty} · tanpa tanggal`, mepet: false };
  const hari = sisaHari(b.expiry_date);
  return {
    label: `sisa ${b.remaining_qty} · ${tanggal(b.expiry_date)}${hari <= 30 ? ` · ${hari} hari lagi` : ''}`,
    mepet: hari <= 30,
  };
}

/** Rak produk urut FEFO tanpa pengulangan; sejak migrasi 0016 lokasi milik batch, jadi satu label tunggal bisa menyuruh pengepak ke rak yang salah. */
function lokasiProduk(daftar: ProductBatch[]): string {
  const rak = daftar.map((b) => b.storage_location).filter((l): l is string => !!l);
  return [...new Set(rak)].join(', ');
}

/** Ringkasan batch yang sudah dipilih, untuk kartu yang panelnya tertutup. */
function ringkasBatch(p: Product): string {
  return (batchProduk.get(p.id) ?? [])
    .map((b) => ({ b, qty: jumlahBatch.get(`${p.id}:${b.id}`) ?? 0 }))
    .filter((x) => x.qty > 0)
    .map((x) => `${x.b.batch_number ?? 'Tanpa nomor'} × ${x.qty}`)
    .join(', ');
}
---

<AppShell judul="Kasir" user={user}>
  <Galat pesan={galat} class="mb-4" />
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  {/* Satu layar satu form: katalog di kiri, keranjang dan pembayaran di kanan, sehingga isian yang dipakai menjual sama dengan yang dikirim dan tidak ada hidden field antar-langkah. */}
  <form
    method="POST"
    action="#struk"
    id="borang-kasir"
    data-transaksi={bolehTransaksi ? 'ya' : 'tidak'}
    class="flex flex-col gap-4 lg:h-[calc(100dvh-var(--tinggi-topbar)-3rem)] lg:flex-row lg:items-start"
  >
    <input type="hidden" name="idempotency_key" value={kunci} />

    {/* Di layar lebar form dipatok setinggi sisa layar (3rem = padding vertikal main) supaya halaman tak menggulung; yang menggulung hanya daftar produk dan panel keranjang. */}
    <section class="contents min-w-0 flex-1 lg:flex lg:h-full lg:flex-col">
      {/* Menempel di atas daftar supaya pencarian dan kategori tetap terjangkau saat katalog digulung; di ponsel section dibuat contents agar induk sticky-nya form, bukan section yang selesai sebelum keranjang. */}
      <div class="kartu sticky top-[calc(var(--tinggi-topbar)-0.5rem)] z-10 p-3! lg:static lg:mb-3 lg:shrink-0">
        <label class="sr-only" for="cari">Cari produk</label>
        <div class="flex flex-wrap gap-2">
          {/* Tombol submit pertama di form ini disengaja: Enter di kolom mana pun jatuh ke "terapkan saringan", satu-satunya aksi yang aman dipicu tak sengaja. */}
          <div class="relative max-w-md flex-1">
            <svg
              class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-[var(--color-teks-lembut)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              class="kolom w-full pl-9"
              id="cari"
              type="search"
              name="cari"
              value={cariIsi}
              placeholder="Cari nama atau SKU (tekan / )"
              aria-keyshortcuts="/"
              data-cari
            />
          </div>
          <button class="tombol-halus tanpa-js" type="submit" name="aksi" value="saring">
            Terapkan
          </button>
        </div>

        {kategori.length > 0 && (
          <div class="pil-gulung mt-3 flex gap-2 overflow-x-auto pb-1" data-pil-kategori>
            <label class={kategoriIsi ? 'pil-diam' : 'pil-aktif'}>
              <input class="sr-only" type="radio" name="kategori" value="" checked={!kategoriIsi} />
              Semua
            </label>
            {kategori.map((k) => (
              <label class={kategoriIsi === k.id ? 'pil-aktif' : 'pil-diam'}>
                <input
                  class="sr-only"
                  type="radio"
                  name="kategori"
                  value={k.id}
                  checked={kategoriIsi === k.id}
                />
                {k.name}
              </label>
            ))}
          </div>
        )}

      </div>

      {!bolehTransaksi && (
        <p class="isian-bantu mb-3">
          Mode lihat saja. Ukuran, lokasi rak, dan sisa tiap batch tampil di setiap barang.
        </p>
      )}

      {adaYangTerpotong && (
        <p class="mb-3 text-xs text-[var(--color-teks-lembut)]">
          Menampilkan 200 produk pertama. Pakai pencarian kalau yang dicari belum muncul.
        </p>
      )}

      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 lg:min-h-0 lg:flex-1 lg:auto-rows-min lg:content-start lg:overflow-y-auto tanpa-scrollbar pudar-tepi" data-daftar>
        {barang.map((p) => {
          const jumlah = jumlahProduk.get(p.id) ?? 0;
          const batches = batchProduk.get(p.id) ?? [];
          const ringkas = ringkasBatch(p);
          // Satu batch bersisa berarti tak ada yang perlu dipilih, jadi satu ketukan kartu langsung menambah 1 pack; pengepak tak berjualan dan tetap membuka dialog.
          const satuBatch = bolehTransaksi && batches.filter((b) => b.remaining_qty > 0).length === 1;
          return (
            <div
              class={jumlah > 0 ? 'kartu-produk-terpilih' : 'kartu-produk'}
              data-produk
              data-satu-batch={satuBatch ? '' : undefined}
              data-harga={hargaDi(p, kanalIsi)}
              data-harga-toko={hargaDi(p, 'toko')}
              data-harga-shopee={hargaDi(p, 'shopee')}
              data-harga-tiktok={hargaDi(p, 'tiktok')}
              data-nama={p.name.toLowerCase()}
              data-sku={(p.sku ?? '').toLowerCase()}
              data-kategori={p.category_id ?? ''}
            >
              {/* Dua versi blok info: tombol sungguhan untuk JS (bisa dicapai keyboard, tidak men-submit) dan teks biasa tanpa JS karena panel batch sudah terbuka di kartu. */}
              <button
                type="button"
                class="hanya-js block w-full text-left"
                data-ketuk-kartu
                aria-haspopup={satuBatch ? undefined : 'dialog'}
              >
                <span class="foto-produk aspect-[4/3] h-auto">
                  {/* `aspect-[4/3] h-auto` menjaga tinggi kartu seragam di semua lebar; `loading="lazy"` karena seluruh katalog dirender sekaligus dan penyaringan terjadi di browser. */}
                  {p.image_url && (
                    <img
                      src={fotoKecil(p.image_url)}
                      alt=""
                      width="480"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  )}
                  <span class="foto-sku">{p.sku ?? '—'}</span>
                  <span class="lencana-jumlah" data-lencana hidden={jumlah === 0}>
                    {jumlah}
                  </span>
                </span>
                <span class="block px-2.5 py-2">
                  <span class="block text-sm font-medium">
                    <span class="sr-only">{satuBatch ? 'Tambah 1 pack ' : 'Pilih batch untuk '}</span>{p.name}
                  </span>
                  <span class="block text-sm font-semibold tabular-nums" data-harga-tampil>
                    {rupiah(hargaDi(p, kanalIsi))}
                  </span>
                  {/* Diisi ulang skrip tiap jumlah berubah, supaya kartu dengan panel tertutup menunjukkan batch yang barusan dipilih. */}
                  <span class="block text-xs font-medium text-merah-700" data-ringkas-baris>
                    {ringkas}
                  </span>
                </span>
              </button>

              {satuBatch && (
                <button
                  type="button"
                  class="hanya-js tombol-info"
                  data-buka-batch
                  aria-haspopup="dialog"
                  aria-label={`Detail dan batch ${p.name}`}
                >
                  <span aria-hidden="true">i</span>
                </button>
              )}

              <div class="tanpa-js px-3 py-2.5">
                <span class="block text-sm font-medium">{p.name}</span>
                <span class="block text-xs text-[var(--color-teks-lembut)] tabular-nums">
                  {p.sku ?? '—'} · stok {p.stock_qty}
                </span>
                <span class="block text-sm font-semibold tabular-nums" data-harga-tampil>
                  {rupiah(hargaDi(p, kanalIsi))}
                </span>
              </div>

              {/* Satu dialog per kartu: atas detail produk, bawah batch yang diambil; tanpa JS tampil inline di kartu, dan pengepak (tanpa hak jual) hanya melihat stok per batch. */}
              <dialog class="panel-batch" data-panel-batch>
                <p class="hanya-js mb-2 text-sm font-semibold">{p.name}</p>

                <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
                  <dt class="text-[var(--color-teks-lembut)]">Ukuran</dt>
                  <dd>{p.variant_size ?? '—'}</dd>

                  <dt class="text-[var(--color-teks-lembut)]">Grade</dt>
                  <dd>{p.variant_grade ?? '—'}</dd>

                  <dt class="text-[var(--color-teks-lembut)]">Merek</dt>
                  <dd>{p.brand_name ?? '—'}</dd>

                  <dt class="text-[var(--color-teks-lembut)]">Lokasi</dt>
                  <dd>{lokasiProduk(batches) || '—'}</dd>

                  <dt class="text-[var(--color-teks-lembut)]">Stok</dt>
                  <dd class="tabular-nums">
                    {p.stock_qty} · {batches.length} batch
                  </dd>
                </dl>

                <p class="mb-1 mt-3 border-t border-[var(--color-garis-lembut)] pt-2 text-xs font-medium">
                  {bolehTransaksi ? 'Batch yang diambil' : 'Stok per batch'}
                </p>

                {batches.length === 0 && (
                  <p class="text-xs text-red-600">
                    {bolehTransaksi
                      ? 'Tidak ada batch bersisa. Barang ini tidak bisa dijual sampai kiriman barunya dicatat.'
                      : 'Tidak ada batch bersisa.'}
                  </p>
                )}

                {/* Kasir menyebut batch sendiri (FEFO di gudang bercampur tak bisa dipercaya); `product_id`/`nama`/`harga` ikut di tiap baris batch agar deret sejajar tak bergeser. */}
                {bolehTransaksi &&
                  batches.map((b) => {
                    const sisa = sisaBatch(b);
                    return (
                      <div class="baris-batch" data-baris-batch>
                        <input type="hidden" name="product_id" value={p.id} />
                        <input type="hidden" name="nama" value={p.name} />
                        <input type="hidden" name="harga" value={hargaDi(p, kanalIsi)} data-harga-kolom />
                        <input type="hidden" name="batch_id" value={b.id} />

                        <label class="min-h-11 min-w-0 flex-1 cursor-pointer text-xs" for={`qty-${p.id}-${b.id}`}>
                          <span class="block truncate font-medium">
                            {b.batch_number ?? 'Tanpa nomor'}
                          </span>
                          <span
                            class:list={[
                              'block tabular-nums',
                              sisa.mepet ? 'font-medium text-red-600' : 'text-[var(--color-teks-lembut)]',
                            ]}
                          >
                            {sisa.label}
                          </span>
                        </label>

                        <button
                          type="button"
                          class="tombol-bulat hanya-js"
                          data-kurang
                          aria-label={`Kurangi ${p.name} dari batch ${b.batch_number ?? 'tanpa nomor'}`}
                        >
                          −
                        </button>

                        {/* `max` = sisa batch ini, bukan stok produk, supaya kasir tidak mengetik jumlah yang baru ditolak saat pembayaran di depan pembeli. */}
                        <input
                          class="kolom w-16 shrink-0 text-center tabular-nums"
                          id={`qty-${p.id}-${b.id}`}
                          type="number"
                          inputmode="numeric"
                          name="qty"
                          min="0"
                          max={b.remaining_qty}
                          value={jumlahBatch.get(`${p.id}:${b.id}`) ?? 0}
                          data-qty
                          data-sisa={b.remaining_qty}
                          data-batch={b.batch_number ?? 'Tanpa nomor'}
                        />

                        <button
                          type="button"
                          class="tombol-bulat hanya-js"
                          data-tambah
                          aria-label={`Tambah ${p.name} dari batch ${b.batch_number ?? 'tanpa nomor'}`}
                        >
                          +
                        </button>
                      </div>
                    );
                  })}

                {!bolehTransaksi && batches.length > 0 && (
                  <ul class="space-y-0.5 text-xs">
                    {batches.map((b) => {
                      const sisa = sisaBatch(b);
                      return (
                        <li class="flex flex-wrap justify-between gap-x-2">
                          <span>
                            {b.batch_number ?? 'Tanpa nomor'}
                            {b.storage_location && (
                              <span class="text-[var(--color-teks-lembut)]"> · {b.storage_location}</span>
                            )}
                          </span>
                          <span class:list={['tabular-nums', sisa.mepet ? 'font-medium text-red-600' : '']}>
                            {sisa.label}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                )}

                {/* Hanya berarti saat panel jadi pop up, karena kartu beserta ringkasannya tertutup di belakang backdrop. */}
                <div class="hanya-js mt-3 flex items-center gap-3">
                  {bolehTransaksi && (
                    <span class="text-sm text-[var(--color-teks-lembut)]">
                      Total <span class="font-semibold tabular-nums" data-total-batch>0</span>
                    </span>
                  )}
                  <button type="button" class="tombol-utama ml-auto" data-tutup-batch>
                    {bolehTransaksi ? 'Selesai' : 'Tutup'}
                  </button>
                </div>
              </dialog>
            </div>
          );
        })}

        {barang.length === 0 && (
          <p class="kartu col-span-full text-center text-[var(--color-teks-lembut)]">
            Tidak ada produk yang bisa dijual.
          </p>
        )}
      </div>

      <p class="mt-4 hidden text-center text-sm text-[var(--color-teks-lembut)]" data-kosong-saringan>
        Tidak ada produk yang cocok dengan pencarian ini.
      </p>

    </section>

    {bolehTransaksi && (
      <aside class="panel-kasir tanpa-scrollbar" id="keranjang">
        <div class="kartu-rapat">
          <div class="kepala-panel">
            <span>Keranjang</span>
            <span class="tabular-nums" data-ringkas-item>
              {barisTerpakai > 0
                ? `${jenisProduk} produk · ${barisTerpakai} baris batch · ${totalItem} pack`
                : 'Keranjang kosong'}
            </span>
          </div>

          <div class="flex flex-col gap-2 border-b border-[var(--color-garis-lembut)] px-4 py-3">
            <div class="flex items-center gap-2">
              <label class="shrink-0 text-xs text-[var(--color-teks-lembut)]" for="customer_id">
                Pelanggan
              </label>
              <select class="kolom min-w-0 flex-1" id="customer_id" name="customer_id">
                <option value="" selected={!pelangganDipilih}>Tidak ada (Walk-in)</option>
                {pelanggan.map((c) => (
                  <option value={c.id} selected={pelangganDipilih === c.id}>
                    {namaPelanggan(c)}
                    {c.phone ? ` · ${c.phone}` : ''}
                  </option>
                ))}
              </select>
            </div>

            {/* Pelanggan baru dibuat lewat POST ke halaman ini (bukan form terpisah) agar keranjang di form yang sama tidak perlu disalin; nama tanpa `required` supaya tidak menahan "Selesaikan". */}
            <details>
              <summary class="flex min-h-11 cursor-pointer list-none items-center text-xs font-semibold text-merah-700">
                ＋ Tambah pelanggan baru
              </summary>
              <div class="mt-2 flex flex-col gap-2 rounded-lg border border-merah-200 bg-merah-50 p-2.5">
                <input
                  class="kolom"
                  name="pelanggan_nama"
                  aria-label="Nama pelanggan baru"
                  placeholder="Nama pelanggan"
                />
                <input
                  class="kolom"
                  name="pelanggan_telepon"
                  type="tel"
                  aria-label="Nomor telepon pelanggan baru"
                  placeholder="No. telepon (opsional)"
                />
                <p class="text-xs text-[var(--color-teks-lembut)]">
                  Nomor yang sudah pernah dicatat memakai pelanggan lama, bukan dibuat ganda.
                </p>
                <button class="tombol-halus" type="submit" name="aksi" value="pelanggan-baru">
                  Simpan pelanggan
                </button>
              </div>
            </details>
          </div>

          

          <div>
            {barisPanel.map((r) => (
              <div
                class="baris-keranjang"
                data-baris-keranjang
                data-kolom={`qty-${r.kunci.replace(':', '-')}`}
                data-pid={r.product_id}
                data-harga={r.harga}
                data-harga-toko={r.hargaKanal?.toko}
                data-harga-shopee={r.hargaKanal?.shopee}
                data-harga-tiktok={r.hargaKanal?.tiktok}
                hidden={r.qty === 0}
              >
                <span class="col-span-2 text-sm font-medium">{r.nama}</span>
                <span class="col-span-2 text-xs font-medium text-merah-700">{r.batchLabel}</span>
                <span class="self-center text-xs tabular-nums text-[var(--color-teks-lembut)]">
                  <span data-qty-teks>{r.qty}</span> × <span data-harga-satuan>{rupiah(r.harga)}</span>
                </span>
                <div class="flex flex-wrap items-center justify-end gap-2">
                  {/* Baris yang tersaring keluar membawa isian keranjangnya sendiri, kalau tidak barang terpilih hilang diam-diam saat saringan dikirim ke server. */}
                  {r.luar && (
                    <Fragment>
                      <input type="hidden" name="product_id" value={r.product_id} />
                      <input type="hidden" name="nama" value={r.nama} />
                      <input type="hidden" name="harga" value={r.harga} />
                      <input type="hidden" name="batch_id" value={r.kunci.split(':')[1]} />
                    </Fragment>
                  )}

                  <button
                    type="button"
                    class="tombol-bulat hanya-js"
                    data-kurang-keranjang
                    aria-label={`Kurangi ${r.nama}`}
                  >
                    −
                  </button>

                  {r.luar ? (
                    <input
                      class="kolom w-16 shrink-0 text-center tabular-nums"
                      id={`qty-${r.kunci.replace(':', '-')}`}
                      type="number"
                      inputmode="numeric"
                      name="qty"
                      min="0"
                      max={r.sisa}
                      value={r.qty}
                      aria-label={`Jumlah ${r.nama}`}
                      data-qty-luar
                      data-sisa={r.sisa}
                    />
                  ) : (
                    <span class="min-w-6 text-center text-base font-bold tabular-nums" data-qty-teks>
                      {r.qty}
                    </span>
                  )}

                  <button
                    type="button"
                    class="tombol-bulat hanya-js"
                    data-tambah-keranjang
                    aria-label={`Tambah ${r.nama}`}
                  >
                    +
                  </button>

                  <span class="min-w-20 text-right text-sm font-bold tabular-nums" data-subtotal-baris>
                    {rupiah(r.harga * r.qty)}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="kartu flex flex-col gap-4 p-4">
          {/* Kanal ditaruh paling atas di panel pembayaran karena menentukan semua harga di bawahnya. */}
          <div>
            <p class="label">Kanal penjualan</p>
            <div class="flex flex-wrap gap-2">
              {KANAL.map((k) => (
                <label class="pil-diam cursor-pointer has-[:checked]:border-merah-600 has-[:checked]:bg-merah-600 has-[:checked]:text-white">
                  <input
                    class="sr-only"
                    type="radio"
                    name="sales_channel"
                    value={k.nilai}
                    checked={kanalIsi === k.nilai}
                    data-kanal
                  />
                  {k.label}
                </label>
              ))}
            </div>
          </div>

          {/* Selalu dirender agar ganti kanal tanpa reload tetap memunculkannya; dua kolom komisi dan layanan mengikuti pemisahan `get_escrow_detail` Shopee. */}
          <div
            class:list={['grid gap-3 sm:grid-cols-2', kanalIsi === 'shopee' ? '' : 'hidden']}
            data-blok-commission-fee
          >
            <div>
              <label class="label" for="platform_commission_fee_percent">Biaya Komisi Shopee (%)</label>
              <input
                class="kolom tabular-nums"
                id="platform_commission_fee_percent"
                name="platform_commission_fee_percent"
                type="number"
                min="0"
                max="100"
                step="0.01"
                value={commissionPersenIsi}
                placeholder={String(SHOPEE_COMMISSION_PERSEN_DEFAULT)}
                data-commission-fee
              />
              </div>
            <div>
              <label class="label" for="platform_service_fee_percent">Biaya Layanan Shopee (%)</label>
              <input
                class="kolom tabular-nums"
                id="platform_service_fee_percent"
                name="platform_service_fee_percent"
                type="number"
                min="0"
                max="100"
                step="0.01"
                value={servicePersenIsi}
                placeholder={String(SHOPEE_SERVICE_PERSEN_DEFAULT)}
                data-service-fee
              />
            </div>
          </div>

          <div>
            <p class="label">Metode pembayaran</p>
            <div
              class:list={['flex flex-wrap gap-2', kanalIsi === 'shopee' ? 'hidden' : '']}
              data-blok-metode-pilihan
            >
              {METODE.map((m) => (
                <label class="pil-diam cursor-pointer has-[:checked]:border-merah-600 has-[:checked]:bg-merah-600 has-[:checked]:text-white">
                  <input
                    class="sr-only"
                    type="radio"
                    name="payment_method"
                    value={m.nilai}
                    checked={metode === m.nilai}
                    data-metode
                  />
                  {m.label}
                </label>
              ))}
            </div>
            {/* Metode Shopee bukan pilihan: radio tetap di DOM (disembunyikan) dan `syncMetodeShopee` memaksa "E-wallet"; jangan tambah `inline-block` di `pil-aktif` karena menimpa `hidden`. */}
            <p
              class:list={['pil-aktif', kanalIsi === 'shopee' ? '' : 'hidden']}
              data-blok-metode-shopee
            >
              ShopeePay
            </p>
          </div>

          {/* Ongkir dan diskon jarang dipakai di penjualan toko, jadi dilipat; tetap di DOM (ikut terkirim) dan terbuka sendiri bila sudah terisi. */}
          <details open={Boolean(ongkirIsi || diskonIsi)}>
            <summary class="flex min-h-11 cursor-pointer list-none items-center text-xs font-semibold text-merah-700">
              ＋ Ongkos kirim dan diskon
            </summary>
            <div class="grid gap-3 pb-1 sm:grid-cols-2">
            {/* Tidak berlaku untuk Shopee; disembunyikan, bukan dihapus dari DOM, supaya skrip tetap bisa membaca atau mengosongkan nilainya. */}
            <div class:list={[kanalIsi === 'shopee' ? 'hidden' : '']} data-blok-ongkir>
              <label class="label" for="shipping_cost">Ongkos kirim (Rp)</label>
              <input
                class="kolom tabular-nums"
                id="shipping_cost"
                name="shipping_cost"
                type="number"
                min="0"
                step="1"
                value={ongkirIsi}
                placeholder="0"
                data-ongkir
              />
            </div>

            <div>
              <label class="label" for="discount_amount">Diskon (Rp)</label>
              <input
                class="kolom tabular-nums"
                id="discount_amount"
                name="discount_amount"
                type="number"
                min="0"
                step="1"
                value={diskonIsi}
                placeholder="0"
                data-diskon
              />
            </div>
            </div>
          </details>

          {/* Shopee tidak butuh ini karena uangnya sudah diterima penuh lewat ShopeePay, jadi disembunyikan seluruhnya. */}
          <div>
            <div class:list={[kanalIsi === 'shopee' ? 'hidden' : '']} data-blok-dibayar>
              <label class="label" for="amount_paid">Uang diterima (tunai)</label>
              <input
                class="kolom tabular-nums"
                id="amount_paid"
                name="amount_paid"
                type="number"
                min="0"
                step="1"
                value={dibayarIsi}
                placeholder="0"
                disabled={!tunai}
                data-dibayar
              />
            </div>
          </div>

          {/* Nominal cepat hanya berguna dengan JS dan memakai total berjalan (ongkir bisa berubah setelah muat); disembunyikan juga untuk Shopee. */}
          <div
            class:list={['hanya-js flex flex-wrap gap-2', kanalIsi === 'shopee' ? 'hidden' : '']}
            data-cepat
          >
            <button type="button" class="pil-diam" data-uang-pas>Uang pas</button>
            {NOMINAL.map((n) => (
              <button type="button" class="pil-diam tabular-nums" data-nominal={n}>
                {new Intl.NumberFormat('id-ID').format(n)}
              </button>
            ))}
          </div>

          <div class="flex flex-col gap-2 text-sm">
            <div class="flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]">
              <span>Subtotal barang</span>
              <span class="tabular-nums text-[var(--color-teks)]" data-subtotal>
                {rupiah(totalBelanja)}
              </span>
            </div>
            {/* Selalu dirender dan disembunyikan saat nol, supaya baris baru tidak menggeser angka Total saat kasir membacanya. */}
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                diskonAngka > 0 ? '' : 'hidden',
              ]}
              data-baris-diskon
            >
              <span>Diskon</span>
              <span class="tabular-nums text-merah-700" data-diskon-tampil>
                -{rupiah(diskonAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? 'hidden' : '',
              ]}
              data-baris-ongkir
            >
              <span>Ongkos kirim</span>
              <span class="tabular-nums text-[var(--color-teks)]" data-ongkir-tampil>
                {rupiah(ongkirAngka)}
              </span>
            </div>
            {/* Keempat biaya mengurangi Total untuk Shopee karena kasir mencatat pesanan yang uangnya sudah diterima, jadi yang relevan adalah yang cair ke toko; nama field mengikuti `get_escrow_detail`. */}
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-komisi
            >
              <span>Biaya Komisi (<span data-biaya-komisi-persen>{commissionPersenAngka}</span>%)</span>
              <span class="tabular-nums text-merah-700" data-biaya-komisi-tampil>
                -{rupiah(biayaKomisiAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-layanan
            >
              <span>Biaya Layanan (<span data-biaya-layanan-persen>{servicePersenAngka}</span>%)</span>
