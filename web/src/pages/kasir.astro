---
import AppShell from '../layouts/AppShell.astro';
import {
  api,
  ApiRequestError,
  type Category,
  type Customer,
  type PaginatedCustomers,
  type PaginatedProducts,
  type ProductBatch,
  type Transaction,
} from '../lib/api';
import { rupiah, tanggal } from '../lib/format';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

/**
 * Pengepak membuka halaman ini untuk MEMBACA detail produk -- ukuran, harga,
 * rak, dan sisa tiap batch -- bukan untuk menjual. Seluruh kendali transaksi
 * tidak dirender untuknya.
 *
 * Yang benar-benar menahan penjualan bukan flag ini, melainkan backend:
 * `POST /transactions` menolak peran pengepak. Flag ini hanya menjaga agar
 * layarnya tidak menawarkan sesuatu yang pasti ditolak.
 */
const bolehTransaksi = user.role !== 'pengepak';

/**
 * Satu baris keranjang: SATU BATCH dari satu produk.
 *
 * Membeli 5 butir yang fisiknya diambil dari dua kiriman berbeda menghasilkan
 * dua baris, dan itu memang yang benar -- backend menggabungkannya per
 * (produk, batch), lalu mencatat tiap batch yang keluar di ledger stok.
 *
 * `nama` dan `harga` ikut dibawa HANYA untuk ditampilkan di langkah 2 tanpa
 * query kedua. Server tidak pernah mempercayainya: harga ditetapkan ulang
 * dari baris produk yang dikunci saat checkout, jadi mengubah nilai ini lewat
 * DevTools paling jauh membuat ringkasan di layar berbeda dari struknya.
 */
interface BarisKeranjang {
  product_id: string;
  qty: number;
  nama: string;
  harga: number;
  /**
   * Batch yang dipilih kasir. Wajib terisi: sejak kasir memilih sendiri,
   * tidak ada lagi baris yang diserahkan ke FEFO.
   */
  batch_id: string;
}

let langkah: 1 | 2 | 3 = 1;
let galat: string | null = null;
let sukses: string | null = null;
let struk: Transaction | null = null;
let keranjang: BarisKeranjang[] = [];

// Nilai isian langkah 2, diisi ulang saat pembayaran gagal supaya kasir tidak
// perlu mengetik semuanya dari awal.
let pelangganDipilih = '';
let metode = 'cash';
let ongkirIsi = '';
let dibayarIsi = '';
let cariIsi = '';
let kategoriIsi = '';

/**
 * Keranjang dibaca dari pasangan field berulang. Bentuk ini sengaja sama
 * dengan yang sudah dipakai halaman ini sebelumnya, jadi satu pembacaan
 * melayani perpindahan antar-langkah maupun checkout.
 */
function bacaKeranjang(form: FormData): BarisKeranjang[] {
  const ids = form.getAll('product_id');
  const qty = form.getAll('qty');
  const nama = form.getAll('nama');
  const harga = form.getAll('harga');
  const batch = form.getAll('batch_id');

  return (
    ids
      .map((id, i) => ({
        product_id: String(id),
        qty: Number(qty[i] ?? 0),
        nama: String(nama[i] ?? ''),
        harga: Number(harga[i] ?? 0),
        batch_id: String(batch[i] ?? ''),
      }))
      // Baris tanpa batch dibuang, bukan dikirim sebagai "terserah FEFO".
      // Halaman ini selalu merender `batch_id` bersama `qty`-nya, jadi baris
      // begitu hanya bisa datang dari request rakitan -- dan menerimanya
      // berarti mengeluarkan barang dari kiriman yang tidak pernah dipilih
      // siapa pun.
      .filter((b) => Number.isFinite(b.qty) && b.qty > 0 && b.batch_id !== '')
  );
}

/**
 * Kunci idempotensi. Dibuat sekali saat halaman dibuka, lalu dibawa hidden
 * melewati seluruh langkah dan DIBACA ULANG dari form -- tidak pernah dibuat
 * ulang. Kalau dibuat ulang tiap render, penjagaan kirim-dua-kali hilang;
 * kalau dipakai lagi setelah berhasil, transaksi lama yang dikembalikan.
 * "Penjualan baru" di langkah 3 adalah tautan GET, jadi kuncinya segar.
 */
let kunci = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Di mode lihat-saja satu-satunya POST yang mungkin adalah tombol
  // "Terapkan" pada saringan. Apa pun yang dikirim diperlakukan sebagai itu,
  // jadi tidak ada aksi transaksi yang bisa masuk lewat request rakitan.
  const aksi = bolehTransaksi ? String(form.get('aksi') ?? '') : 'saring';

  kunci = String(form.get('idempotency_key') ?? '');
  keranjang = bacaKeranjang(form);
  cariIsi = String(form.get('cari') ?? '').trim();
  kategoriIsi = String(form.get('kategori') ?? '');

  const angka = (kolom: string): number | undefined => {
    const mentah = String(form.get(kolom) ?? '').trim();
    if (!mentah) return undefined;
    const nilai = Number(mentah);
    return Number.isFinite(nilai) ? nilai : undefined;
  };

  if (aksi === 'lanjut') {
    if (keranjang.length === 0) {
      galat = 'Keranjang masih kosong.';
    } else {
      langkah = 2;
    }
  } else if (aksi === 'saring' || aksi === 'kembali') {
    // Keduanya kembali ke langkah 1 dengan keranjang utuh. `saring` hanya
    // dipakai saat JavaScript mati -- dengan JS, penyaringan terjadi di
    // tempat tanpa memuat ulang.
    langkah = 1;
  } else if (aksi === 'pelanggan-baru' || aksi === 'bayar') {
    langkah = 2;
    pelangganDipilih = String(form.get('customer_id') ?? '');
    metode = String(form.get('payment_method') ?? 'cash');
    ongkirIsi = String(form.get('shipping_cost') ?? '').trim();
    dibayarIsi = String(form.get('amount_paid') ?? '').trim();

    if (aksi === 'pelanggan-baru') {
      const nama = String(form.get('pelanggan_nama') ?? '').trim();
      if (!nama) {
        galat = 'Nama pelanggan wajib diisi.';
      } else {
        try {
          const baru = await api<Customer>('/customers', {
            method: 'POST',
            token,
            body: { name: nama, phone: String(form.get('pelanggan_telepon') ?? '').trim() || undefined },
          });
          pelangganDipilih = baru.id;
          sukses = `Pelanggan "${baru.name ?? nama}" siap dipakai.`;
        } catch (err) {
          galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan pelanggan.';
        }
      }
    } else if (keranjang.length === 0) {
      galat = 'Keranjang masih kosong.';
      langkah = 1;
    } else if (!kunci) {
      galat = 'Sesi kasir tidak valid. Muat ulang halaman.';
    } else {
      try {
        struk = await api<Transaction>('/transactions', {
          method: 'POST',
          token,
          headers: { 'Idempotency-Key': kunci },
          body: {
            customer_id: pelangganDipilih || undefined,
            payment_method: metode,
            amount_paid: metode === 'cash' ? angka('amount_paid') : undefined,
            shipping_cost: angka('shipping_cost'),
            items: keranjang.map((b) => ({
              product_id: b.product_id,
              qty: b.qty,
              // Kosong dikirim sebagai `undefined`, bukan string kosong:
              // backend membedakan "kasir memilih batch ini" dari "terserah
              // FEFO", dan string kosong bukan UUID mana pun.
              batch_id: b.batch_id || undefined,
            })),
          },
        });
        langkah = 3;
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan transaksi.';
      }
    }
  }
}

if (!kunci) kunci = crypto.randomUUID();

// Hanya yang dibutuhkan langkah yang sedang dirender yang diambil.
let produk: PaginatedProducts | null = null;
/** Batch bersisa per produk, urut FEFO. Hanya terisi di langkah 1. */
const batchProduk = new Map<string, ProductBatch[]>();
let kategori: Category[] = [];
let pelanggan: Customer[] = [];

if (langkah === 1) {
  const kueri = new URLSearchParams({ scope: 'terjual', limit: '200' });
  if (cariIsi) kueri.set('search', cariIsi);
  if (kategoriIsi) kueri.set('category_id', kategoriIsi);

  let semuaBatch: ProductBatch[];
  [produk, kategori, semuaBatch] = await Promise.all([
    api<PaginatedProducts>(`/products?${kueri}`, { token }),
    api<Category[]>('/categories', { token }),
    // Satu permintaan untuk seluruh batch yang masih bersisa, bukan satu
    // per produk: daftar kasir bisa berisi 200 baris, dan 200 permintaan
    // untuk mengisi 200 dropdown akan terasa sebelum barang pertama dipindai.
    api<ProductBatch[]>('/batches', { token }),
  ]);

  // Urutan dari backend sudah FEFO, dan pengelompokan ini menjaganya.
  for (const b of semuaBatch) {
    const daftar = batchProduk.get(b.product_id);
    if (daftar) daftar.push(b);
    else batchProduk.set(b.product_id, [b]);
  }
} else if (langkah === 2) {
  pelanggan = (await api<PaginatedCustomers>('/customers?limit=200', { token })).data;
}

// Barang habis tidak ditampilkan sama sekali: barisnya hanya memenuhi layar
// dengan sesuatu yang tidak bisa dijual.
const barang = (produk?.data ?? []).filter((p) => p.stock_qty > 0);
const adaYangTerpotong = produk !== null && produk.total > produk.data.length;

/** Jumlah per batch, untuk mengisi ulang kolom di tiap baris batch. */
const jumlahBatch = new Map(keranjang.map((b) => [`${b.product_id}:${b.batch_id}`, b.qty]));

/**
 * Jumlah per produk. Dipakai kartu (disorot atau tidak, berapa yang sudah
 * dipilih) dan ringkasan langkah 2 -- pembeli membeli barang, bukan kiriman,
 * jadi di luar pemilihan batch angka yang berarti adalah angka per produk.
 */
const jumlahProduk = new Map<string, number>();
/** Nama dan harga per produk, ikut dari baris mana pun milik produk itu. */
const produkKeranjang = new Map<string, { nama: string; harga: number }>();
for (const b of keranjang) {
  jumlahProduk.set(b.product_id, (jumlahProduk.get(b.product_id) ?? 0) + b.qty);
  if (!produkKeranjang.has(b.product_id)) {
    produkKeranjang.set(b.product_id, { nama: b.nama, harga: b.harga });
  }
}

/** Ringkasan langkah 2 dan 3: satu baris per produk, bukan per batch. */
const ringkasan = [...jumlahProduk].map(([product_id, qty]) => ({
  product_id,
  qty,
  nama: produkKeranjang.get(product_id)?.nama ?? '',
  harga: produkKeranjang.get(product_id)?.harga ?? 0,
}));

const totalItem = keranjang.reduce((n, b) => n + b.qty, 0);
const totalBelanja = keranjang.reduce((n, b) => n + b.harga * b.qty, 0);

// Ongkir ikut dihitung DI SINI, bukan hanya di skrip langkah 2. Tanpa ini
// angka "Total" yang dirender server adalah subtotal tanpa ongkir -- benar
// saat langkah 2 pertama kali dibuka (ongkir masih kosong), tapi salah
// begitu pembayaran gagal dan form terisi ulang dengan ongkir yang sudah
// diketik. Angka total yang salah di layar kasir berarti salah tagih.
const ongkirAngka = Math.max(0, Number(ongkirIsi) || 0);
const totalTagihan = totalBelanja + ongkirAngka;

const LANGKAH = [
  { n: 1, label: 'Pilih produk' },
  { n: 2, label: 'Pembayaran' },
  { n: 3, label: 'Selesai' },
];

const METODE = [
  { nilai: 'cash', label: 'Tunai' },
  { nilai: 'transfer', label: 'Transfer' },
  { nilai: 'ewallet', label: 'E-wallet' },
];

/** Nama yang bisa dibaca untuk pelanggan yang namanya kosong di database. */
const namaPelanggan = (c: Customer): string => c.name ?? c.phone ?? '(tanpa nama)';
---

<AppShell judul="Kasir" user={user}>
  {/* Penunjuk langkah. Angkanya tetap ditulis, bukan hanya warna. */}
  <ol
    class:list={['mb-5 items-center justify-center gap-2', bolehTransaksi ? 'flex' : 'hidden']}
    aria-label="Langkah transaksi"
  >
    {
      LANGKAH.map((l, i) => (
        <li class="flex items-center gap-2">
          <div class="flex flex-col items-center gap-1">
            <span
              class={
                langkah === l.n
                  ? 'langkah-aktif'
                  : langkah > l.n
                    ? 'langkah-selesai'
                    : 'langkah'
              }
              aria-current={langkah === l.n ? 'step' : undefined}
            >
              {langkah > l.n ? '✓' : l.n}
            </span>
            <span class="text-xs text-[var(--color-teks-lembut)]">{l.label}</span>
          </div>
          {i < LANGKAH.length - 1 && (
            <span
              class={langkah > l.n ? 'langkah-penghubung-lewat' : 'langkah-penghubung'}
              aria-hidden="true"
            />
          )}
        </li>
      ))
    }
  </ol>

  {galat && <p class="galat mb-4" role="alert">{galat}</p>}
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  {/* ================================================================= */}
  {/* Langkah 1 — pilih produk                                          */}
  {/* ================================================================= */}
  {
    langkah === 1 && (
      <form method="POST" id="borang-kasir" data-transaksi={bolehTransaksi ? 'ya' : 'tidak'}>
        <input type="hidden" name="idempotency_key" value={kunci} />

        {/* Saringan ikut di dalam form yang sama, bukan form GET terpisah:
            keranjang hidup di hidden field, dan navigasi GET akan
            membuangnya. Konsekuensinya keadaan saringan tidak ada di URL --
            pengecualian sadar dari prinsip 4, karena keranjang setengah jadi
            memang bukan sesuatu yang bisa di-bookmark. */}
        <div class="kartu mb-4">
          <label class="label" for="cari">Cari produk</label>
          <div class="flex flex-wrap gap-2">
            <input
              class="kolom max-w-md flex-1"
              id="cari"
              type="search"
              name="cari"
              value={cariIsi}
              placeholder="Nama atau SKU..."
              data-cari
            />
            <button class="tombol-halus tanpa-js" type="submit" name="aksi" value="saring">
              Terapkan
            </button>
          </div>

          {kategori.length > 0 && (
            <div class="mt-3 flex gap-2 overflow-x-auto pb-1" data-pil-kategori>
              <label class={kategoriIsi ? 'pil-diam' : 'pil-aktif'}>
                <input
                  class="sr-only"
                  type="radio"
                  name="kategori"
                  value=""
                  checked={!kategoriIsi}
                />
                Semua
              </label>
              {kategori.map((k) => (
                <label class={kategoriIsi === k.id ? 'pil-aktif' : 'pil-diam'}>
                  <input
                    class="sr-only"
                    type="radio"
                    name="kategori"
                    value={k.id}
                    checked={kategoriIsi === k.id}
                  />
                  {k.name}
                </label>
              ))}
            </div>
          )}

          {bolehTransaksi ? (
            <p class="isian-bantu tanpa-js">
              Isi jumlah pada batch yang barangnya benar-benar kamu ambil, lalu tekan
              "Lanjut ke pembayaran".
            </p>
          ) : (
            <p class="isian-bantu">
              Mode lihat saja. Buka "Detail" pada tiap barang untuk melihat ukuran,
              harga, lokasi rak, dan sisa tiap batch.
            </p>
          )}
        </div>

        {adaYangTerpotong && (
          <p class="mb-3 text-xs text-[var(--color-teks-lembut)]">
            Menampilkan 200 produk pertama. Pakai pencarian kalau yang dicari belum muncul.
          </p>
        )}

        {/* Satu kolom di ponsel, dua di tablet, tiga di monitor lebar.
            Satu kolom penuh di layar lebar berarti kasir menggulung
            berlembar-lembar untuk daftar yang sebenarnya muat sekali lihat. */}
        <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3" data-daftar>
          {barang.map((p) => {
            const jumlah = jumlahProduk.get(p.id) ?? 0;
            const batches = batchProduk.get(p.id) ?? [];
            return (
              <div
                class={jumlah > 0 ? 'baris-produk-terpilih' : 'baris-produk'}
                data-produk
                data-harga={p.price}
                data-nama={p.name.toLowerCase()}
                data-sku={(p.sku ?? '').toLowerCase()}
                data-kategori={p.category_id ?? ''}
              >
                {/* Dua versi blok informasi. Yang bisa diketuk adalah tombol
                    sungguhan (bisa dicapai keyboard, tidak men-submit); yang
                    tanpa JS adalah teks biasa. Hanya satu yang terlihat.

                    Keduanya `basis-full`: nama barang mendapat SATU BARIS
                    PENUH untuk dirinya sendiri, dan kendali jumlah turun ke
                    baris kedua. Sebaris dengan −/+ dan kolom angka, nama
                    hanya kebagian sisa ~130px di sel grid selebar 300px, dan
                    "Ceker Bersih Super Besar" terpotong jadi "Ceker Bers…" --
                    kasir tidak bisa memastikan barang mana yang ditambahnya.
                    Nama tetap `truncate` sebagai jaring terakhir. */}
                <button
                  type="button"
                  class="hanya-js min-w-0 basis-full text-left"
                  data-buka-batch
                  aria-haspopup="dialog"
                >
                  <span class="block truncate text-sm font-medium">{p.name}</span>
                  <span class="block text-xs text-[var(--color-teks-lembut)]">
                    {p.sku ?? '—'} · Stok: {p.stock_qty}
                  </span>
                  <span class="block text-sm font-semibold">{rupiah(p.price)}</span>
                  {/* Diisi ulang skrip tiap kali jumlah berubah. Tanpa baris
                      ini, kartu yang tertutup tidak memberi tahu batch mana
                      yang barusan dipilih -- satu-satunya petunjuknya cuma
                      warna tepi kartu. */}
                  <span class="block text-xs text-merah-700" data-ringkas-baris />
                </button>

                <div class="tanpa-js min-w-0 basis-full">
                  <span class="block truncate text-sm font-medium">{p.name}</span>
                  <span class="block text-xs text-[var(--color-teks-lembut)]">
                    {p.sku ?? '—'} · Stok: {p.stock_qty}
                  </span>
                  <span class="block text-sm font-semibold">{rupiah(p.price)}</span>
                </div>

                {/* Detail produk, untuk peran mana pun yang bisa membuka
                    halaman ini. <details> native: terbuka tanpa JavaScript,
                    dan <summary> bukan kendali submit, jadi aman berada di
                    dalam form yang sedang memegang keranjang.

                    Datanya sudah ada di halaman -- produk dari /products,
                    batch dari /batches yang sama yang mengisi dropdown di
                    bawah. Tidak ada permintaan tambahan per kartu, dan tidak
                    ada daftar batch kedua yang bisa menyimpang dari yang
                    dipakai saat menjual. */}
                <details class="basis-full border-t border-[var(--color-garis)] pt-2">
                  <summary class="cursor-pointer text-xs font-medium text-[var(--color-teks-lembut)] hover:text-merah-700">
                    Detail
                  </summary>

                  <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
                    <dt class="text-[var(--color-teks-lembut)]">Nama</dt>
                    <dd class="min-w-0 break-words">{p.name}</dd>

                    <dt class="text-[var(--color-teks-lembut)]">Ukuran</dt>
                    <dd>{p.variant_size ?? '—'}</dd>

                    <dt class="text-[var(--color-teks-lembut)]">Harga kasir</dt>
                    <dd class="tabular-nums">{rupiah(p.price)}</dd>

                    <dt class="text-[var(--color-teks-lembut)]">Lokasi</dt>
                    <dd>{p.storage_location ?? '—'}</dd>
                  </dl>

                  {/* Sisa per batch, urut FEFO -- urutan yang sama dengan
                      urutan pengeluarannya. */}
                  <p class="mt-2 text-xs text-[var(--color-teks-lembut)]">Stok per batch</p>
                  {batches.length > 0 ? (
                    <ul class="mt-1 space-y-0.5 text-xs">
                      {batches.map((b) => (
                        <li class="flex flex-wrap justify-between gap-x-2">
                          <span>{b.batch_number ?? 'Tanpa nomor'}</span>
                          <span class="tabular-nums">
                            sisa {b.remaining_qty} ·{' '}
                            {b.expiry_date ? tanggal(b.expiry_date) : 'tanpa tanggal'}
                          </span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-1 text-xs">Tidak ada batch bersisa.</p>
                  )}
                </details>

                {/* Pemilih batch.

                    FEFO tidak lagi dipakai di kasir. Di gudang barang
                    bercampur dan yang terambil adalah yang paling atas, jadi
                    "kedaluwarsa terdekat keluar lebih dulu" yang diputuskan
                    server adalah catatan yang belum tentu benar -- dan
                    catatan stok yang salah tidak bisa diperbaiki belakangan,
                    karena tidak ada lagi yang tahu apa yang sebenarnya
                    diambil. Karena itu kasir yang menyebutkan, per batch.

                    Satu kolom jumlah untuk TIAP batch, bukan satu pilihan:
                    lima butir yang fisiknya diambil dari dua kiriman ditulis
                    apa adanya sebagai dua baris. Backend menggabungkannya per
                    (produk, batch), jadi bentuk ini tidak butuh perlakuan
                    khusus di sana.

                    `product_id`, `nama`, dan `harga` ikut DI TIAP BARIS
                    BATCH, bukan sekali di kartu: kelimanya dibaca sebagai
                    lima deret sejajar di `bacaKeranjang`, dan deret yang
                    panjangnya berbeda akan memasangkan batch satu produk
                    dengan jumlah milik produk lain.

                    <dialog open> dirender server supaya tanpa JavaScript
                    isinya jadi panel biasa di dalam kartu. Skrip halaman
                    menutupnya saat muat lalu membukanya dengan showModal() --
                    lihat .panel-batch di theme.css. */}
                {bolehTransaksi && (
                  <dialog class="panel-batch basis-full" open data-panel-batch>
                    <p class="mb-1 text-xs font-medium">
                      Batch yang diambil
                      <span class="hanya-js"> — {p.name}</span>
                    </p>

                    {batches.length === 0 && (
                      <p class="text-xs text-red-600">
                        Tidak ada batch bersisa. Barang ini tidak bisa dijual sampai
                        kiriman barunya dicatat.
                      </p>
                    )}

                    {batches.map((b) => (
                      <div class="baris-batch" data-baris-batch>
                        <input type="hidden" name="product_id" value={p.id} />
                        <input type="hidden" name="nama" value={p.name} />
                        <input type="hidden" name="harga" value={p.price} />
                        <input type="hidden" name="batch_id" value={b.id} />

                        <label class="min-w-0 flex-1 text-xs" for={`qty-${p.id}-${b.id}`}>
                          <span class="block truncate font-medium">
                            {b.batch_number ?? 'Tanpa nomor'}
                          </span>
                          <span class="block text-[var(--color-teks-lembut)]">
                            {b.expiry_date ? tanggal(b.expiry_date) : 'tanpa tanggal'} · sisa{' '}
                            {b.remaining_qty}
                          </span>
                        </label>

                        <button
                          type="button"
                          class="tombol-bulat hanya-js"
                          data-kurang
                          aria-label={`Kurangi ${p.name} dari batch ${b.batch_number ?? 'tanpa nomor'}`}
                        >
                          −
                        </button>

                        {/* `max` = sisa BATCH INI, bukan stok produk. Dibatasi
                            stok produk, kasir bisa mengetik 10 untuk batch
                            yang tinggal 3 dan baru ditolak saat pembayaran --
                            di depan pembeli yang sudah menunggu. */}
                        <input
                          class="kolom w-16 shrink-0 text-center tabular-nums"
                          id={`qty-${p.id}-${b.id}`}
                          type="number"
                          inputmode="numeric"
                          name="qty"
                          min="0"
                          max={b.remaining_qty}
                          value={jumlahBatch.get(`${p.id}:${b.id}`) ?? 0}
                          data-qty
                          data-sisa={b.remaining_qty}
                          data-batch={b.batch_number ?? 'Tanpa nomor'}
                        />

                        <button
                          type="button"
                          class="tombol-bulat hanya-js"
                          data-tambah
                          aria-label={`Tambah ${p.name} dari batch ${b.batch_number ?? 'tanpa nomor'}`}
                        >
                          +
                        </button>
                      </div>
                    ))}

                    {/* Hanya berarti saat panel ini jadi pop up: di sana kartu
                        beserta ringkasannya tertutup di belakang backdrop. */}
                    <div class="hanya-js mt-3 flex items-center gap-3">
                      <span class="text-sm text-[var(--color-teks-lembut)]">
                        Total <span class="font-semibold tabular-nums" data-total-batch>0</span>
                      </span>
                      <button type="button" class="tombol-utama ml-auto" data-tutup-batch>
                        Selesai
                      </button>
                    </div>
                  </dialog>
                )}
              </div>
            );
          })}

          {barang.length === 0 && (
            <p class="kartu text-center text-[var(--color-teks-lembut)]">
              Tidak ada produk yang bisa dijual.
            </p>
          )}
        </div>

        <p
          class="mt-4 hidden text-center text-sm text-[var(--color-teks-lembut)]"
          data-kosong-saringan
        >
          Tidak ada produk yang cocok dengan pencarian ini.
        </p>

        {bolehTransaksi && (
          <div class="bilah-bawah">
            <span class="text-sm text-[var(--color-teks-lembut)]">
              <span data-ringkas-item>{totalItem}</span> item ·
              <span data-ringkas-produk> {jumlahProduk.size}</span> produk
            </span>
            <span class="ml-auto text-base font-bold tabular-nums sm:ml-0" data-ringkas-total>
              {rupiah(totalBelanja)}
            </span>
            <button
              class="tombol-utama w-full sm:ml-auto sm:w-auto"
              type="submit"
              name="aksi"
              value="lanjut"
            >
              Lanjut ke pembayaran →
            </button>
          </div>
        )}
      </form>
    )
  }

  {/* ================================================================= */}
  {/* Langkah 2 — pembayaran                                            */}
  {/* ================================================================= */}
  {
    langkah === 2 && (
      <Fragment>
        <div class="kartu mb-4">
          <h2 class="mb-3 font-semibold">Ringkasan</h2>
          <table class="w-full text-sm">
            <tbody>
              {/* Per produk, bukan per batch: yang dibayar pembeli adalah
                  barangnya, dan struk dari backend pun satu baris per produk.
                  Pilihan batch sudah selesai di langkah 1 dan tetap terbawa
                  utuh di hidden field di bawah. */}
              {ringkasan.map((b) => (
                <tr>
                  <td class="py-1">
                    {b.nama}
                    <span class="text-[var(--color-teks-lembut)]"> × {b.qty}</span>
                  </td>
                  <td class="py-1 text-right tabular-nums">{rupiah(b.harga * b.qty)}</td>
                </tr>
              ))}
              <tr class="border-t border-[var(--color-garis)] font-semibold">
                <td class="py-2">Subtotal</td>
                <td class="py-2 text-right tabular-nums" data-subtotal={totalBelanja}>
                  {rupiah(totalBelanja)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        {/* Pelanggan baru dibuat lewat POST tersendiri supaya tetap bekerja
            tanpa JavaScript; keranjang ikut terbawa di hidden field dan
            halaman kembali ke langkah 2 dengan pelanggan itu terpilih. */}
        <details class="kartu mb-4">
          <summary class="cursor-pointer list-none text-sm font-medium">
            ＋ Tambah pelanggan baru
          </summary>

          <form method="POST" class="borang-tegak mt-4">
            <input type="hidden" name="aksi" value="pelanggan-baru" />
            <input type="hidden" name="idempotency_key" value={kunci} />
            <input type="hidden" name="customer_id" value={pelangganDipilih} />
            <input type="hidden" name="payment_method" value={metode} />
            <input type="hidden" name="shipping_cost" value={ongkirIsi} />
            <input type="hidden" name="amount_paid" value={dibayarIsi} />
            {keranjang.map((b) => (
              <Fragment>
                <input type="hidden" name="product_id" value={b.product_id} />
                <input type="hidden" name="qty" value={b.qty} />
                <input type="hidden" name="nama" value={b.nama} />
                <input type="hidden" name="harga" value={b.harga} />
                <input type="hidden" name="batch_id" value={b.batch_id} />
              </Fragment>
            ))}

            <div class="isian">
              <label class="label" for="pelanggan_nama">Nama pelanggan</label>
              <input class="kolom" id="pelanggan_nama" name="pelanggan_nama" required />
            </div>

            <div class="isian isian-pendek">
              <label class="label" for="pelanggan_telepon">No. telepon</label>
              <input
                class="kolom"
                id="pelanggan_telepon"
                name="pelanggan_telepon"
                type="tel"
                placeholder="opsional"
              />
              <p class="isian-bantu">
                Kalau nomornya sudah pernah dicatat, pelanggan lama yang dipakai — bukan dibuat
                ganda.
              </p>
            </div>

            <div class="isian">
              <button class="tombol-halus" type="submit">Simpan pelanggan</button>
            </div>
          </form>
        </details>

        <form method="POST">
          <input type="hidden" name="idempotency_key" value={kunci} />
          {keranjang.map((b) => (
            <Fragment>
              <input type="hidden" name="product_id" value={b.product_id} />
              <input type="hidden" name="qty" value={b.qty} />
              <input type="hidden" name="nama" value={b.nama} />
              <input type="hidden" name="harga" value={b.harga} />
              <input type="hidden" name="batch_id" value={b.batch_id} />
            </Fragment>
          ))}

          <div class="kartu borang-tegak">
            <div class="isian">
              <label class="label" for="customer_id">Pelanggan</label>
              <select class="kolom" id="customer_id" name="customer_id">
                <option value="" selected={!pelangganDipilih}>Tidak ada (Walk-in)</option>
                {pelanggan.map((c) => (
                  <option value={c.id} selected={pelangganDipilih === c.id}>
                    {namaPelanggan(c)}
                    {c.phone ? ` · ${c.phone}` : ''}
