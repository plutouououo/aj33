            {/* Kanal disebut di struk supaya harga yang tercetak jelas memakai daftar harga yang mana. */}
            <p class="mt-1 text-xs text-emerald-800">
              Kanal {KANAL.find((k) => k.nilai === struk.sales_channel)?.label ?? struk.sales_channel}
