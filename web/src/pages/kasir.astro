            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-pph
            >
              <span>PPh UMKM (0,5%)</span>
              <span class="tabular-nums text-merah-700" data-biaya-pph-tampil>
                -{rupiah(biayaWithholdingTaxAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-proses
            >
              <span>Biaya proses pemesanan</span>
              <span class="tabular-nums text-merah-700" data-biaya-proses-tampil>
