            </div>

            <div class="kotak-total">
              <p class="font-medium text-merah-700" data-label-total>
                {kanalIsi === 'shopee' ? 'Estimasi Total Penghasilan' : 'Total'}
              </p>
              <p class="kotak-total-angka" data-total>{rupiah(totalTagihan)}</p>
            </div>

            {/* Kekurangan dan kembalian memakai satu kotak karena menjawab satu pertanyaan, dan dua kotak bergantian membuat tinggi melompat saat dibaca. */}
            <div
              class:list={[kurangBayar ? 'kotak-kurang' : 'kotak-kembalian', adaDibayar ? '' : 'hidden']}
              data-kotak-kembalian
            >
              <p class="text-sm font-medium" data-label-kembalian>
                {kurangBayar ? 'Uang yang diterima masih kurang' : 'Kembalian'}
