          </div>
        </div>

        {struk && (
          <Fragment>
          <div id="struk" class="scroll-mt-[calc(var(--tinggi-topbar)+1rem)] rounded-xl border border-emerald-200 bg-emerald-50 p-4" role="status">
            <div class="flex items-center justify-between gap-2">
