            {struk.change_amount !== null && (
              <div class="mt-3 flex items-baseline justify-between gap-3 text-emerald-900">
                <span class="text-sm font-medium">Kembalian</span>
                <span class="text-2xl font-bold tabular-nums">{rupiah(struk.change_amount)}</span>
              </div>
            )}

            <table class="mt-3 w-full border-t border-emerald-200 pt-2 text-sm text-emerald-900">
              <tbody>
                {struk.items.map((it) => (
                  <tr>
                    <td class="py-0.5">
                      {it.product_name_snapshot}
                      <span class="opacity-70"> × {it.qty}</span>
                    </td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(it.subtotal)}</td>
                  </tr>
                ))}
                <tr>
                  <td class="py-0.5">Subtotal barang</td>
                  <td class="py-0.5 text-right tabular-nums">{rupiah(struk.subtotal)}</td>
                </tr>
                {struk.shipping_cost > 0 && (
                  <tr>
                    <td class="py-0.5">Ongkos kirim</td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(struk.shipping_cost)}</td>
                  </tr>
                )}
                <tr class="font-bold">
                  <td class="py-0.5">Total</td>
                  <td class="py-0.5 text-right tabular-nums">{rupiah(struk.total_amount)}</td>
                </tr>
                {struk.amount_paid !== null && (
                  <tr>
                    <td class="py-0.5">Dibayar</td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(struk.amount_paid)}</td>
                  </tr>
                )}
              </tbody>
            </table>

            {/* Tautan GET, bukan tombol: menutup struk sekalian mengembalikan
                halaman ke keadaan bersih tanpa hasil POST yang menempel di
                riwayat browser. Kunci idempotensi transaksi berikutnya sudah
                diganti sejak penjualan ini berhasil, jadi kasir juga boleh
                langsung lanjut menjual tanpa menekan apa pun di sini. */}
            <a href="/kasir" class="tombol-utama mt-3 w-full">Penjualan baru</a>
          </div>
