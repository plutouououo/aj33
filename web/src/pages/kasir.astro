                class="baris-keranjang"
                data-baris-keranjang
                data-kolom={`qty-${r.kunci.replace(':', '-')}`}
                data-pid={r.product_id}
                data-harga={r.harga}
                data-harga-toko={r.hargaKanal?.toko}
                data-harga-shopee={r.hargaKanal?.shopee}
                data-harga-tiktok={r.hargaKanal?.tiktok}
                hidden={r.qty === 0}
              >
                <span class="col-span-2 text-sm font-medium">{r.nama}</span>
                <span class="col-span-2 text-xs font-medium text-merah-700">{r.batchLabel}</span>
                <span class="self-center text-xs tabular-nums text-[var(--color-teks-lembut)]">
                  <span data-qty-teks>{r.qty}</span> × <span data-harga-satuan>{rupiah(r.harga)}</span>
                </span>
                <div class="flex flex-wrap items-center justify-end gap-2">
                  {/* Baris yang produknya tersaring keluar dari katalog membawa
                      sendiri isian keranjangnya -- di katalog tidak ada lagi
                      kolom yang menahannya, dan tanpa ini barang yang sudah
                      dipilih hilang diam-diam saat saringan dikirim ke server. */}
                  {r.luar && (
                    <Fragment>
                      <input type="hidden" name="product_id" value={r.product_id} />
                      <input type="hidden" name="nama" value={r.nama} />
                      <input type="hidden" name="harga" value={r.harga} />
                      <input type="hidden" name="batch_id" value={r.kunci.split(':')[1]} />
                    </Fragment>
                  )}

                  <button
                    type="button"
                    class="tombol-bulat hanya-js"
                    data-kurang-keranjang
                    aria-label={`Kurangi ${r.nama}`}
                  >
                    −
                  </button>

                  {r.luar ? (
                    <input
                      class="kolom w-16 shrink-0 text-center tabular-nums"
                      id={`qty-${r.kunci.replace(':', '-')}`}
                      type="number"
                      inputmode="numeric"
                      name="qty"
                      min="0"
                      max={r.sisa}
                      value={r.qty}
                      aria-label={`Jumlah ${r.nama}`}
                      data-qty-luar
                      data-sisa={r.sisa}
                    />
                  ) : (
                    <span class="min-w-6 text-center text-base font-bold tabular-nums" data-qty-teks>
                      {r.qty}
                    </span>
                  )}

                  <button
                    type="button"
                    class="tombol-bulat hanya-js"
                    data-tambah-keranjang
                    aria-label={`Tambah ${r.nama}`}
                  >
                    +
                  </button>

                  <span class="min-w-20 text-right text-sm font-bold tabular-nums" data-subtotal-baris>
                    {rupiah(r.harga * r.qty)}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="kartu flex flex-col gap-4 p-4">
          {/* Kanal ditaruh PALING ATAS di panel pembayaran, sebelum apa pun
              yang menyebut angka: ia menentukan seluruh harga di bawahnya,
              dan kasir yang menyadarinya belakangan harus mengulang dari
              awal. */}
          <div>
            <p class="label">Kanal penjualan</p>
            <div class="flex flex-wrap gap-2">
              {KANAL.map((k) => (
                <label class="pil-diam cursor-pointer has-[:checked]:border-merah-600 has-[:checked]:bg-merah-600 has-[:checked]:text-white">
                  <input
                    class="sr-only"
                    type="radio"
                    name="sales_channel"
                    value={k.nilai}
                    checked={kanalIsi === k.nilai}
                    data-kanal
                  />
                  {k.label}
                </label>
              ))}
            </div>
          </div>

          {/* Hanya berarti untuk Shopee -- selalu dirender (bukan
              server-only conditional) supaya berganti kanal tanpa reload
              tetap memunculkan/menyembunyikannya, sama seperti baris biaya
              platform di bawah.

              Dua kolom, bukan satu "biaya administrasi" gabungan: API
              Shopee (`v2.payment.get_escrow_detail`) memisahkan potongan
              jadi `commission_fee` (komisi dasar, berlaku semua pesanan)
              dan `service_fee` (program opsional seperti Gratis Ongkir
              Xtra/Star+). Menggabungkannya jadi satu angka tidak bisa
              dibandingkan field-demi-field dengan struk asli Shopee kalau
              toko ini suatu saat tersambung sungguhan. */}
          <div
            class:list={['grid gap-3 sm:grid-cols-2', kanalIsi === 'shopee' ? '' : 'hidden']}
            data-blok-commission-fee
          >
            <div>
              <label class="label" for="platform_commission_fee_percent">Biaya Komisi Shopee (%)</label>
              <input
                class="kolom tabular-nums"
                id="platform_commission_fee_percent"
                name="platform_commission_fee_percent"
                type="number"
                min="0"
                max="100"
                step="0.01"
                value={commissionPersenIsi}
                placeholder={String(SHOPEE_COMMISSION_PERSEN_DEFAULT)}
                data-commission-fee
              />
              </div>
            <div>
              <label class="label" for="platform_service_fee_percent">Biaya Layanan Shopee (%)</label>
              <input
                class="kolom tabular-nums"
                id="platform_service_fee_percent"
                name="platform_service_fee_percent"
                type="number"
                min="0"
                max="100"
                step="0.01"
                value={servicePersenIsi}
                placeholder={String(SHOPEE_SERVICE_PERSEN_DEFAULT)}
                data-service-fee
              />
            </div>
          </div>

          <div>
            <p class="label">Metode pembayaran</p>
            <div
              class:list={['flex flex-wrap gap-2', kanalIsi === 'shopee' ? 'hidden' : '']}
              data-blok-metode-pilihan
            >
              {METODE.map((m) => (
                <label class="pil-diam cursor-pointer has-[:checked]:border-merah-600 has-[:checked]:bg-merah-600 has-[:checked]:text-white">
                  <input
                    class="sr-only"
                    type="radio"
                    name="payment_method"
                    value={m.nilai}
                    checked={metode === m.nilai}
                    data-metode
                  />
                  {m.label}
                </label>
              ))}
            </div>
            {/* Untuk Shopee, metode bukan pilihan -- uangnya sudah pasti
                diterima lewat ShopeePay. Radio button di atas tetap ADA di
                DOM (cuma disembunyikan lewat kelas), jadi cukup satu field
                `payment_method` yang pernah terkirim; lihat `syncMetodeShopee`
                di skrip halaman yang memaksa radio "E-wallet" tercentang.

                `pil-aktif` sudah `inline-flex` lewat utility `pil`, jadi
                jangan tambahkan `inline-block` di sini lagi -- di lapisan
                utilities Tailwind, `.inline-block` didefinisikan SESUDAH
                `.hidden`, jadi kalau dua-duanya dipasang, `inline-block`
                menang dan ShopeePay tetap kelihatan di kanal Toko/Tokopedia
                walau kelas `hidden` sudah ada. */}
            <p
              class:list={['pil-aktif', kanalIsi === 'shopee' ? '' : 'hidden']}
              data-blok-metode-shopee
            >
              ShopeePay
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {/* Tidak berlaku untuk Shopee -- logistiknya di luar sistem ini.
                Disembunyikan, bukan dihapus dari DOM: sama seperti blok
                lain yang bergantung pada kanal, supaya kolomnya tetap ada
                untuk skrip halaman membaca/mengosongkan nilainya. */}
            <div class:list={[kanalIsi === 'shopee' ? 'hidden' : '']} data-blok-ongkir>
              <label class="label" for="shipping_cost">Ongkos kirim (Rp)</label>
              <input
                class="kolom tabular-nums"
                id="shipping_cost"
                name="shipping_cost"
                type="number"
                min="0"
                step="1"
                value={ongkirIsi}
                placeholder="0"
                data-ongkir
              />
            </div>

            <div>
              <label class="label" for="discount_amount">Diskon (Rp)</label>
              <input
                class="kolom tabular-nums"
                id="discount_amount"
                name="discount_amount"
                type="number"
                min="0"
                step="1"
                value={diskonIsi}
                placeholder="0"
                data-diskon
              />
            </div>

            {/* Shopee tidak butuh ini sama sekali -- uangnya sudah pasti
                diterima penuh lewat ShopeePay, jadi tidak ada "uang diterima"
                untuk dicatat maupun kembalian untuk dihitung. Disembunyikan
                seluruhnya, bukan sekadar dimatikan seperti kanal lain. */}
            <div class:list={[kanalIsi === 'shopee' ? 'hidden' : '']} data-blok-dibayar>
              <label class="label" for="amount_paid">Uang diterima (tunai)</label>
              <input
                class="kolom tabular-nums"
                id="amount_paid"
                name="amount_paid"
                type="number"
                min="0"
                step="1"
                value={dibayarIsi}
                placeholder="0"
                disabled={!tunai}
                data-dibayar
              />
            </div>
          </div>

          {/* Nominal cepat hanya berguna kalau ada yang mengisikannya, jadi
              seluruh barisnya `hanya-js`. "Uang pas" mengambil total berjalan,
              bukan angka yang dirender server -- ongkir bisa sudah berubah
              setelah halaman dimuat. Disembunyikan juga untuk Shopee, dengan
              alasan yang sama seperti "Uang diterima" di atas. */}
          <div
            class:list={['hanya-js flex flex-wrap gap-2', kanalIsi === 'shopee' ? 'hidden' : '']}
            data-cepat
          >
            <button type="button" class="pil-diam" data-uang-pas>Uang pas</button>
            {NOMINAL.map((n) => (
              <button type="button" class="pil-diam tabular-nums" data-nominal={n}>
                {new Intl.NumberFormat('id-ID').format(n)}
              </button>
            ))}
          </div>

          <div class="flex flex-col gap-2 text-sm">
            <div class="flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]">
              <span>Subtotal barang</span>
              <span class="tabular-nums text-[var(--color-teks)]" data-subtotal>
                {rupiah(totalBelanja)}
              </span>
            </div>
            {/* Selalu dirender, disembunyikan selama nol: baris yang baru
                lahir saat diisi menggeser angka Total tepat ketika kasir
                sedang membacanya. */}
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                diskonAngka > 0 ? '' : 'hidden',
              ]}
              data-baris-diskon
            >
              <span>Diskon</span>
              <span class="tabular-nums text-merah-700" data-diskon-tampil>
                -{rupiah(diskonAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? 'hidden' : '',
              ]}
              data-baris-ongkir
            >
              <span>Ongkos kirim</span>
              <span class="tabular-nums text-[var(--color-teks)]" data-ongkir-tampil>
                {rupiah(ongkirAngka)}
              </span>
            </div>
            {/* Keempatnya MENGURANGI Total untuk kanal Shopee -- beda dari
                sebelumnya. Kasir Shopee di sini cuma mencatat pesanan yang
                uangnya sudah diterima lewat ShopeePay, jadi angka yang
                relevan buat kasir adalah yang benar-benar cair ke toko,
                bukan yang dibayar pembeli (pembeli sudah membayar penuh di
                Shopee, di luar sistem ini). Nama field mengikuti
                `get_escrow_detail` Shopee -- lihat komentar di atas. */}
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-komisi
            >
              <span>Biaya Komisi (<span data-biaya-komisi-persen>{commissionPersenAngka}</span>%)</span>
              <span class="tabular-nums text-merah-700" data-biaya-komisi-tampil>
                -{rupiah(biayaKomisiAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-layanan
            >
              <span>Biaya Layanan (<span data-biaya-layanan-persen>{servicePersenAngka}</span>%)</span>
              <span class="tabular-nums text-merah-700" data-biaya-layanan-tampil>
                -{rupiah(biayaLayananAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-pph
            >
              <span>PPh UMKM (0,5%)</span>
              <span class="tabular-nums text-merah-700" data-biaya-pph-tampil>
                -{rupiah(biayaWithholdingTaxAngka)}
              </span>
            </div>
            <div
              class:list={[
                'flex items-baseline justify-between gap-3 text-[var(--color-teks-lembut)]',
                kanalIsi === 'shopee' ? '' : 'hidden',
              ]}
              data-baris-biaya-proses
            >
              <span>Biaya proses pemesanan</span>
              <span class="tabular-nums text-merah-700" data-biaya-proses-tampil>
                -{rupiah(biayaOrderProcessingAngka)}
              </span>
            </div>

            <div class="kotak-total">
              <p class="font-medium text-merah-700" data-label-total>
                {kanalIsi === 'shopee' ? 'Estimasi Total Penghasilan' : 'Total'}
              </p>
              <p class="kotak-total-angka" data-total>{rupiah(totalTagihan)}</p>
            </div>

            {/* Kekurangan dan kembalian menempati kotak yang sama: keduanya
                jawaban atas satu pertanyaan ("uangnya cukup?"), dan dua kotak
                yang bergantian muncul membuat tingginya melompat tepat saat
                kasir sedang membaca angkanya. */}
            <div
              class:list={[kurangBayar ? 'kotak-kurang' : 'kotak-kembalian', adaDibayar ? '' : 'hidden']}
              data-kotak-kembalian
            >
              <p class="text-sm font-medium" data-label-kembalian>
                {kurangBayar ? 'Uang yang diterima masih kurang' : 'Kembalian'}
              </p>
              <p class="kotak-kembalian-angka" data-kembalian>
                {adaDibayar ? rupiah(Math.abs(dibayarAngka - totalTagihan)) : '—'}
              </p>
            </div>
          </div>

          <button class="tombol-utama w-full py-4 text-base" type="submit" name="aksi" value="bayar" data-bayar>
            {barisTerpakai > 0 ? `Selesaikan · ${rupiah(totalTagihan)}` : 'Keranjang masih kosong'}
          </button>

          <div class="flex items-center gap-3">
            <button
              class="text-xs font-semibold text-[var(--color-teks-lembut)] hover:text-merah-700"
              type="submit"
              name="aksi"
              value="kosongkan"
            >
              Kosongkan keranjang
            </button>
            {/* Tanpa JavaScript, angka di panel ini baru benar setelah satu
                perjalanan ke server. Tombol inilah perjalanannya. */}
            <button class="tombol-halus tanpa-js ml-auto" type="submit" name="aksi" value="hitung">
              Perbarui keranjang
            </button>
          </div>
        </div>

        {struk && (
          <Fragment>
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4" role="status">
            <div class="flex items-center justify-between gap-2">
              <span class="lencana-selesai">Penjualan berhasil</span>
              <span class="font-mono text-xs text-emerald-800">#{struk.id.slice(0, 8)}</span>
            </div>

            {/* Kanal disebut di struk, bukan cuma dipakai diam-diam: harga
                yang tercetak di bawah hanya masuk akal kalau daftar harga
                mana yang dipakai ikut terbaca. */}
            <p class="mt-1 text-xs text-emerald-800">
              Kanal {KANAL.find((k) => k.nilai === struk.sales_channel)?.label ?? struk.sales_channel}
            </p>

            {struk.change_amount !== null && (
              <div class="mt-3 flex items-baseline justify-between gap-3 text-emerald-900">
                <span class="text-sm font-medium">Kembalian</span>
                <span class="text-2xl font-bold tabular-nums">{rupiah(struk.change_amount)}</span>
              </div>
            )}

            <table class="mt-3 w-full border-t border-emerald-200 pt-2 text-sm text-emerald-900">
              <tbody>
                {struk.items.map((it) => (
                  <tr>
                    <td class="py-0.5">
                      {it.product_name_snapshot}
                      <span class="opacity-70"> × {it.qty}</span>
                    </td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(it.subtotal)}</td>
                  </tr>
                ))}
                <tr>
                  <td class="py-0.5">Subtotal barang</td>
                  <td class="py-0.5 text-right tabular-nums">{rupiah(struk.subtotal)}</td>
                </tr>
                {struk.discount_amount > 0 && (
                  <tr>
                    <td class="py-0.5">Diskon</td>
                    <td class="py-0.5 text-right tabular-nums">
                      -{rupiah(struk.discount_amount)}
                    </td>
                  </tr>
                )}
                {struk.shipping_cost > 0 && (
                  <tr>
                    <td class="py-0.5">Ongkos kirim</td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(struk.shipping_cost)}</td>
                  </tr>
                )}
                {/* Untuk kanal Shopee keempatnya SUDAH mengurangi Total di
                    bawah -- lihat `platform_commission_fee` dkk. yang backend
                    hitung dan simpan saat checkout (nama field mengikuti
                    `get_escrow_detail` Shopee). Ditulis sebagai baris struk
                    biasa, bukan catatan kaki terpisah, supaya penjumlahannya
                    kelihatan sama seperti Diskon dan Ongkos kirim di
                    atasnya. */}
                {struk.sales_channel === 'shopee' && (
                  <Fragment>
                    <tr>
                      <td class="py-0.5">
                        Biaya Komisi ({struk.platform_commission_fee_percent * 100}%)
                      </td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_commission_fee)}
                      </td>
                    </tr>
                    {struk.platform_service_fee > 0 && (
                      <tr>
                        <td class="py-0.5">
                          Biaya Layanan ({struk.platform_service_fee_percent * 100}%)
                        </td>
                        <td class="py-0.5 text-right tabular-nums">
                          -{rupiah(struk.platform_service_fee)}
                        </td>
                      </tr>
                    )}
                    <tr>
                      <td class="py-0.5">PPh UMKM (0,5%)</td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_withholding_tax)}
                      </td>
                    </tr>
                    <tr>
                      <td class="py-0.5">Biaya proses pemesanan</td>
                      <td class="py-0.5 text-right tabular-nums">
                        -{rupiah(struk.platform_order_processing_fee)}
                      </td>
                    </tr>
                  </Fragment>
                )}
                <tr class="font-bold">
                  <td class="py-0.5">
                    {struk.sales_channel === 'shopee' ? 'Estimasi Total Penghasilan' : 'Total'}
                  </td>
                  <td class="py-0.5 text-right tabular-nums">{rupiah(struk.total_amount)}</td>
                </tr>
                {struk.amount_paid !== null && (
                  <tr>
                    <td class="py-0.5">Dibayar</td>
                    <td class="py-0.5 text-right tabular-nums">{rupiah(struk.amount_paid)}</td>
                  </tr>
                )}
              </tbody>
            </table>

            {/* `hanya-js`: merender nota jadi gambar lalu membuka share
                sheet OS (supaya bisa dikirim ke app seperti OpenLabel+ untuk
                dicetak lewat printer thermal Bluetooth) perlu JavaScript,
                dan tanpa itu tombol ini tidak bisa berbuat apa-apa. Kasir
                tanpa JS tetap bisa mencetak lewat Ctrl+P/Cmd+P bawaan
                browser -- `.nota-cetak` di bawah dan blok `@media print` di
                theme.css sudah mengisolasi nota itu sendiri di kertas,
                terlepas dari apa yang memicu dialog cetaknya. Lihat skrip
                module di bawah untuk perilaku tombol ini. */}
            <button type="button" class="tombol-halus hanya-js mt-3 w-full" data-cetak-struk>
              Cetak / bagikan nota
            </button>

            {/* Tautan GET, bukan tombol: menutup struk sekalian mengembalikan
                halaman ke keadaan bersih tanpa hasil POST yang menempel di
                riwayat browser. Kunci idempotensi transaksi berikutnya sudah
                diganti sejak penjualan ini berhasil, jadi kasir juga boleh
                langsung lanjut menjual tanpa menekan apa pun di sini. */}
            <a href="/kasir" class="tombol-utama mt-3 w-full">Penjualan baru</a>
          </div>

          {/*
            Nota cetak.

            Berdiri sendiri dari panel konfirmasi di atas, bukan dipakai
            ulang lewat CSS print yang menyunting tata letaknya: yang satu
            dibaca di layar (tabel lebar, warna, tombol), yang lain dicetak
            di kertas struk sempit (monospace, hitam-putih, lebar tetap).
            Mencampur keduanya lewat override print berisiko merusak salah
            satu tanpa disadari saat yang lain diubah.

            Disembunyikan di layar oleh `.nota-cetak` di theme.css, dan HANYA
            blok `@media print` di sana yang menampilkannya kembali --
            sekaligus menyembunyikan seluruh halaman selain blok ini, supaya
            yang tercetak betul-betul hanya nota, bukan sidebar atau katalog
            yang masih ada di DOM.
          */}
          <div class="nota-cetak" data-nota-cetak>
            <p class="nota-toko">Toko Ayam Aneka Jaya 33</p>
            <p class="nota-baris-pusat">Bersih dan Halal</p>
            <p class="nota-baris-pusat">{waktu(struk.created_at)}</p>
            <p class="nota-baris-pusat">#{struk.id.slice(0, 8)}</p>
            <hr class="nota-garis" />
            <p>Kasir: {user.name}</p>
            <p>
              Pelanggan:{' '}
              {strukPelanggan
                ? namaPelanggan(strukPelanggan)
                : strukPelangganId
                  ? 'Pelanggan terdaftar'
                  : 'Walk-in'}
            </p>
            <p>Kanal: {KANAL.find((k) => k.nilai === struk.sales_channel)?.label ?? struk.sales_channel}</p>
            <p>
              Metode:{' '}
              {struk.sales_channel === 'shopee'
                ? 'ShopeePay'
                : METODE.find((m) => m.nilai === struk.payment_method)?.label ?? struk.payment_method}
            </p>
            <hr class="nota-garis" />
            <table class="nota-tabel">
              <tbody>
                {struk.items.map((it) => (
                  <Fragment>
                    <tr>
                      <td colspan={2}>{it.product_name_snapshot}</td>
                    </tr>
                    <tr>
                      <td>
                        {it.qty} × {rupiah(it.unit_price)}
                      </td>
                      <td class="nota-kanan">{rupiah(it.subtotal)}</td>
                    </tr>
                  </Fragment>
                ))}
              </tbody>
            </table>
            <hr class="nota-garis" />
            <table class="nota-tabel">
              <tbody>
                <tr>
                  <td>Subtotal</td>
                  <td class="nota-kanan">{rupiah(struk.subtotal)}</td>
                </tr>
                {struk.discount_amount > 0 && (
                  <tr>
                    <td>Diskon</td>
                    <td class="nota-kanan">-{rupiah(struk.discount_amount)}</td>
                  </tr>
                )}
                {struk.shipping_cost > 0 && (
                  <tr>
                    <td>Ongkos kirim</td>
                    <td class="nota-kanan">{rupiah(struk.shipping_cost)}</td>
                  </tr>
                )}
                {struk.sales_channel === 'shopee' && (
                  <Fragment>
                    <tr>
                      <td>Biaya Komisi ({struk.platform_commission_fee_percent * 100}%)</td>
                      <td class="nota-kanan">-{rupiah(struk.platform_commission_fee)}</td>
                    </tr>
                    {struk.platform_service_fee > 0 && (
                      <tr>
                        <td>Biaya Layanan ({struk.platform_service_fee_percent * 100}%)</td>
                        <td class="nota-kanan">-{rupiah(struk.platform_service_fee)}</td>
                      </tr>
                    )}
                    <tr>
                      <td>PPh UMKM (0,5%)</td>
                      <td class="nota-kanan">-{rupiah(struk.platform_withholding_tax)}</td>
                    </tr>
                    <tr>
                      <td>Biaya proses pemesanan</td>
                      <td class="nota-kanan">-{rupiah(struk.platform_order_processing_fee)}</td>
                    </tr>
                  </Fragment>
                )}
                <tr class="nota-total">
                  <td>{struk.sales_channel === 'shopee' ? 'Estimasi Total Penghasilan' : 'Total'}</td>
                  <td class="nota-kanan">{rupiah(struk.total_amount)}</td>
                </tr>
                {struk.amount_paid !== null && (
                  <tr>
                    <td>Dibayar</td>
                    <td class="nota-kanan">{rupiah(struk.amount_paid)}</td>
                  </tr>
                )}
                {struk.change_amount !== null && (
                  <tr>
                    <td>Kembalian</td>
                    <td class="nota-kanan">{rupiah(struk.change_amount)}</td>
                  </tr>
                )}
              </tbody>
            </table>
            <hr class="nota-garis" />
            <p class="nota-baris-pusat">Terima kasih!</p>
          </div>
          </Fragment>
        )}
      </aside>
    )}
  </form>

  {/* Di ponsel panel keranjang berada di BAWAH katalog yang panjangnya bisa
      200 kartu. Bilah ini yang membuatnya tetap terjangkau: ringkasan yang
      terbaca sekilas plus satu tautan ke panelnya. Di layar lebar panelnya
      sudah menempel di samping, jadi bilahnya tidak dirender. */}
  {bolehTransaksi && (
    <div class="bilah-bawah lg:hidden">
      <span class="text-sm text-[var(--color-teks-lembut)]">
        <span data-bilah-item>{totalItem}</span> pack
      </span>
      <span class="ml-auto text-base font-bold tabular-nums" data-bilah-total>
        {rupiah(totalTagihan)}
      </span>
      <a href="#keranjang" class="tombol-utama">Keranjang</a>
    </div>
  )}
</AppShell>

{/*
  Progressive enhancement.

  Skrip ini HANYA menulis ke `input[name=qty]` yang sudah ada di HTML dan ke
  teks yang ditampilkan. Ia tidak pernah merakit body request, mencegat submit,
  atau membuat baris keranjang baru -- baris panel keranjang sudah dirender
  server untuk tiap batch di katalog, dan yang dikerjakan di sini cuma
  menyembunyikan yang jumlahnya nol. Karena itu server menerima bentuk data
  yang sama persis apakah JavaScript hidup atau mati.

  `is:inline` mengikuti satu-satunya pola JS yang sudah ada di proyek ini
  (AppShell). Konsekuensinya tidak bisa meng-import, jadi pemformatan rupiah
  ditulis ulang di sini; opsinya harus tetap sama dengan `rupiah()` di
  web/src/lib/format.ts.
*/}
<script is:inline>
  (function () {
    var borang = document.getElementById('borang-kasir');
    if (!borang) return;

    // Mode lihat-saja tidak punya kendali jumlah maupun panel keranjang, dan
    // seluruh skrip di bawah menulis ke keduanya. Berhenti di sini membuat
    // halaman itu jatuh ke jalur tanpa-JS yang memang sudah didukung penuh:
    // saringannya dikerjakan server lewat tombol "Terapkan".
    if (borang.dataset.transaksi !== 'ya') return;

    // Baris pertama: menyalakan saklar CSS supaya stepper muncul dan kolom
    // angka di katalog menghilang. Lihat .hanya-js / .tanpa-js di theme.css.
    document.documentElement.dataset.js = 'ya';

    var rupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });

    // Sama persis dengan `SHOPEE_COMMISSION_PERSEN_DEFAULT` dkk. di
    // frontmatter Astro dan tarif bawaan di `backend/src/pos/service.rs` --
    // lihat komentar di sana kalau angkanya berubah, tiga tempat ini harus
    // ikut berubah. Keduanya cuma nilai AWAL; kasir boleh menggantinya
    // lewat kolom "Biaya Komisi Shopee (%)" / "Biaya Layanan Shopee (%)".
    var SHOPEE_COMMISSION_PERSEN_DEFAULT = 17.25;
    var SHOPEE_SERVICE_PERSEN_DEFAULT = 0;
    var SHOPEE_WITHHOLDING_TAX_PERSEN = 0.5;
    var SHOPEE_ORDER_PROCESSING_FEE = 1250;

    // Sama persis dengan `biayaPersenRupiah` di frontmatter Astro dan
    // `rupiah_bulat` di `backend/src/pos/service.rs` -- lihat komentarnya di
    // sana. Aritmetika bilangan bulat, bukan `Math.round(basis * (persen /
    // 100))`, supaya angka di sini tidak pernah meleset dari yang backend
    // simpan tepat di titik pembulatan seperti ,50.
    function biayaPersenRupiah(basis, persen) {
      var basisPoin = Math.round(persen * 100);
      return Math.round((basis * basisPoin) / 10000);
    }

    var baris = Array.prototype.slice.call(borang.querySelectorAll('[data-produk]'));
    var barisKeranjang = Array.prototype.slice.call(
      borang.querySelectorAll('[data-baris-keranjang]')
    );
    var kotakCari = borang.querySelector('[data-cari]');
    var pil = borang.querySelector('[data-pil-kategori]');
    var pesanKosong = borang.querySelector('[data-kosong-saringan]');
    var pesanKeranjangKosong = borang.querySelector('[data-keranjang-kosong]');

    var ongkir = borang.querySelector('[data-ongkir]');
    var diskon = borang.querySelector('[data-diskon]');
    var dibayar = borang.querySelector('[data-dibayar]');
    var commissionFeeInput = borang.querySelector('[data-commission-fee]');
    var serviceFeeInput = borang.querySelector('[data-service-fee]');
    var blokCommissionFee = borang.querySelector('[data-blok-commission-fee]');
    var blokOngkir = borang.querySelector('[data-blok-ongkir]');
    var blokMetodePilihan = borang.querySelector('[data-blok-metode-pilihan]');
    var blokMetodeShopee = borang.querySelector('[data-blok-metode-shopee]');
    var blokDibayar = borang.querySelector('[data-blok-dibayar]');
    var blokCepat = borang.querySelector('[data-cepat]');
    var selSubtotal = borang.querySelector('[data-subtotal]');
    var barisDiskon = borang.querySelector('[data-baris-diskon]');
    var selDiskon = borang.querySelector('[data-diskon-tampil]');
    var barisOngkir = borang.querySelector('[data-baris-ongkir]');
    var selOngkir = borang.querySelector('[data-ongkir-tampil]');
    var barisBiayaKomisi = borang.querySelector('[data-baris-biaya-komisi]');
    var selBiayaKomisi = borang.querySelector('[data-biaya-komisi-tampil]');
    var selBiayaKomisiPersen = borang.querySelector('[data-biaya-komisi-persen]');
    var barisBiayaLayanan = borang.querySelector('[data-baris-biaya-layanan]');
    var selBiayaLayanan = borang.querySelector('[data-biaya-layanan-tampil]');
    var selBiayaLayananPersen = borang.querySelector('[data-biaya-layanan-persen]');
    var barisBiayaPph = borang.querySelector('[data-baris-biaya-pph]');
    var selBiayaPph = borang.querySelector('[data-biaya-pph-tampil]');
    var barisBiayaProses = borang.querySelector('[data-baris-biaya-proses]');
    var selBiayaProses = borang.querySelector('[data-biaya-proses-tampil]');
    var labelTotal = borang.querySelector('[data-label-total]');
    var selTotal = borang.querySelector('[data-total]');
    var kotakKembalian = borang.querySelector('[data-kotak-kembalian]');
    var labelKembalian = borang.querySelector('[data-label-kembalian]');
    var selKembalian = borang.querySelector('[data-kembalian]');
    var selRingkas = borang.querySelector('[data-ringkas-item]');
    var tombolBayar = borang.querySelector('[data-bayar]');
    var bilahItem = document.querySelector('[data-bilah-item]');
    var bilahTotal = document.querySelector('[data-bilah-total]');

    // Panel batch dirender server dengan `open` supaya tetap terpakai tanpa
    // JavaScript. Ditutup di sini, lalu dibuka lagi sebagai pop up lewat
    // showModal(). Kolom jumlah di dalamnya tidak ikut ke mana-mana: elemen
    // yang sama itulah yang terkirim, terbuka maupun tertutup.
    baris.forEach(function (row) {
      var panel = row.querySelector('[data-panel-batch]');
      if (panel && panel.open) panel.close();
    });

    function kolomQty(row) {
      return Array.prototype.slice.call(row.querySelectorAll('[data-qty]'));
    }

    function nilai(kolom) {
      return kolom ? parseInt(kolom.value, 10) || 0 : 0;
    }

    function jumlahBaris(row) {
      return kolomQty(row).reduce(function (n, kolom) {
        return n + nilai(kolom);
      }, 0);
    }

    /** Ringkasan di kartu yang panelnya tertutup: batch mana, berapa. */
    function ringkasBatch(row) {
      return kolomQty(row)
        .filter(function (kolom) {
          return nilai(kolom) > 0;
        })
        .map(function (kolom) {
          return kolom.dataset.batch + ' × ' + kolom.value;
        })
        .join(', ');
    }

    /** Kanal yang sedang dipilih. Tidak ada pilihan sama dengan kanal toko. */
    function kanal() {
      var k = borang.querySelector('[data-kanal]:checked');
      return k ? k.value : 'toko';
    }

    /**
     * Menulis ulang seluruh harga di layar mengikuti kanal yang dipilih.
     *
     * Angkanya TIDAK dihitung di sini -- ketiga harga tiap produk sudah
     * dirender server sebagai atribut data-, dan yang dikerjakan fungsi ini
     * cuma memilih salah satunya. Menghitung sendiri berarti aturan "harga
     * kanal kosong jatuh ke harga dasar" hidup di tiga tempat (SQL, Astro,
     * dan skrip ini), dan cepat atau lambat ketiganya berbeda.
     *
     * Baris keranjang yang produknya sedang tersaring keluar dari katalog
     * tidak punya atribut itu; harganya dibiarkan apa adanya sampai
     * produknya terlihat lagi. Yang menagih tetap backend, yang membaca
     * harga kanal dari baris produk saat checkout.
     */
    function terapkanKanal() {
      // `data-harga-toko` dibaca sebagai `dataset.hargaToko`, dan seterusnya.
      var pilihan = kanal();
      var kunciHarga = 'harga' + pilihan.charAt(0).toUpperCase() + pilihan.slice(1);

      baris.forEach(function (row) {
        var harga = row.dataset[kunciHarga];
        if (harga === undefined) return;
        row.dataset.harga = harga;

        Array.prototype.forEach.call(row.querySelectorAll('[data-harga-tampil]'), function (el) {
          el.textContent = rupiah.format(parseFloat(harga));
        });
        Array.prototype.forEach.call(row.querySelectorAll('[data-harga-kolom]'), function (el) {
          el.value = harga;
        });
      });

      barisKeranjang.forEach(function (row) {
        var harga = row.dataset[kunciHarga];
        if (harga === undefined) return;
        row.dataset.harga = harga;

        var satuan = row.querySelector('[data-harga-satuan]');
        if (satuan) satuan.textContent = rupiah.format(parseFloat(harga));
      });
    }

    function tunai() {
      var m = borang.querySelector('[data-metode]:checked');
      return !m || m.value === 'cash';
    }

    function hitung() {
      // --- Katalog -----------------------------------------------------
      baris.forEach(function (row) {
        var qty = jumlahBaris(row);
        row.className = qty > 0 ? 'kartu-produk-terpilih' : 'kartu-produk';

        var ringkas = row.querySelector('[data-ringkas-baris]');
        if (ringkas) ringkas.textContent = qty > 0 ? ringkasBatch(row) : '';

        var lencana = row.querySelector('[data-lencana]');
        if (lencana) {
          lencana.hidden = qty === 0;
          lencana.textContent = String(qty);
        }

        var totalPanel = row.querySelector('[data-total-batch]');
        if (totalPanel) totalPanel.textContent = String(qty);
      });

      // --- Panel keranjang ---------------------------------------------
      var item = 0;
      var jalur = 0;
      var subtotal = 0;
      var produk = {};
      var jenis = 0;

      barisKeranjang.forEach(function (row) {
        var kolom = document.getElementById(row.dataset.kolom);
        var qty = nilai(kolom);
        row.hidden = qty === 0;
        if (qty > 0) {
          item += qty;
          jalur += 1;
          subtotal += qty * parseFloat(row.dataset.harga || '0');
          if (!produk[row.dataset.pid]) {
            produk[row.dataset.pid] = true;
            jenis += 1;
          }
        }

        Array.prototype.forEach.call(row.querySelectorAll('[data-qty-teks]'), function (el) {
          el.textContent = String(qty);
        });
        var sub = row.querySelector('[data-subtotal-baris]');
        if (sub) sub.textContent = rupiah.format(qty * parseFloat(row.dataset.harga || '0'));
      });

      if (pesanKeranjangKosong) pesanKeranjangKosong.classList.toggle('hidden', jalur > 0);
      if (selRingkas) {
        selRingkas.textContent =
          jalur > 0
            ? jenis + ' produk · ' + jalur + ' baris batch · ' + item + ' pack'
            : 'Keranjang kosong';
      }

      // --- Pembayaran ---------------------------------------------------
      var isShopee = kanal() === 'shopee';

      // Ongkir tidak berlaku sama sekali untuk Shopee -- kolomnya
      // disembunyikan, dan nilainya dipaksa nol di sini juga supaya sisa
      // angka lama dari kanal Toko tidak diam-diam ikut terhitung.
      var biaya = isShopee ? 0 : Math.max(0, parseFloat(ongkir.value) || 0);
      // Dipotong sampai setinggi-tingginya subtotal, sama seperti yang
      // dihitung server. Backend menolak yang melebihi; di sini angkanya
      // cuma tidak dibiarkan membuat total negatif di layar.
      var potongan = Math.min(subtotal, Math.max(0, parseFloat(diskon.value) || 0));

      // Shopee tidak punya pilihan metode -- uangnya sudah pasti diterima
      // lewat ShopeePay. Radio "E-wallet" dipaksa tercentang di sini (bukan
      // cuma di render awal server) supaya kasir yang mengganti kanal tanpa
      // reload tidak diam-diam mengirim metode lama (mis. tunai).
      if (isShopee) {
        var radioEwallet = borang.querySelector('[data-metode][value="ewallet"]');
        if (radioEwallet && !radioEwallet.checked) radioEwallet.checked = true;
      }
      if (blokMetodePilihan) blokMetodePilihan.classList.toggle('hidden', isShopee);
      if (blokMetodeShopee) blokMetodeShopee.classList.toggle('hidden', !isShopee);
      if (blokCommissionFee) blokCommissionFee.classList.toggle('hidden', !isShopee);
      if (blokOngkir) blokOngkir.classList.toggle('hidden', isShopee);
      if (blokDibayar) blokDibayar.classList.toggle('hidden', isShopee);
      if (blokCepat) blokCepat.classList.toggle('hidden', isShopee);

      // Kosong jatuh ke tarif bawaan, dan dijepit 0-100 -- sama seperti
      // server (lihat `jepitPersen` di frontmatter Astro).
      function persenInput(input, bawaan) {
        var mentah = input ? input.value.trim() : '';
        return mentah === '' ? bawaan : Math.min(100, Math.max(0, parseFloat(mentah) || bawaan));
      }
      var commissionPersen = persenInput(commissionFeeInput, SHOPEE_COMMISSION_PERSEN_DEFAULT);
      var servicePersen = persenInput(serviceFeeInput, SHOPEE_SERVICE_PERSEN_DEFAULT);

      // Basis potongan Shopee: omzet SETELAH diskon. Sama dengan
      // `basis_fee` di backend/src/pos/service.rs.
      var basisFee = Math.max(0, subtotal - potongan);
      var biayaKomisi = isShopee ? biayaPersenRupiah(basisFee, commissionPersen) : 0;
      var biayaLayanan = isShopee ? biayaPersenRupiah(basisFee, servicePersen) : 0;
      var biayaPph = isShopee ? biayaPersenRupiah(basisFee, SHOPEE_WITHHOLDING_TAX_PERSEN) : 0;
      var biayaProses = isShopee ? SHOPEE_ORDER_PROCESSING_FEE : 0;

      // Untuk Shopee ini BUKAN lagi "yang dibayar pembeli" -- pembeli sudah
      // membayar penuh di Shopee. Ini estimasi yang cair ke toko setelah
      // keempat potongan di atas, dan itulah kenapa labelnya berganti jadi
      // "Estimasi Total Penghasilan" di bawah. `biaya` (ongkir) sudah nol
      // untuk Shopee, jadi rumusnya tetap satu untuk semua kanal.
      var total = subtotal - potongan + biaya - biayaKomisi - biayaLayanan - biayaPph - biayaProses;
      var adaTunai = tunai();

      selSubtotal.textContent = rupiah.format(subtotal);
      barisDiskon.classList.toggle('hidden', potongan <= 0);
      selDiskon.textContent = '-' + rupiah.format(potongan);
      if (barisOngkir) barisOngkir.classList.toggle('hidden', isShopee);
      selOngkir.textContent = rupiah.format(biaya);
      if (labelTotal) labelTotal.textContent = isShopee ? 'Estimasi Total Penghasilan' : 'Total';
      selTotal.textContent = rupiah.format(total);

      if (barisBiayaKomisi && selBiayaKomisi) {
        barisBiayaKomisi.classList.toggle('hidden', !isShopee);
        if (isShopee) {
          if (selBiayaKomisiPersen) selBiayaKomisiPersen.textContent = String(commissionPersen);
          selBiayaKomisi.textContent = '-' + rupiah.format(biayaKomisi);
        }
      }
      if (barisBiayaLayanan && selBiayaLayanan) {
        barisBiayaLayanan.classList.toggle('hidden', !isShopee);
        if (isShopee) {
          if (selBiayaLayananPersen) selBiayaLayananPersen.textContent = String(servicePersen);
          selBiayaLayanan.textContent = '-' + rupiah.format(biayaLayanan);
        }
      }
      if (barisBiayaPph && selBiayaPph) {
        barisBiayaPph.classList.toggle('hidden', !isShopee);
        if (isShopee) selBiayaPph.textContent = '-' + rupiah.format(biayaPph);
      }
      if (barisBiayaProses && selBiayaProses) {
        barisBiayaProses.classList.toggle('hidden', !isShopee);
        if (isShopee) selBiayaProses.textContent = '-' + rupiah.format(biayaProses);
      }

      // Kolom uang diterima hanya berlaku untuk tunai; dimatikan supaya
      // angkanya tidak ikut terkirim sebagai pembayaran yang tidak pernah
      // terjadi.
      dibayar.disabled = !adaTunai;

      var bayar = parseFloat(dibayar.value);
      var adaBayar = adaTunai && !isNaN(bayar);
      var kurang = adaBayar && bayar < total;

      kotakKembalian.className =
        (kurang ? 'kotak-kurang' : 'kotak-kembalian') + (adaBayar ? '' : ' hidden');
      labelKembalian.textContent = kurang ? 'Uang yang diterima masih kurang' : 'Kembalian';
      selKembalian.textContent = adaBayar ? rupiah.format(Math.abs(bayar - total)) : '—';

      // Yang menahan penjualan tetap backend. Tombol ini cuma berhenti
      // menawarkan aksi yang sudah pasti ditolak -- dan menyebutkan alasannya,
      // supaya kasir tidak menekan tombol mati tanpa tahu apa yang kurang.
      var bisa = jalur > 0 && (!adaTunai || (adaBayar && bayar >= total));
      tombolBayar.disabled = !bisa;
      tombolBayar.textContent =
        jalur === 0
          ? 'Keranjang masih kosong'
          : adaTunai && !adaBayar
            ? 'Isi uang diterima'
            : kurang
              ? 'Uang yang diterima masih kurang'
              : 'Selesaikan · ' + rupiah.format(total);

      if (bilahItem) bilahItem.textContent = String(item);
      if (bilahTotal) bilahTotal.textContent = rupiah.format(total);
    }

    // Batasnya sisa BATCH ini, bukan stok produk: dua batch produk yang sama
    // punya jatah sendiri-sendiri, dan menjumlahkannya di sini akan
    // menjanjikan butir yang tidak ada di kiriman yang dipilih.
    function ubah(kolom, selisih) {
      var sisa = parseInt(kolom.dataset.sisa || '0', 10);
      var angka = nilai(kolom) + selisih;
      if (angka < 0) angka = 0;
      if (angka > sisa) angka = sisa;
      kolom.value = String(angka);
      hitung();
    }

    function kolomDi(el) {
      var barisBatch = el.closest('[data-baris-batch]');
      return barisBatch ? barisBatch.querySelector('[data-qty]') : null;
    }

    function kolomKeranjang(el) {
      var row = el.closest('[data-baris-keranjang]');
      return row ? document.getElementById(row.dataset.kolom) : null;
    }

    borang.addEventListener('click', function (e) {
      // `[data-cetak-struk]` ditangani skrip module terpisah di bawah
      // (butuh `import` untuk merender nota jadi gambar, yang tidak bisa
      // dilakukan di sini -- lihat catatan `is:inline` di atas skrip ini).

      var buka = e.target.closest('[data-buka-batch]');
      if (buka) {
        var panel = buka.closest('[data-produk]').querySelector('[data-panel-batch]');
        if (panel) panel.showModal();
        return;
      }

      var tutup = e.target.closest('[data-tutup-batch]');
      if (tutup) {
        tutup.closest('[data-panel-batch]').close();
        return;
      }

      var tambah = e.target.closest('[data-tambah]');
      if (tambah) {
        var kolomTambah = kolomDi(tambah);
        if (kolomTambah) ubah(kolomTambah, 1);
        return;
      }

      var kurang = e.target.closest('[data-kurang]');
      if (kurang) {
        var kolomKurang = kolomDi(kurang);
        if (kolomKurang) ubah(kolomKurang, -1);
        return;
      }

      // Kendali −/+ di panel keranjang menulis ke KOLOM YANG SAMA milik
      // katalog, bukan ke salinan: yang tampil di panel hanyalah angkanya.
      var tambahK = e.target.closest('[data-tambah-keranjang]');
      if (tambahK) {
        var kolomTambahK = kolomKeranjang(tambahK);
        if (kolomTambahK) ubah(kolomTambahK, 1);
        return;
      }

      var kurangK = e.target.closest('[data-kurang-keranjang]');
      if (kurangK) {
        var kolomKurangK = kolomKeranjang(kurangK);
        if (kolomKurangK) ubah(kolomKurangK, -1);
        return;
      }

      var pas = e.target.closest('[data-uang-pas]');
      if (pas) {
        dibayar.value = String(totalBerjalan());
        hitung();
        return;
      }

      var nominal = e.target.closest('[data-nominal]');
      if (nominal) {
        dibayar.value = nominal.dataset.nominal;
        hitung();
      }
    });

    /** Total berjalan, dibaca dari angka yang barusan dirender -- bukan dari
        nilai yang dirender server saat halaman dimuat. */
    function totalBerjalan() {
      var subtotal = barisKeranjang.reduce(function (n, row) {
        var qty = nilai(document.getElementById(row.dataset.kolom));
        return n + qty * parseFloat(row.dataset.harga || '0');
      }, 0);
      var potongan = Math.min(subtotal, Math.max(0, parseFloat(diskon.value) || 0));
      return subtotal - potongan + Math.max(0, parseFloat(ongkir.value) || 0);
    }

    // Enter di dalam panel batch men-submit form, dan pop up yang sedang
    // dibuka lenyap bersama halamannya. Di dalam panel, Enter menutup panel
    // saja; di kolom pencarian, Enter membuka panel produk teratas.
    borang.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;

      var panel = e.target.closest('[data-panel-batch]');
      if (panel && panel.open) {
        e.preventDefault();
        panel.close();
        return;
      }

      if (e.target === kotakCari) {
        var teratas = baris.filter(function (row) {
          return !row.hidden;
        })[0];
        if (!teratas) return;
        e.preventDefault();
        var panelTeratas = teratas.querySelector('[data-panel-batch]');
        if (panelTeratas) panelTeratas.showModal();
      }
    });

    borang.addEventListener('input', function (e) {
      if (
        e.target.matches(
          '[data-qty], [data-qty-luar], [data-ongkir], [data-diskon], [data-dibayar], [data-commission-fee], [data-service-fee]'
        )
      )
        hitung();
      if (e.target === kotakCari) saring();
    });

    // Pil kategori menyaring di tempat, tidak mengirim form: mengirimnya
    // berarti memuat ulang halaman, dan keranjang yang sedang dibangun ikut
    // melewati server tanpa alasan.
    if (pil) {
      pil.addEventListener('change', function () {
        saring();
        Array.prototype.forEach.call(pil.querySelectorAll('label'), function (l) {
          l.className = l.querySelector('input').checked ? 'pil-aktif' : 'pil-diam';
        });
      });
    }

    borang.addEventListener('change', function (e) {
      if (e.target.matches('[data-metode]')) hitung();
      // Ganti kanal berarti seluruh harga di layar berganti, jadi harganya
      // ditulis ulang dulu -- `hitung` menjumlahkan dari angka itu.
      if (e.target.matches('[data-kanal]')) {
        terapkanKanal();
        hitung();
      }
    });

    function saring() {
      var kata = (kotakCari ? kotakCari.value : '').trim().toLowerCase();
      var terpilih = pil ? pil.querySelector('input:checked') : null;
      var kategori = terpilih ? terpilih.value : '';
      var terlihat = 0;

      baris.forEach(function (row) {
        var cocokKata =
          !kata ||
          row.dataset.nama.indexOf(kata) !== -1 ||
          row.dataset.sku.indexOf(kata) !== -1;
        var cocokKategori = !kategori || row.dataset.kategori === kategori;
        // Barang yang sudah masuk keranjang tidak pernah disembunyikan --
        // kalau hilang dari layar, kasir tidak punya cara membatalkannya.
        var diKeranjang = jumlahBaris(row) > 0;
        var tampil = diKeranjang || (cocokKata && cocokKategori);
        row.hidden = !tampil;
        if (tampil) terlihat += 1;
      });

      if (pesanKosong) pesanKosong.classList.toggle('hidden', terlihat > 0);
    }

    hitung();
  })();
</script>

{/*
  Cetak/bagikan nota lewat share sheet OS.

  Terpisah dari skrip `is:inline` di atas karena ini satu-satunya bagian
  halaman kasir yang butuh `import` (`html2canvas-pro`, untuk merender
  `.nota-cetak` jadi PNG) -- Astro membundel skrip module lewat Vite,
  bukan skrip `is:inline`.

  BUKAN `html-to-image`: library itu merender lewat trik SVG
  `<foreignObject>` (serialisasi node jadi `<img>` bergambar SVG, lalu
  digambar ke kanvas) yang terbukti gagal SENYAP untuk nota ini -- `toBlob`
  selesai tanpa galat, tapi kanvas hasilnya kosong transparan, tidak cuma di
  proyek ini (lihat isu bubkoo/html-to-image #160/#199/#449). `html2canvas-pro`
  menggambar tiap elemen ke kanvas satu per satu, tanpa lewat `<foreignObject>`
  sama sekali, jadi tidak kena batasan itu. Dipilih "-pro" (fork terawat dari
  html2canvas), bukan `html2canvas` biasa, karena varian asli gagal mem-parse
  warna `oklch()` -- dipakai luas di tema Tailwind v4 situs ini (lihat
  `--color-stone-*`/`--color-emerald-*` di `theme.css`) walau nota sendiri
  cuma hitam-putih; `html2canvas-pro` mendukungnya.

  Alurnya: render `.nota-cetak` (nota yang sama yang dipakai `@media print`)
  jadi gambar PNG dari klon off-screen, lalu:
    1. Kalau `navigator.share` bisa menerima file (Web Share API level 2 --
       Android Chrome, iOS Safari, dan Chromium desktop), buka share sheet
       supaya kasir bisa memilih app seperti OpenLabel+ untuk mencetak lewat
       printer thermal Bluetooth.
    2. Kalau tidak didukung (mis. Firefox desktop) atau kasir membatalkan
       pemilihan app lalu batal, unduh PNG-nya supaya tetap bisa dibuka
       manual dari OpenLabel+.
    3. Kalau perenderan gambarnya sendiri gagal (mis. galat tak terduga dari
       library), jatuh ke `window.print()` bawaan browser supaya kasir tidak
       pernah mentok tanpa cara mencetak sama sekali.
*/}
<script>
  import html2canvas from 'html2canvas-pro';

  const tombolCetak = document.querySelector('[data-cetak-struk]');
  const nota = document.querySelector<HTMLElement>('[data-nota-cetak]');

  if (tombolCetak && nota) {
    tombolCetak.addEventListener('click', async () => {
      let file;
      try {
        file = await notaKeFile(nota);
      } catch {
        window.print();
        return;
      }

      const bisaBagikan =
        typeof navigator.canShare === 'function' && navigator.canShare({ files: [file] });
      if (bisaBagikan) {
        try {
          await navigator.share({ files: [file], title: 'Nota' });
          return;
        } catch (err) {
          // AbortError: kasir menutup share sheet sendiri -- bukan galat,
          // jangan lanjut ke unduhan supaya tidak mengejutkan.
          if (err instanceof Error && err.name === 'AbortError') return;
        }
      }

      unduh(file);
    });
  }

  async function notaKeFile(nota: HTMLElement) {
    const klon = nota.cloneNode(true) as HTMLElement;
    // `.nota-cetak` sendiri `display: none` di layar (lihat theme.css) --
    // style inline di sini menang atas itu tanpa mengubah elemen aslinya.
    klon.style.display = 'block';
    klon.style.position = 'fixed';
    klon.style.left = '-9999px';
    klon.style.top = '0';
    klon.style.background = '#ffffff';
    // Padding di sini saja, bukan ditambahkan ke `.nota-cetak` sendiri: PNG ini
    // dibagikan/diunduh apa adanya (jadi butuh jarak dari tepi gambar), sedangkan
    // `@media print` mencetak ke kertas struk yang marginnya sudah urusan printer.
    klon.style.padding = '16px';
    document.body.appendChild(klon);
    try {
      const kanvas = await html2canvas(klon, { backgroundColor: '#ffffff', scale: 3 });
      const blob = await new Promise<Blob | null>((resolve) => kanvas.toBlob(resolve));
      if (!blob) throw new Error('toBlob mengembalikan kosong');
      return new File([blob], 'nota-' + Date.now() + '.png', { type: 'image/png' });
    } finally {
      klon.remove();
    }
  }

  function unduh(file: File) {
    const url = URL.createObjectURL(file);
    const a = document.createElement('a');
    a.href = url;
    a.download = file.name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
</script>
