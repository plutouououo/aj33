---
import AppShell from '../layouts/AppShell.astro';
import { api, ApiRequestError, type User } from '../lib/api';
import { berandaUntuk, simpanSesi } from '../lib/session';

// Sudah login: tidak perlu melihat halaman ini lagi.
if (Astro.locals.user) {
  return Astro.redirect(berandaUntuk(Astro.locals.user.role), 302);
}

let galat: string | null = null;
let username = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  username = String(form.get('email_or_username') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!username || !password) {
    galat = 'Username dan password wajib diisi.';
  } else {
    try {
      const hasil = await api<{ token: string; user: User }>('/auth/login', {
        method: 'POST',
        body: { email_or_username: username, password },
      });

      simpanSesi(Astro.cookies, hasil.token);
      return Astro.redirect(berandaUntuk(hasil.user.role), 302);
    } catch (err) {
      galat =
        err instanceof ApiRequestError
          ? err.message
          : 'Tidak bisa menghubungi server. Coba lagi sebentar lagi.';
    }
  }
}
---

<AppShell judul="Masuk">
  <div class="mx-auto max-w-sm">
    <div class="mb-8 text-center">
      <span class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-xl bg-merah-600 text-lg font-bold text-white">
        B
      </span>
      <h1 class="text-2xl font-bold tracking-tight">Masuk ke AJ33</h1>
      <p class="mt-1 text-sm text-stone-500">Kasir, stok, dan pesanan dalam satu tempat.</p>
    </div>

    <form method="POST" class="kartu space-y-4">
      {galat && <p class="galat" role="alert">{galat}</p>}

      <div>
        <label class="label" for="username">Username</label>
        <input
          class="kolom"
          id="username"
          name="email_or_username"
          value={username}
          autocomplete="username"
          required
          autofocus
        />
      </div>

      <div>
        <label class="label" for="password">Password</label>
        <input
          class="kolom"
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button class="tombol-utama w-full" type="submit">Masuk</button>
    </form>
  </div>
</AppShell>
