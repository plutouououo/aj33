---
/** Pengaturan harga: batas grosir bawaan untuk produk yang tak mengatur batasnya sendiri (jumlah pack lebih dari batas memakai harga grosir kanalnya) dan persen potongan Shopee dan Tokopedia yang jadi bawaan kasir. */
import Galat from '../../components/Galat.astro';
import PengaturanShell from '../../layouts/PengaturanShell.astro';
import { api, ApiRequestError, type PricingSettings } from '../../lib/api';
import { rupiah } from '../../lib/format';
import { pesanDari, sesudahAksi } from '../../lib/pesan';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

let galat: string | null = null;
let sukses: string | null = null;
let isiBatas: string | null = null;
let isiKomisi: string | null = null;
let isiLayanan: string | null = null;
let isiKomisiTiktok: string | null = null;
let isiDinamis: string | null = null;
let isiLogistik: string | null = null;

/** Persen dari form (17,25) jadi pecahan backend (0,1725); `null` bila bukan angka 0–100. */
function keDesimal(isi: string): number | null {
  const persen = Number(isi);
  if (isi === '' || !Number.isFinite(persen) || persen < 0 || persen > 100) return null;
  return Number((persen / 100).toFixed(4));
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const aksi = String(form.get('aksi') ?? '');

  if (aksi === 'biaya-shopee') {
    isiKomisi = String(form.get('shopee_commission_percent') ?? '').trim();
    isiLayanan = String(form.get('shopee_service_percent') ?? '').trim();
    const komisi = keDesimal(isiKomisi);
    const layanan = keDesimal(isiLayanan);

    if (komisi === null || layanan === null) {
      galat = 'Persentase biaya Shopee harus berupa angka 0 sampai 100.';
    } else {
      try {
        await api<PricingSettings>('/settings/shopee-fees', {
          method: 'PATCH',
          token,
          body: { shopee_commission_percent: komisi, shopee_service_percent: layanan },
        });
        return Astro.redirect(sesudahAksi(Astro.url, 'simpan-biaya'), 303);
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan biaya Shopee.';
      }
    }
  } else if (aksi === 'biaya-tiktok') {
    isiKomisiTiktok = String(form.get('tiktok_commission_percent') ?? '').trim();
    isiDinamis = String(form.get('tiktok_dynamic_commission_percent') ?? '').trim();
    isiLogistik = String(form.get('tiktok_logistics_percent') ?? '').trim();
    const komisi = keDesimal(isiKomisiTiktok);
    const dinamis = keDesimal(isiDinamis);
    const logistik = keDesimal(isiLogistik);

    if (komisi === null || dinamis === null || logistik === null) {
      galat = 'Persentase biaya Tokopedia harus berupa angka 0 sampai 100.';
    } else {
      try {
        await api<PricingSettings>('/settings/tiktok-fees', {
          method: 'PATCH',
          token,
          body: {
            tiktok_commission_percent: komisi,
            tiktok_dynamic_commission_percent: dinamis,
            tiktok_logistics_percent: logistik,
          },
        });
        return Astro.redirect(sesudahAksi(Astro.url, 'simpan-biaya-tiktok'), 303);
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan biaya Tokopedia.';
      }
    }
  } else {
    isiBatas = String(form.get('wholesale_threshold_qty') ?? '').trim();
    const batas = Number(isiBatas);

    if (isiBatas === '' || !Number.isInteger(batas) || batas <= 0) {
      galat = 'Batas grosir harus bilangan bulat lebih dari 0 pack.';
    } else {
      try {
        await api<PricingSettings>('/settings/pricing', {
          method: 'PATCH',
          token,
          body: { wholesale_threshold_qty: batas },
        });
        return Astro.redirect(sesudahAksi(Astro.url, 'simpan'), 303);
      } catch (err) {
        galat = err instanceof ApiRequestError ? err.message : 'Gagal menyimpan pengaturan harga.';
      }
    }
  }
}

if (!galat) {
  sukses = pesanDari(Astro.url, {
    simpan: 'Batas grosir tersimpan. Berlaku untuk transaksi berikutnya.',
    'simpan-biaya': 'Biaya Shopee tersimpan. Jadi bawaan kasir untuk pesanan Shopee berikutnya.',
    'simpan-biaya-tiktok': 'Biaya Tokopedia tersimpan. Jadi bawaan kasir untuk pesanan Tokopedia berikutnya.',
  });
}

const pengaturan = await api<PricingSettings>('/settings/pricing', { token });

/** Pecahan backend jadi persen tampil tanpa sisa float (0,1725 → "17.25"). */
const keTeksPersen = (pecahan: number): string => String(Number((pecahan * 100).toFixed(2)));
---

<PengaturanShell judul="Harga" user={user}>

  <Galat pesan={galat} class="mb-4" />
  {sukses && <p class="sukses mb-4">{sukses}</p>}

  <form method="POST" class="kartu borang-tegak mb-6">
    <h2 class="font-semibold">Batas grosir bawaan</h2>
    <p class="text-sm text-[var(--color-teks-lembut)]">
      Dipakai produk yang batas grosirnya dikosongkan. Batas tiap produk di tiap kanal diatur di halaman produknya.
    </p>

    <div class="isian isian-pendek">
      <label class="label" for="wholesale_threshold_qty">Grosir bila lebih dari (pack)</label>
      <input
        class="kolom"
        id="wholesale_threshold_qty"
        name="wholesale_threshold_qty"
        type="number"
        min="1"
        step="1"
        inputmode="numeric"
        value={isiBatas ?? String(pengaturan.wholesale_threshold_qty)}
        required
      />
      <p class="isian-bantu">
        Saat ini: lebih dari {pengaturan.wholesale_threshold_qty} pack grosir, sampai
        {pengaturan.wholesale_threshold_qty} pack ecer.
      </p>
    </div>

    <button class="tombol-utama" type="submit">Simpan batas</button>
  </form>

  <form method="POST" class="kartu borang-tegak mb-6">
    <input type="hidden" name="aksi" value="biaya-shopee" />
    <h2 class="font-semibold">Biaya Shopee</h2>

    <div class="isian isian-pendek">
      <label class="label" for="shopee_commission_percent">Biaya komisi (%)</label>
      <input
        class="kolom tabular-nums"
        id="shopee_commission_percent"
        name="shopee_commission_percent"
        type="number"
        min="0"
        max="100"
        step="0.01"
        inputmode="decimal"
        value={isiKomisi ?? keTeksPersen(pengaturan.shopee_commission_percent)}
        required
      />
    </div>

    <div class="isian isian-pendek">
      <label class="label" for="shopee_service_percent">Biaya layanan (%)</label>
      <input
        class="kolom tabular-nums"
        id="shopee_service_percent"
        name="shopee_service_percent"
        type="number"
        min="0"
        max="100"
        step="0.01"
        inputmode="decimal"
        value={isiLayanan ?? keTeksPersen(pengaturan.shopee_service_percent)}
        required
      />
      <p class="isian-bantu">Isi 0 bila toko tidak ikut program berbayar Shopee.</p>
    </div>

    <button class="tombol-halus" type="submit">Simpan biaya Shopee</button>
  </form>

  <form method="POST" class="kartu borang-tegak mb-6">
    <input type="hidden" name="aksi" value="biaya-tiktok" />
    <h2 class="font-semibold">Biaya Tokopedia / TikTok Shop</h2>
    <p class="text-sm text-[var(--color-teks-lembut)]">
      Ketiganya dihitung dari omzet barang, sama seperti rincian "Detail Penyelesaian Pembayaran" di aplikasi
      penjual. Cocokkan dengan pesanan asli bila angkanya berubah.
    </p>

    <div class="isian isian-pendek">
      <label class="label" for="tiktok_commission_percent">Biaya komisi platform (%)</label>
      <input
        class="kolom tabular-nums"
        id="tiktok_commission_percent"
        name="tiktok_commission_percent"
        type="number"
        min="0"
        max="100"
        step="0.01"
        inputmode="decimal"
        value={isiKomisiTiktok ?? keTeksPersen(pengaturan.tiktok_commission_percent)}
        required
      />
    </div>

    <div class="isian isian-pendek">
      <label class="label" for="tiktok_dynamic_commission_percent">Komisi dinamis (%)</label>
      <input
        class="kolom tabular-nums"
        id="tiktok_dynamic_commission_percent"
        name="tiktok_dynamic_commission_percent"
        type="number"
        min="0"
        max="100"
        step="0.01"
        inputmode="decimal"
        value={isiDinamis ?? keTeksPersen(pengaturan.tiktok_dynamic_commission_percent)}
        required
      />
    </div>

    <div class="isian isian-pendek">
      <label class="label" for="tiktok_logistics_percent">Biaya layanan logistik (%)</label>
      <input
        class="kolom tabular-nums"
        id="tiktok_logistics_percent"
        name="tiktok_logistics_percent"
        type="number"
        min="0"
        max="100"
        step="0.01"
        inputmode="decimal"
        value={isiLogistik ?? keTeksPersen(pengaturan.tiktok_logistics_percent)}
        required
      />
      <p class="isian-bantu">Ongkir yang ditanggung platform tidak ikut dihitung; hanya biaya layanan ini.</p>
    </div>

    <button class="tombol-halus" type="submit">Simpan biaya Tokopedia</button>
  </form>

  <section class="kartu borang-tegak mb-6">
    <h2 class="font-semibold">Biaya tetap</h2>
    <p class="text-sm text-[var(--color-teks-lembut)]">Ditetapkan sistem dan tidak bisa diubah.</p>

    <div class="isian isian-pendek">
      <label class="label" for="pph_umkm">PPh UMKM (%)</label>
      <input
        class="kolom tabular-nums"
        id="pph_umkm"
        type="text"
        value={keTeksPersen(pengaturan.withholding_tax_percent)}
        readonly
        disabled
      />
      <p class="isian-bantu">Dari omzet barang, untuk kanal Toko, Shopee, dan Tokopedia. Di Toko menjadi beban toko, tidak mengurangi tagihan pembeli.</p>
    </div>

    <div class="isian isian-pendek">
      <label class="label" for="biaya_proses">Biaya proses pemesanan (Rp)</label>
      <input
        class="kolom tabular-nums"
        id="biaya_proses"
        type="text"
        value={rupiah(pengaturan.order_processing_fee)}
        readonly
        disabled
      />
      <p class="isian-bantu">Per transaksi, untuk kanal Shopee dan Tokopedia.</p>
    </div>
  </section>
</PengaturanShell>
