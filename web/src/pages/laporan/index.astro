---
import AppShell from '../../layouts/AppShell.astro';
import Paginasi from '../../components/Paginasi.astro';
import Peringatan from '../../components/Peringatan.astro';
import TabLaporan from '../../components/TabLaporan.astro';
import { api, type SalesReport } from '../../lib/api';
import { hitungTren, kg, labelTren, rupiah, waktu } from '../../lib/format';
import {
  JENIS,
  METODE,
  PERIODE,
  PERIODE_TANGGAL,
  bacaSaringan,
  kueriApi,
  kueriHalaman,
  kueriPeriodeHalaman,
  labelButir,
  labelJenis,
  labelKanal,
  labelMetode,
  labelPeriode,
  nomorPesanan,
} from '../../lib/laporan';

const user = Astro.locals.user!;
const token = Astro.locals.token!;

const saringan = bacaSaringan(Astro.url);

const TERLARIS_PER_HALAMAN = 5;
const PENJUALAN_PER_HALAMAN = 10;

function bacaHalaman(nama: string): number {
  return Math.max(1, Math.floor(Number(Astro.url.searchParams.get(nama))) || 1);
}

const halamanTerlaris = bacaHalaman('hal_terlaris');
const halamanJual = bacaHalaman('hal_jual');

const laporan = await api<SalesReport>(
  `/reports/sales?${kueriApi(
    saringan,
    { batas: PENJUALAN_PER_HALAMAN, lewati: (halamanJual - 1) * PENJUALAN_PER_HALAMAN },
    { batas: TERLARIS_PER_HALAMAN, lewati: (halamanTerlaris - 1) * TERLARIS_PER_HALAMAN },
  )}`,
  { token },
);

const kueri = kueriHalaman(saringan);
// Penanda di tombol Filter ponsel: hanya saringan utama, periode baku (Bulan Ini) tidak dihitung.
const jumlahSaringan = [saringan.periode !== 'month', saringan.metode, saringan.jenis].filter(Boolean).length;
const tautanEkspor = kueri ? `/laporan/ekspor.csv?${kueri}` : '/laporan/ekspor.csv';
const kueriPeriode = kueriPeriodeHalaman(saringan).toString();
const tautanBeban = `/laporan/beban${kueriPeriode ? `?${kueriPeriode}` : ''}`;
const tautanProduk = `/laporan/produk${kueriPeriode ? `?${kueriPeriode}` : ''}`;

const { summary, previous_summary, trend, channels, expense_breakdown, top_products, top_products_total, sales } =
  laporan;

const terlarisTerakhir = Math.max(1, Math.ceil(top_products_total / TERLARIS_PER_HALAMAN));
const jualTerakhir = Math.max(1, Math.ceil(summary.transaction_count / PENJUALAN_PER_HALAMAN));

/** Tautan ke halaman lain salah satu daftar; saringan dan halaman daftar satunya tetap terbawa. */
function tautanHalaman(daftar: 'hal_terlaris' | 'hal_jual', ke: number, jangkar: string): string {
  const p = new URLSearchParams(kueri);
  const halaman = { hal_terlaris: halamanTerlaris, hal_jual: halamanJual };
  halaman[daftar] = ke;
  for (const [nama, nilai] of Object.entries(halaman)) {
    if (nilai > 1) p.set(nama, String(nilai));
  }
  const q = p.toString();
  return `/laporan${q ? `?${q}` : ''}#${jangkar}`;
}

const butir = trend.granularity;
const titik = trend.points;
// Satu skala untuk omzet dan laba kotor agar tinggi batang keduanya bisa dibandingkan langsung.
const puncak = Math.max(1, ...titik.map((t) => t.revenue));
// Label sumbu dijarangkan agar tak bertumpuk; batang tetap satu per butir.
const langkahLabel = Math.max(1, Math.ceil(titik.length / 12));
const NAMA_BUTIR = { hour: 'Per jam', day: 'Per hari', month: 'Per bulan' } as const;

/** Label sumbu: butir bulan hanya menyebut tahun di batang pertama dan Januari supaya label tetap pendek. */
function labelSumbu(start: string, i: number): string {
  if (butir !== 'month' || i === 0 || start.slice(5, 7) === '01') return labelButir(start, butir);
  return labelButir(start, butir).slice(0, 3);
}

/** Tinggi batang dalam persen, minimal terlihat kalau nilainya bukan nol. */
function tinggi(nilai: number): string {
  if (nilai <= 0) return '0%';
  return `${Math.max(2, (nilai / puncak) * 100)}%`;
}

// Tabel rincian hanya untuk butir hari dan bulan, karena beban dicatat per tanggal dan laba per jam tak bisa dihitung jujur; butir yang sepi sama sekali disembunyikan.
const barisRincian = butir === 'hour' ? [] : titik.filter((t) => t.transaction_count > 0 || t.expenses !== 0 || t.stock_loss !== 0);
const jumlahRincian = barisRincian.reduce(
  (j, t) => ({
    transaction_count: j.transaction_count + t.transaction_count,
    revenue: j.revenue + t.revenue,
    cogs: j.cogs + t.cogs,
    platform_fees: j.platform_fees + t.platform_fees,
    expenses: j.expenses + t.expenses,
    stock_loss: j.stock_loss + t.stock_loss,
    profit: j.profit + t.profit,
  }),
  { transaction_count: 0, revenue: 0, cogs: 0, platform_fees: 0, expenses: 0, stock_loss: 0, profit: 0 },
);

// Kolom kerugian stok hanya muncul bila ada, supaya tabel tak bertambah lebar untuk angka nol.
const adaRugi = jumlahRincian.stock_loss !== 0;

const totalBeban = expense_breakdown.reduce((j, b) => j + b.amount, 0);

const omzetKanal = channels.reduce((j, k) => j + k.revenue, 0);
const labaKanal = channels.reduce((j, k) => j + k.profit, 0);
// Laba kanal belum mengurangi tabel beban toko (tak dicatat per kanal); ongkir ditanggung toko sudah ada di laba kanal, jadi dikeluarkan dari beban agar tak terhitung dua kali.
const bebanUmum = summary.expenses - channels.reduce((j, k) => j + k.shipping_subsidy, 0);
const puncakLaba = Math.max(1, ...channels.map((k) => Math.abs(k.profit)));

/** Marjin kotor: bagian omzet yang tersisa setelah harga pokok. */
const marjin = summary.revenue > 0 ? ((summary.revenue - summary.cogs) / summary.revenue) * 100 : 0;
---

<AppShell judul="Laporan · Ringkasan" user={user}>
  <TabLaporan saringan={saringan} />

  {/* Saringan dikirim sebagai GET agar keadaan laporan ada di URL (bisa di-bookmark, dibagikan) dan tombol ekspor membaca periode yang sama; di ponsel formnya dibuka tombol Filter lewat checkbox `peer` (tanpa JS, seperti laci sidebar). */}
  <div class="mb-5 grid grid-cols-2 gap-2 md:block">
    <input type="checkbox" id="buka-saringan" class="peer sr-only" />
    <label
      for="buka-saringan"
      class="tombol-halus cursor-pointer gap-2 md:hidden peer-checked:border-merah-600 peer-checked:bg-merah-50 peer-checked:text-merah-700 peer-focus-visible:ring-2 peer-focus-visible:ring-merah-600"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 5h18M6 12h12M10 19h4" />
      </svg>
      Filter
      {jumlahSaringan > 0 && <span class="lencana bg-merah-600 text-white">{jumlahSaringan}</span>}
    </label>
    <a class="tombol-utama md:hidden" href={tautanEkspor} download>↓ Ekspor CSV</a>

  <form
    method="GET"
    id="saringan"
    action="#saringan"
    class="kartu col-span-2 hidden gap-4 peer-checked:grid sm:grid-cols-2 md:grid lg:grid-cols-5"
  >
    <div>
      <label class="label" for="periode">Periode</label>
      <select class="kolom" id="periode" name="periode">
        {PERIODE.map((p) => (
          <option value={p.nilai} selected={saringan.periode === p.nilai}>
            {p.label}
          </option>
        ))}
        <option value={PERIODE_TANGGAL} selected={saringan.periode === PERIODE_TANGGAL}>
          Pilih Tanggal
        </option>
      </select>
    </div>

    {/* Tanggal yang terisi menang atas pilihan periode (lihat `bacaSaringan`); skrip kecil di bawah hanya menyelaraskan keduanya, tanpa JS formulir tetap jalan. */}
    <div>
      <label class="label" for="dari">Dari Tanggal</label>
      <input class="kolom" type="date" id="dari" name="dari" value={saringan.dari} max={saringan.sampai || undefined} />
    </div>

    <div>
      <label class="label" for="sampai">Sampai Tanggal</label>
      <input class="kolom" type="date" id="sampai" name="sampai" value={saringan.sampai} min={saringan.dari || undefined} />
    </div>

    <div>
      <label class="label" for="metode">Metode Bayar</label>
      <select class="kolom" id="metode" name="metode">
        <option value="" selected={!saringan.metode}>Semua Metode</option>
        {METODE.map((m) => (
          <option value={m.nilai} selected={saringan.metode === m.nilai}>
            {m.label}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label class="label" for="jenis">Jenis Pembeli</label>
      <select class="kolom" id="jenis" name="jenis">
        <option value="" selected={!saringan.jenis}>Semua Jenis</option>
        {JENIS.map((j) => (
          <option value={j.nilai} selected={saringan.jenis === j.nilai}>
            {j.label}
          </option>
        ))}
      </select>
    </div>

    <div class="flex items-end gap-3 sm:col-span-2 lg:col-span-5">
      <button class="tombol-halus max-md:w-full" type="submit">Terapkan</button>
      <a class="tombol-utama max-md:hidden" href={tautanEkspor} download>↓ Ekspor CSV</a>
    </div>
  </form>
  </div>

  {/* Pil naik/turun hanya perbandingan arah, bukan penilaian baik/buruk; disembunyikan untuk "Seluruh Waktu" karena tak ada periode sebelumnya (lihat `previous_summary` di backend). */}
  <div class="ringkasan mb-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    <div class="kartu-angka bg-merah-600 text-white">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/15">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 6v12m3-8.5c0-1.38-1.34-2.5-3-2.5s-3 1.12-3 2.5 1.34 2.5 3 2.5 3 1.12 3 2.5-1.34 2.5-3 2.5-3-1.12-3-2.5" />
          </svg>
        </span>
        {hitungTren(summary.revenue, previous_summary?.revenue) && (
          <span class={`lencana-${hitungTren(summary.revenue, previous_summary?.revenue)!.arah}`}>
            {labelTren(hitungTren(summary.revenue, previous_summary?.revenue))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label !text-white/80">Omzet Barang</span>
      <span class="kartu-angka-nilai">{rupiah(summary.revenue)}</span>
      <span class="kartu-angka-bantu !text-white/70">
        {labelPeriode(saringan)} · ongkir {rupiah(summary.shipping)} di luar angka ini{summary.shipping_subsidy > 0 && ` · ongkir ditanggung toko ${rupiah(summary.shipping_subsidy)} masuk beban`}
      </span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.518l2.74-1.22M21.75 6.75l-5.94 2.28 2.28 5.94" />
          </svg>
        </span>
        {hitungTren(summary.profit, previous_summary?.profit) && (
          <span class={`lencana-${hitungTren(summary.profit, previous_summary?.profit)!.arah}`}>
            {labelTren(hitungTren(summary.profit, previous_summary?.profit))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Laba</span>
      <span class={summary.profit < 0 ? 'kartu-angka-nilai text-red-600' : 'kartu-angka-nilai'}>
        {rupiah(summary.profit)}
      </span>
      <span class="kartu-angka-bantu">Omzet − harga pokok − beban − potongan marketplace − stok terbuang</span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
          </svg>
        </span>
        {hitungTren(summary.cogs, previous_summary?.cogs) && (
          <span class={`lencana-${hitungTren(summary.cogs, previous_summary?.cogs)!.arah}`}>
            {labelTren(hitungTren(summary.cogs, previous_summary?.cogs))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Harga Pokok</span>
      <span class="kartu-angka-nilai">{rupiah(summary.cogs)}</span>
      <span class="kartu-angka-bantu">Marjin kotor {marjin.toFixed(1)}%</span>
    </div>

    {/* Omzet marketplace di atas masih kotor seperti di struk; potongannya sudah dikurangkan dari kartu Laba, kartu ini hanya menjelaskan asal selisihnya. */}
    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.659A2.25 2.25 0 009.568 3z M6 6h.008v.008H6V6z" />
          </svg>
        </span>
        {hitungTren(summary.platform_fees, previous_summary?.platform_fees) && (
          <span class={`lencana-${hitungTren(summary.platform_fees, previous_summary?.platform_fees)!.arah}`}>
            {labelTren(hitungTren(summary.platform_fees, previous_summary?.platform_fees))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Potongan Marketplace</span>
      <span class="kartu-angka-nilai">{rupiah(summary.platform_fees)}</span>
      <span class="kartu-angka-bantu">Komisi, biaya platform, PPh, dan biaya proses Shopee dan Tokopedia</span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12h6m-6 3.75h6M10.5 3H8.25A2.25 2.25 0 006 5.25v13.5A2.25 2.25 0 008.25 21h7.5A2.25 2.25 0 0018 18.75V8.25L12.75 3H10.5zm0 0v4.5a1.5 1.5 0 001.5 1.5h4.5" />
          </svg>
        </span>
        {hitungTren(summary.transaction_count, previous_summary?.transaction_count) && (
          <span class={`lencana-${hitungTren(summary.transaction_count, previous_summary?.transaction_count)!.arah}`}>
            {labelTren(hitungTren(summary.transaction_count, previous_summary?.transaction_count))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Order</span>
      <span class="kartu-angka-nilai">{summary.transaction_count}</span>
      <span class="kartu-angka-bantu">Beban tercatat {rupiah(summary.expenses)}</span>
    </div>

    <div class="kartu-angka">
      <div class="flex items-start justify-between gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-garis-lembut)] text-merah-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18M5.5 7h13M5.5 7l-2.5 6a3 3 0 005 0L5.5 7zM18.5 7l-2.5 6a3 3 0 005 0l-2.5-6zM8 21h8" />
          </svg>
        </span>
        {hitungTren(summary.sold_kg, previous_summary?.sold_kg) && (
          <span class={`lencana-${hitungTren(summary.sold_kg, previous_summary?.sold_kg)!.arah}`}>
            {labelTren(hitungTren(summary.sold_kg, previous_summary?.sold_kg))}
          </span>
        )}
      </div>
      <span class="kartu-angka-label">Kg Terjual</span>
      <span class="kartu-angka-nilai">{kg(summary.sold_kg)}</span>
      <span class="kartu-angka-bantu">Pack terjual × ukuran; produk tanpa ukuran tak ikut</span>
    </div>
  </div>

  {
    /* Harga pokok yang belum diisi membuat laba tampak lebih besar; dikatakan terang-terangan karena laba yang salah diam-diam lebih berbahaya daripada tanpa angka. */
    summary.items_without_cost > 0 && (
      <Peringatan class="mb-6">
        {summary.items_without_cost} baris penjualan keluar dari batch yang harga belinya
        belum diisi. Selama itu, <strong>harga pokok di atas terlalu kecil dan laba terlalu
        besar</strong>. Isi harga beli batch di halaman produk supaya angkanya benar.
      </Peringatan>
    )
  }

  <div class="mb-6 grid gap-4 lg:grid-cols-2">
    <section class="kartu">
      <h2 class="mb-1 text-base font-bold">Omzet per Kanal</h2>
      <p class="mb-5 text-xs text-[var(--color-teks-lembut)]">
        {labelPeriode(saringan)} · total {rupiah(omzetKanal)}
      </p>

      <ul class="space-y-4">
        {channels.map((k) => {
          const bagian = omzetKanal > 0 ? (k.revenue / omzetKanal) * 100 : 0;
          return (
            <li>
              <div class="flex items-baseline justify-between gap-4 text-sm">
                <span class="min-w-0 truncate font-medium">{labelKanal(k.channel)}</span>
                <span class="shrink-0 tabular-nums">
                  {rupiah(k.revenue)}
                  <span class="ml-2 text-xs text-[var(--color-teks-lembut)]">{bagian.toFixed(0)}%</span>
                </span>
              </div>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[var(--color-garis-lembut)]">
                <div class="h-full rounded-full bg-merah-600" style={`width:${bagian}%`} />
              </div>
              <p class="mt-1 text-xs text-[var(--color-teks-lembut)]">{k.transaction_count} order</p>
            </li>
          );
        })}
      </ul>
    </section>

    {/* Laba kanal = omzet − harga pokok − potongan platform − ongkir ditanggung toko; beban toko umum tak bisa dibagi per kanal, jadi dikurangkan di baris penutup agar totalnya sama dengan kartu Laba. */}
    <section class="kartu">
      <h2 class="mb-1 text-base font-bold">Laba per Kanal</h2>
      <p class="mb-5 text-xs text-[var(--color-teks-lembut)]">
        {labelPeriode(saringan)} · sebelum beban toko
      </p>

      <ul class="space-y-4">
        {channels.map((k) => {
          const lebar = (Math.abs(k.profit) / puncakLaba) * 100;
          const marjinKanal = k.revenue > 0 ? (k.profit / k.revenue) * 100 : 0;
          return (
            <li>
              <div class="flex items-baseline justify-between gap-4 text-sm">
                <span class="min-w-0 truncate font-medium">{labelKanal(k.channel)}</span>
                <span class={k.profit < 0 ? 'shrink-0 tabular-nums text-red-600' : 'shrink-0 tabular-nums'}>
                  {rupiah(k.profit)}
                  <span class="ml-2 text-xs text-[var(--color-teks-lembut)]">{marjinKanal.toFixed(1)}%</span>
                </span>
              </div>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[var(--color-garis-lembut)]">
                <div class={k.profit < 0 ? 'h-full rounded-full bg-red-400' : 'h-full rounded-full bg-merah-400'} style={`width:${lebar}%`} />
              </div>
              <p class="mt-1 text-xs text-[var(--color-teks-lembut)]">
                Omzet {rupiah(k.revenue)} − pokok {rupiah(k.cogs)}
                {k.platform_fees > 0 && ` − potongan ${rupiah(k.platform_fees)}`}
                {k.shipping_subsidy > 0 && ` − ongkir toko ${rupiah(k.shipping_subsidy)}`}
                {k.items_without_cost > 0 && ' · harga pokok belum lengkap'}
              </p>
            </li>
          );
        })}
      </ul>

      <dl class="mt-5 space-y-1 border-t border-[var(--color-garis)] pt-4 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-[var(--color-teks-lembut)]">Jumlah laba kanal</dt>
          <dd class="tabular-nums">{rupiah(labaKanal)}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-[var(--color-teks-lembut)]">Beban toko</dt>
          <dd class="tabular-nums">− {rupiah(bebanUmum)}</dd>
        </div>
        {summary.stock_loss > 0 && (
          <div class="flex justify-between gap-4">
            <dt class="text-[var(--color-teks-lembut)]">Stok terbuang</dt>
            <dd class="tabular-nums">− {rupiah(summary.stock_loss)}</dd>
          </div>
        )}
        <div class="flex justify-between gap-4 font-semibold">
          <dt>Laba</dt>
          <dd class={summary.profit < 0 ? 'tabular-nums text-red-600' : 'tabular-nums'}>{rupiah(summary.profit)}</dd>
        </div>
      </dl>
    </section>
  </div>

  <section class="kartu mb-6">
    <h2 class="mb-1 text-base font-bold">Omzet dan Laba Kotor</h2>
    <p class="mb-5 text-xs text-[var(--color-teks-lembut)]">
      {labelPeriode(saringan)} · {NAMA_BUTIR[butir].toLowerCase()}
    </p>

    {/* Grafik batang tanpa JavaScript: tinggi dihitung saat render sebagai persen; lebih dari 31 batang boleh digeser mendatar agar tiap batang tetap terlihat. */}
    <div class="overflow-x-auto">
      <div class="flex h-48 items-end gap-1" style={titik.length > 31 ? `min-width:${titik.length * 1.25}rem` : undefined}>
        {titik.map((t, i) => (
          <div
            class="flex h-full min-w-0 flex-1 flex-col justify-end gap-1.5"
            title={`${labelButir(t.start, butir, true)}: omzet ${rupiah(t.revenue)}, laba kotor ${rupiah(t.revenue - t.cogs)}, ${t.transaction_count} order`}
          >
            <div class="flex h-full items-end justify-center gap-px">
              <div class="w-2/5 max-w-4 rounded-t bg-merah-600" style={`height:${tinggi(t.revenue)}`} />
              <div class="w-2/5 max-w-4 rounded-t bg-merah-300" style={`height:${tinggi(t.revenue - t.cogs)}`} />
            </div>
            {/* Label boleh meluber dari kolom batangnya yang sempit (jaraknya dijarangkan `langkahLabel`), dan di ponsel separuhnya disembunyikan agar tak bertumpuk. */}
            <span
              class:list={[
                'flex h-4 whitespace-nowrap text-[0.6875rem] text-[var(--color-teks-lembut)]',
                i === 0 ? 'justify-start' : i === titik.length - 1 ? 'justify-end' : 'justify-center',
                (i / langkahLabel) % 2 === 1 && 'max-sm:invisible',
              ]}
            >
              {i % langkahLabel === 0 ? labelSumbu(t.start, i) : ''}
            </span>
          </div>
        ))}
      </div>
    </div>

    <p class="mt-4 flex flex-wrap gap-4 text-xs text-[var(--color-teks-lembut)]">
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-2.5 w-2.5 rounded-sm bg-merah-600" />Omzet
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-2.5 w-2.5 rounded-sm bg-merah-300" />Laba kotor (omzet − harga pokok)
      </span>
    </p>

    {
      butir === 'hour' ? (
        <p class="mt-4 text-xs text-[var(--color-teks-lembut)]">
          Rincian laba per jam tidak ditampilkan karena beban dicatat per tanggal; laba hari ini ada di kartu Laba.
        </p>
      ) : (
        <details class="mt-5 border-t border-[var(--color-garis)] pt-4">
          <summary class="cursor-pointer text-sm font-semibold">
            Rincian {NAMA_BUTIR[butir].toLowerCase()} ({barisRincian.length} {butir === 'day' ? 'hari' : 'bulan'} berisi)
          </summary>
          <div class="mt-3 overflow-x-auto">
            <table class="tabel min-w-[40rem]">
              <thead>
                <tr>
                  <th>{butir === 'day' ? 'Tanggal' : 'Bulan'}</th>
                  <th class="text-right">Order</th>
                  <th class="text-right">Omzet</th>
                  <th class="text-right">Harga Pokok</th>
                  <th class="text-right">Potongan</th>
                  <th class="text-right">Beban</th>
                  {adaRugi && <th class="text-right">Stok Terbuang</th>}
                  <th class="text-right">Laba</th>
                </tr>
              </thead>
              <tbody>
                {barisRincian.map((t) => (
                  <tr>
                    <td class="whitespace-nowrap">{labelButir(t.start, butir, true)}</td>
                    <td class="sel-angka">{t.transaction_count}</td>
                    <td class="sel-angka">{rupiah(t.revenue)}</td>
                    <td class="sel-angka text-[var(--color-teks-lembut)]">{rupiah(t.cogs)}</td>
                    <td class="sel-angka text-[var(--color-teks-lembut)]">{rupiah(t.platform_fees)}</td>
                    <td class="sel-angka text-[var(--color-teks-lembut)]">{rupiah(t.expenses)}</td>
                    {adaRugi && <td class="sel-angka text-[var(--color-teks-lembut)]">{rupiah(t.stock_loss)}</td>}
                    <td class:list={['sel-angka font-semibold', t.profit < 0 && 'text-red-600']}>{rupiah(t.profit)}</td>
                  </tr>
                ))}
                {barisRincian.length === 0 && (
                  <tr>
                    <td colspan={adaRugi ? 8 : 7} class="py-8 text-center text-[var(--color-teks-lembut)]">
                      Belum ada penjualan atau beban pada periode ini.
                    </td>
                  </tr>
                )}
              </tbody>
              {barisRincian.length > 0 && (
                <tfoot>
                  <tr class="border-t-2 border-[var(--color-garis)] font-semibold">
                    <td>Jumlah</td>
                    <td class="sel-angka">{jumlahRincian.transaction_count}</td>
                    <td class="sel-angka">{rupiah(jumlahRincian.revenue)}</td>
                    <td class="sel-angka">{rupiah(jumlahRincian.cogs)}</td>
                    <td class="sel-angka">{rupiah(jumlahRincian.platform_fees)}</td>
                    <td class="sel-angka">{rupiah(jumlahRincian.expenses)}</td>
                    {adaRugi && <td class="sel-angka">{rupiah(jumlahRincian.stock_loss)}</td>}
                    <td class:list={['sel-angka', jumlahRincian.profit < 0 && 'text-red-600']}>{rupiah(jumlahRincian.profit)}</td>
                  </tr>
                </tfoot>
              )}
            </table>
          </div>
        </details>
      )
    }
  </section>

  <div class="mb-6">
    <section class="kartu">
      <div class="mb-5 flex items-start justify-between gap-3">
        <div>
          <h2 class="mb-1 text-base font-bold">Rincian Beban</h2>
          <p class="text-xs text-[var(--color-teks-lembut)]">
            {labelPeriode(saringan)} · total {rupiah(totalBeban)}
          </p>
        </div>
        <a class="aksi-baris shrink-0" href={tautanBeban}>Catat beban →</a>
      </div>

      {
        expense_breakdown.length === 0 ? (
          <p class="py-12 text-center text-sm text-[var(--color-teks-lembut)]">
            Belum ada beban tercatat pada periode ini.
            <a class="block font-medium text-merah-700 hover:underline" href={tautanBeban}>Catat gaji, sewa, listrik, dan lainnya →</a>
          </p>
        ) : (
          <ul class="grid gap-x-10 gap-y-3 lg:grid-cols-2">
            {expense_breakdown.map((b) => {
              const bagian = totalBeban > 0 ? (b.amount / totalBeban) * 100 : 0;
              return (
                <li>
                  <div class="flex items-baseline justify-between gap-4 text-sm">
                    <span class="min-w-0 truncate">{b.category}</span>
                    <span class="shrink-0 tabular-nums">
                      {rupiah(b.amount)}
                      <span class="ml-2 text-xs text-[var(--color-teks-lembut)]">
                        {bagian.toFixed(0)}%
                      </span>
                    </span>
                  </div>
                  <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[var(--color-garis-lembut)]">
                    <div class="h-full rounded-full bg-merah-400" style={`width:${bagian}%`} />
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  </div>

  <section class="kartu-rapat mb-6 overflow-x-auto" id="produk-terlaris" data-daftar>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-garis)] px-5 py-4">
      <div>
        <h2 class="text-base font-bold">Produk Terlaris</h2>
        <a class="text-xs font-medium text-merah-700 hover:underline" href={tautanProduk}>Laba per produk →</a>
      </div>

      {/* Periode kartu ini terpisah dari saringan utama (metode bayar dan jenis pembeli ikut lewat input tersembunyi), dan `action="#produk-terlaris"` mengembalikan scroll ke kartu ini. */}
      <form method="GET" class="flex items-center gap-2" action="#produk-terlaris">
        {saringan.metode && <input type="hidden" name="metode" value={saringan.metode} />}
        {saringan.jenis && <input type="hidden" name="jenis" value={saringan.jenis} />}
        {saringan.periode === PERIODE_TANGGAL ? (
          <>
            {saringan.dari && <input type="hidden" name="dari" value={saringan.dari} />}
            {saringan.sampai && <input type="hidden" name="sampai" value={saringan.sampai} />}
          </>
        ) : (
          saringan.periode !== 'month' && <input type="hidden" name="periode" value={saringan.periode} />
        )}
        <select class="kolom !py-2 !text-xs" name="top_periode" aria-label="Periode Produk Terlaris">
          <option value="" selected={!saringan.top_periode}>
            Ikut saringan di atas
          </option>
          {PERIODE.map((p) => (
            <option value={p.nilai} selected={saringan.top_periode === p.nilai}>
              {p.label}
            </option>
          ))}
        </select>
        <button class="tombol-halus !px-3 !py-2 !text-xs" type="submit">Terapkan</button>
      </form>
    </div>
    <table class="tabel tabel-kartu">
      <thead>
        <tr>
          <th>Produk</th>
          <th>SKU</th>
          <th class="text-right">Terjual</th>
          <th class="text-right">Omzet</th>
        </tr>
      </thead>
      <tbody>
        {
          top_products.map((p) => (
            <tr>
              <td data-judul>
                {p.product_id ? (
                  <a class="font-medium hover:underline" href={`/produk/${p.product_id}`}>
                    {p.name}
                  </a>
                ) : (
                  <span class="font-medium">{p.name}</span>
                )}
              </td>
              <td data-label="SKU" class="whitespace-nowrap text-xs text-[var(--color-teks-lembut)]">
                {p.sku ?? '—'}
              </td>
              <td data-label="Terjual" class="sel-angka">{p.qty}</td>
              <td data-label="Omzet" class="sel-angka">{rupiah(p.revenue)}</td>
            </tr>
          ))
        }
        {
          top_products.length === 0 && (
            <tr>
              <td colspan="4" class="py-12 text-center text-[var(--color-teks-lembut)]">
                Belum ada penjualan pada periode ini.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
    {
      terlarisTerakhir > 1 && (
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-garis)] px-5 py-3">
          <p class="text-xs text-[var(--color-teks-lembut)]">
            {top_products_total} produk · halaman {halamanTerlaris} dari {terlarisTerakhir}
          </p>
          <Paginasi
            ringkas
            halaman={halamanTerlaris}
            halamanTerakhir={terlarisTerakhir}
            tautan={(ke) => tautanHalaman('hal_terlaris', ke, 'produk-terlaris')}
          />
        </div>
      )
    }
  </section>

  <section class="kartu-rapat overflow-x-auto" id="penjualan" data-daftar>
    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[var(--color-garis)] px-5 py-4">
      <h2 class="text-base font-bold">Penjualan</h2>
      <p class="text-xs text-[var(--color-teks-lembut)]">
        {summary.transaction_count} transaksi · Ekspor CSV berisi seluruhnya
      </p>
    </div>

    <table class="tabel tabel-kartu">
      <thead>
        <tr>
          <th>No. Pesanan</th>
          <th>Waktu</th>
          <th>Pembeli</th>
          <th>Metode</th>
          <th class="text-right">Item</th>
          <th class="text-right">Omzet</th>
          <th class="text-right">Ongkir</th>
          <th class="text-right">Dibayar</th>
        </tr>
      </thead>
      <tbody>
        {
          sales.map((s) => (
            <tr>
              <td data-judul class="whitespace-nowrap">
                <a class="font-medium text-merah-700 hover:underline" href={`/laporan/transaksi/${s.id}`}>
                  #{nomorPesanan(s.id)}
                </a>
              </td>
              <td data-label="Waktu" class="whitespace-nowrap text-xs text-[var(--color-teks-lembut)]">
                {waktu(s.created_at)}
              </td>
              <td data-label="Pembeli">
                {s.customer_name ?? (
                  <span class="text-[var(--color-teks-lembut)]">
                    {labelJenis(s.type)}
                  </span>
                )}
              </td>
              <td data-label="Metode" class="text-[var(--color-teks-lembut)]">{labelMetode(s.payment_method)}</td>
              <td data-label="Item" class="sel-angka">{s.item_count}</td>
              <td data-label="Omzet" class="sel-angka">{rupiah(s.revenue)}</td>
              <td data-label="Ongkir" class="sel-angka text-[var(--color-teks-lembut)] max-md:hidden">{rupiah(s.shipping)}</td>
              <td data-label="Dibayar" class="sel-angka font-semibold">{rupiah(s.total_amount)}</td>
            </tr>
          ))
        }
        {
          sales.length === 0 && (
            <tr>
              <td colspan="8" class="py-12 text-center text-[var(--color-teks-lembut)]">
                Tidak ada penjualan yang cocok dengan saringan ini.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
    {
      jualTerakhir > 1 && (
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-garis)] px-5 py-3">
          <p class="text-xs text-[var(--color-teks-lembut)]">
            Halaman {halamanJual} dari {jualTerakhir}
          </p>
          <Paginasi
            ringkas
            halaman={halamanJual}
            halamanTerakhir={jualTerakhir}
            tautan={(ke) => tautanHalaman('hal_jual', ke, 'penjualan')}
          />
        </div>
      )
    }
  </section>

  <script is:inline>
    (function () {
      var periode = document.getElementById('periode');
      var dari = document.getElementById('dari');
      var sampai = document.getElementById('sampai');
      if (!periode || !dari || !sampai) return;
      periode.addEventListener('change', function () {
        if (periode.value !== 'custom') { dari.value = ''; sampai.value = ''; }
      });
      [dari, sampai].forEach(function (el) {
        el.addEventListener('change', function () {
          if (dari.value || sampai.value) periode.value = 'custom';
          dari.max = sampai.value || '';
          sampai.min = dari.value || '';
        });
      });
    })();
  </script>
</AppShell>
