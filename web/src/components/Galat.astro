---
interface Props {
  pesan?: string | null;
  rincian?: string[];
  class?: string;
}

const { pesan, rincian = [], class: kelas } = Astro.props;
---

{
  pesan && (
    <div class:list={['galat', kelas]} role="alert">
      <p>{pesan}</p>
      {rincian.length > 0 && (
        <ul class="mt-2 max-h-60 list-disc space-y-1 overflow-y-auto pl-5">
          {rincian.map((r) => <li>{r}</li>)}
        </ul>
      )}
    </div>
  )
}
