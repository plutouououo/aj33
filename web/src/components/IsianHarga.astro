---
/** Isian harga jual per kanal (walk in, Shopee, Tokopedia): ecer, grosir, dan batas grosirnya; dipakai form tambah produk, sunting produk, dan tambah varian, `awalan` membedakan id bila dua form ada di satu halaman. */
import type { PricingSettings, Product } from '../lib/api';
import { kg } from '../lib/format';

type KolomHarga = keyof Pick<
  Product,
  'price' | 'price_wholesale' | 'price_shopee' | 'price_shopee_wholesale' | 'price_tiktok' |
    'price_tiktok_wholesale' | 'wholesale_threshold_kg' | 'wholesale_threshold_kg_shopee' |
    'wholesale_threshold_kg_tiktok'
>;

interface Props {
  nilai: Partial<Record<KolomHarga, number | string | null>>;
  pengaturan: PricingSettings;
  awalan?: string;
}

const { nilai, pengaturan, awalan = '' } = Astro.props;

/** Placeholder menyebut harga yang dipakai kasir bila isian dibiarkan kosong, sama dengan `SalesChannel::harga` di backend. */
const KANAL = [
  {
    label: 'Walk in',
    ecer: 'price',
    grosir: 'price_wholesale',
    batas: 'wholesale_threshold_kg',
    ikutEcer: null,
    ikutGrosir: 'ikut ecer',
  },
  {
    label: 'Shopee',
    ecer: 'price_shopee',
    grosir: 'price_shopee_wholesale',
    batas: 'wholesale_threshold_kg_shopee',
    ikutEcer: 'ikut walk in',
    ikutGrosir: 'ikut ecer Shopee',
  },
  {
    label: 'Tokopedia / TikTok',
    ecer: 'price_tiktok',
    grosir: 'price_tiktok_wholesale',
    batas: 'wholesale_threshold_kg_tiktok',
    ikutEcer: 'ikut walk in',
    ikutGrosir: 'ikut ecer Tokopedia',
  },
] as const;

const isi = (kolom: KolomHarga): string => String(nilai[kolom] ?? '');
---

<div class="flex flex-col gap-2">
  <div class="grid gap-3 sm:grid-cols-3">
    {KANAL.map((k) => (
      <fieldset class="min-w-0 rounded-lg border border-[var(--color-garis)] p-3">
        <legend class="px-1 text-sm font-semibold">{k.label}</legend>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-1">
          <div>
            <label class="label" for={`${awalan}${k.ecer}`}>Ecer (Rp)</label>
            <input
              class="kolom"
              id={`${awalan}${k.ecer}`}
              name={k.ecer}
              type="number"
              min="0"
              step="1"
              value={isi(k.ecer)}
              placeholder={k.ikutEcer ?? undefined}
              required={k.ikutEcer === null}
            />
          </div>
          <div>
            <label class="label" for={`${awalan}${k.grosir}`}>Grosir (Rp)</label>
            <input
              class="kolom"
              id={`${awalan}${k.grosir}`}
              name={k.grosir}
              type="number"
              min="0"
              step="1"
              value={isi(k.grosir)}
              placeholder={k.ikutGrosir}
            />
          </div>
          <div>
            <label class="label" for={`${awalan}${k.batas}`}>Batas grosir (kg)</label>
            <input
              class="kolom"
              id={`${awalan}${k.batas}`}
              name={k.batas}
              type="number"
              min="0.001"
              step="any"
              inputmode="decimal"
              value={isi(k.batas)}
              placeholder={`bawaan ${kg(pengaturan.wholesale_threshold_kg)}`}
            />
          </div>
        </div>
      </fieldset>
    ))}
  </div>
  <p class="isian-bantu">
    Grosir dipakai di kanal itu bila berat satu baris (jumlah × ukuran) lebih dari batas grosirnya.
    Batas yang dikosongkan memakai batas bawaan di Pengaturan › Harga.
  </p>
</div>
